    record("NobleFactor/alpha#3").epic == "NobleFactor/alpha#1" and record("NobleFactor/alpha#3").feature == "NobleFactor/alpha#2"
    and record("NobleFactor/beta#1").epic == "NobleFactor/alpha#1" and record("test-user/personal#2").epic == "test-user/personal#1"
