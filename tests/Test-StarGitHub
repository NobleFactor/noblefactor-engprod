# Test-StarGitHub - Tests the com.noblefactor.ops.GitHub star extension against a stand-in gh: the model's load and pull
# (#376, and the part of #426 they need), the report's records and selection (#379), and the triage sweep (#436), as
# docs/plans/feature/436-triage-sweep.md's test plan lists them; and the organization's model read from its .github
# repository by ETag, with a copy kept (#431), as docs/plans/feature/431-dot-github.md's test plan lists them

[[ -r "$(dirname "$0")/../Home/common/.local/bin/Declare-BashScript" ]] || {
    printf '%s: cannot find Declare-BashScript in %s\n' "${0##*/}" "$(dirname "$0")/../Home/common/.local/bin" >&2
    exit 72 # EX_OSFILE
}

# The helper sources Set-Environment from ${XDG_DATA_HOME:-$HOME/.local/share}/shell/functions. This checkout's is the
# file under review, so the test points XDG_DATA_HOME at it while the helper loads; each star the test runs gets an
# XDG_DATA_HOME of its own, holding a copy of this checkout's extension.
XDG_DATA_HOME="$(cd "$(dirname "$0")/../Home/common/.local/share" && pwd)" || exit 72 # EX_OSFILE
export XDG_DATA_HOME

# shellcheck source=Declare-BashScript
source "$(dirname "$0")/../Home/common/.local/bin/Declare-BashScript" "$0" "help" "h" "$@"
require_command jq mktemp star

declare -r extension_name=com.noblefactor.ops.GitHub
extension_source="${XDG_DATA_HOME}/devlore/star/extensions/${extension_name}"
declare -r extension_source

###########
# Functions
###########

# cleanup removes the run's directory, which holds every case's extension, fixtures and calls, however the run ends;
# with TEST_STAR_GITHUB_KEEP set, it keeps the directory and names it, for a failing case's calls to be read.
#
# Returns:
#   - 0, the run's directory gone, or kept and named.
function cleanup {
    if [[ -n "${run_directory:-}" && -d "${run_directory}" ]]; then
        if [[ -n "${TEST_STAR_GITHUB_KEEP:-}" ]]; then
            printf 'kept: %s\n' "${run_directory}" >&2
            return 0
        fi
        rm -rf -- "${run_directory}"
    fi
}

# sign_model rewrites a model file's digest line to the SHA-256 of the file with that line excluded, the rule the
# extension checks on load.
#
# Parameters:
#   - `$1`: the model file.
#
# Returns:
#   - 0, the file signed.
function sign_model {
    local digest

    digest="$(sed '/^  digest: /d' "$1" | { sha256sum 2>/dev/null || shasum -a 256; } | cut -d' ' -f1)"
    sed -i.unsigned "s|^  digest: .*|  digest: sha256:${digest}|" "$1"
    rm -f -- "$1.unsigned"
}

# make_extension lays out an extension directory as writ deploys one: this checkout's manifest, commands and reference
# models, linked, and the user account's fixture model beside them, copied and signed, so that a case may change a
# model. The organization's model is not beside them: it is NobleFactor/.github's model.yaml (#431), which the stand-in
# serves from `$1`/remote/NobleFactor/.github/model.yaml, a GitHub of the data directory's own.
#
# Parameters:
#   - `$1`: the data directory to make, which star is given as XDG_DATA_HOME.
#   - `$2`: the organization's model, a file; optional, the fixture's by default; `none` for NobleFactor/.github to
#     hold none.
#   - `$3`: the user account's model, a file; optional, the fixture's by default; `none` for the account to have none.
#
# Returns:
#   - 0, with `$1`/devlore/star/extensions/com.noblefactor.ops.GitHub laid out.
function make_extension {
    local directory="$1/devlore/star/extensions/${extension_name}" remote="$1/remote/NobleFactor/.github"

    mkdir -p -- "${directory}" "${remote}"
    ln -s -- "${extension_source}/extension.yaml" "${directory}/extension.yaml"
    ln -s -- "${extension_source}/commands" "${directory}/commands"
    ln -s -- "${extension_source}/reference" "${directory}/reference"
    if [[ "${2:-}" != none ]]; then
        cp -- "${2:-${run_directory}/models/model.yaml}" "${remote}/model.yaml"
        sign_model "${remote}/model.yaml"
    fi
    if [[ "${3:-}" != none ]]; then
        cp -- "${3:-${run_directory}/models/model.test-user.yaml}" "${directory}/model.test-user.yaml"
        sign_model "${directory}/model.test-user.yaml"
    fi
}

# add_layer registers a writ layer in a data directory as writ does: an entry under devlore/writ/layers naming a git
# working tree, whose origin is the repository given. The extension reads each layer repository's owner as an account
# whose model is kept on GitHub (#441).
#
# Parameters:
#   - `$1`: the data directory make_extension made.
#   - `$2`: the layer's name: base, team or personal.
#   - `$3`: the layer's repository, owner/name.
#
# Returns:
#   - 0, the layer registered.
function add_layer {
    local layer="$1/devlore/writ/layers/$2"

    mkdir -p -- "${layer}"
    git -C "${layer}" init --quiet
    git -C "${layer}" remote add origin "git@github.com:$3.git"
}

# run_star runs one star command against a case's extension and the stand-in gh, outside any git tree, so that no
# project-local extension or configuration reaches it.
#
# Sets `output`, `errors` and `status`, and empties the calls the stand-in recorded before it runs. star runs with
# --silent unless `quiet` is set empty: an extension that fails to load says why only in star's narration. Its cache is
# `cache_home`, which a case may point elsewhere to start from none.
#
# Parameters:
#   - `$1`: the data directory make_extension made.
#   - `${@:2}`: star's arguments.
#
# Returns:
#   - 0.
function run_star {
    local data="$1"
    shift 1

    : >"${run_directory}/calls.jsonl"
    : >"${run_directory}/state"
    status=0
    output="$(
        cd "${run_directory}/work" &&
            PATH="${run_directory}/bin:${PATH}" XDG_DATA_HOME="${data}" XDG_CACHE_HOME="${cache_home}" \
                XDG_CONFIG_HOME="${run_directory}/config" XDG_STATE_HOME="${run_directory}/state-home" \
                GH_FIXTURES="${run_directory}/fixtures" GH_CALLS="${run_directory}/calls.jsonl" \
                GH_STATE="${run_directory}/state" star "$@" ${quiet} 2>"${run_directory}/errors"
    )" || status=$?
    errors="$(<"${run_directory}/errors")"
}

# expect checks the last run_star: its status, and a jq program over its output that must print true.
#
# Parameters:
#   - `$1`: the case's name.
#   - `$2`: `ok` for a zero status, `error` for any other, `any` for either.
#   - `$3`: a jq program run over the output, which must print true; empty to check nothing. It sees the calls the
#     stand-in recorded as `$calls`, an array of argument arrays.
#   - `$4`: an extended regular expression a line of the errors must match; optional, empty to check nothing.
#   - `$5`: `json`, the default, when the output is JSON; `text` to give the program the output as one string.
#
# Returns:
#   - 0, the case counted as passed or failed.
function expect {
    local name="$1" want="$2" program="$3" pattern="${4:-}" input="${5:-json}" problem="" verdict
    local -a read_as=()

    case_count=$((case_count + 1))
    if [[ "${want}" == ok && ${status} -ne 0 ]]; then
        problem+="its status was ${status}, not 0; "
    elif [[ "${want}" == error && ${status} -eq 0 ]]; then
        problem+="its status was 0, not an error; "
    fi
    [[ "${input}" == json ]] || read_as=(--raw-input --slurp)
    if [[ -n "${program}" ]]; then
        verdict="$(jq "${read_as[@]}" --raw-output --slurpfile calls "${run_directory}/calls.jsonl" "${program}" \
            <<<"${output}" 2>&1)" || true
        [[ "${verdict}" == true ]] || problem+="the output does not satisfy ${program} (${verdict}); "
    fi
    if [[ -n "${pattern}" ]] && ! grep --quiet --extended-regexp --regexp="${pattern}" <<<"${errors}"; then
        problem+="no line of the errors matches '${pattern}'; "
    fi

    if [[ -z "${problem}" ]]; then
        success "${name}"
        return 0
    fi
    error 0 "${name}: ${problem%; }:"
    printf '    output: %s\n' "${output:0:2000}" >&2
    printf '    errors: %s\n' "${errors:0:2000}" >&2
    failures=$((failures + 1))
}

# check counts a case decided by a command rather than by star's output: a file the run left, or what the stand-in
# answered, as ${run_directory}/state records it.
#
# Parameters:
#   - `$1`: the case's name.
#   - `${@:2}`: the command, which must succeed.
#
# Returns:
#   - 0, the case counted as passed or failed.
function check {
    local name="$1"
    shift 1

    case_count=$((case_count + 1))
    if "$@"; then
        success "${name}"
        return 0
    fi
    error 0 "${name}: this did not hold: $*"
    printf '    errors: %s\n' "${errors:0:2000}" >&2
    failures=$((failures + 1))
}

# write_stand_in writes the stand-in for gh to the run's bin directory.
#
# It records each call as a JSON array of its arguments, one per line of ${GH_CALLS}, and answers from ${GH_FIXTURES}:
# a GraphQL request by the operation name the extension gives it, a REST request by its path. Every fixture file is a
# JSON array of responses, one per page; --paginate answers every page and a request without it the first, and --jq
# is applied to each, as gh does. An addition to a project is remembered in ${GH_STATE}, so that reading the row back
# finds it.
#
# An account's model, repos/<account>/.github/contents/model.yaml, is answered as GitHub answered it on 2026-11-09:
# from ${XDG_DATA_HOME}/remote/<account>/.github/model.yaml, raw when asked for the raw media type, with an ETag of its
# content; 304 Not Modified, exiting 1, when If-None-Match names that ETag; 404 when there is no file. With
# ${XDG_DATA_HOME}/unreachable present, it is the read gh makes with no connection: a message, exit 1, and no answer.
# Each answer's status is recorded in ${GH_STATE} as `contents <account> <status>`.
#
# Returns:
#   - 0, the stand-in written and executable.
function write_stand_in {
    mkdir -p -- "${run_directory}/bin"
    cat >"${run_directory}/bin/gh" <<'GH'
#!/usr/bin/env bash
set -uo pipefail

# Each argument NUL-terminated, so that jq reads them as data: given them as --args, it parses gh's own options.
printf '%s\0' "$@" | jq -c -R -s 'split("\u0000") | .[:-1]' >>"${GH_CALLS}"

# answer prints a fixture's responses, every page with --paginate, through --jq when it was given.
function answer {
    local file="$1" filter="${2:-.}" count index
    [[ -r "${file}" ]] || { printf 'stand-in gh: no fixture %s\n' "${file}" >&2; exit 1; }
    count="$(jq 'length' "${file}")"
    ((paginate)) || count=1
    for ((index = 0; index < count; index++)); do
        jq -c ".[${index}] | ${filter}" "${file}" | if [[ -n "${jq_program}" ]]; then jq -r -c "${jq_program}"; else cat; fi
    done
}

case "${1:-} ${2:-}" in
    "auth status")
        printf '%s\n' "github.com" "  ✓ Logged in to github.com account tester (keyring)" "  - Active account: true" \
            "  - Git operations protocol: https" "  - Token scopes: 'project', 'read:org', 'repo'"
        exit 0
        ;;
    "api rate_limit")
        echo "4999 0"
        exit 0
        ;;
    "repo view")
        echo "NobleFactor/alpha"
        exit 0
        ;;
esac

declare -A vars=()
declare -a headers=()
paginate=0 jq_program="" rest_path="" include=0
shift 1
while (($#)); do
    case $1 in
        graphql) rest_path=graphql ;;
        -f | -F)
            vars["${2%%=*}"]="${2#*=}"
            shift 1
            ;;
        --paginate) paginate=1 ;;
        --jq)
            jq_program="$2"
            shift 1
            ;;
        -i) include=1 ;;
        -H)
            headers+=("$2")
            shift 1
            ;;
        *) rest_path="$1" ;;
    esac
    shift 1
done

if [[ "${rest_path}" != graphql ]]; then
    ((include)) || { printf 'stand-in gh: a REST call without -i: %s\n' "${rest_path}" >&2; exit 1; }
    if [[ "${rest_path}" =~ ^repos/([^/]+)/\.github/contents/model\.yaml$ ]]; then
        account="${BASH_REMATCH[1]}" accept="" if_none_match=""
        remote="${XDG_DATA_HOME}/remote/${account}/.github/model.yaml"
        for header in "${headers[@]}"; do
            case ${header} in
                [Aa]ccept:*) accept="${header#*: }" ;;
                [Ii]f-[Nn]one-[Mm]atch:*) if_none_match="${header#*: }" ;;
            esac
        done
        if [[ -e "${XDG_DATA_HOME}/unreachable" ]]; then
            printf 'contents %s unreachable\n' "${account}" >>"${GH_STATE}"
            printf 'error connecting to api.github.com\ncheck your internet connection or https://githubstatus.com\n' >&2
            exit 1
        fi
        if [[ ! -r "${remote}" ]]; then
            printf 'contents %s 404\n' "${account}" >>"${GH_STATE}"
            printf 'HTTP/2.0 404 Not Found\n\n{"message":"Not Found","status":"404"}\n'
            exit 1
        fi
        etag="\"$({ sha256sum 2>/dev/null || shasum -a 256; } <"${remote}" | cut -c1-40)\""
        if [[ "${if_none_match}" == "${etag}" ]]; then
            printf 'contents %s 304\n' "${account}" >>"${GH_STATE}"
            printf 'HTTP/2.0 304 Not Modified\nEtag: %s\n\n' "${etag}"
            exit 1
        fi
        [[ "${accept}" == application/vnd.github.raw* ]] || {
            printf 'stand-in gh: %s read without the raw media type\n' "${rest_path}" >&2
            exit 1
        }
        printf 'contents %s 200\n' "${account}" >>"${GH_STATE}"
        printf 'HTTP/2.0 200 OK\nContent-Type: application/vnd.github.raw+json; charset=utf-8\nEtag: %s\n\n' "${etag}"
        cat -- "${remote}"
        exit 0
    fi
    file="${GH_FIXTURES}/rest/${rest_path//[?=&]/_}.json"
    if [[ "${rest_path}" =~ ^orgs/[^/]+$ ]]; then
        printf 'HTTP/2.0 200 OK\n\n{}\n'
        exit 0
    fi
    [[ -r "${file}" ]] || { printf 'HTTP/2.0 404 Not Found\n\n{}\n'; exit 1; }
    printf 'HTTP/2.0 200 OK\nEtag: "e-%s"\n\n' "${rest_path//[^a-z]/}"
    jq -c '.[0]' "${file}"
    exit 0
fi

query="${vars[query]:-}"
[[ "${query}" =~ (query|mutation)[[:space:]]+(star[A-Za-z]+) ]] || { printf 'stand-in gh: no operation name in %s\n' "${query}" >&2; exit 1; }
operation="${BASH_REMATCH[2]}"
login="" owner="" name=""
[[ "${query}" =~ login:[[:space:]]*\"([^\"]+)\" ]] && login="${BASH_REMATCH[1]}"
[[ "${query}" =~ repository\(owner:[[:space:]]*\"([^\"]+)\",[[:space:]]*name:[[:space:]]*\"([^\"]+)\" ]] && owner="${BASH_REMATCH[1]}" name="${BASH_REMATCH[2]}"

case ${operation} in
    starIssues)
        filter=.
        [[ "${query}" == *"states: [OPEN]"* ]] && filter='.data.repository.issues.nodes |= map(select(.state == "OPEN"))'
        answer "${GH_FIXTURES}/issues/${owner}/${name}.json" "${filter}"
        ;;
    starSearchCount | starSearch)
        [[ "${vars[q]:-}" =~ repo:([^/[:space:]]+)/([^[:space:]\)]+) ]] || { printf 'stand-in gh: no repo: in %s\n' "${vars[q]:-}" >&2; exit 1; }
        answer "${GH_FIXTURES}/search/${BASH_REMATCH[1]}/${BASH_REMATCH[2]}.json"
        ;;
    starOwner | starOrganizationModel | starUserModel | starProjects)
        answer "${GH_FIXTURES}/${operation}/${login}.json"
        ;;
    starTriage)
        [[ "${query}" =~ query:[[:space:]]*\"Triage:[[:space:]]*([^\"]+)\" ]] || { printf 'stand-in gh: no Triage title in %s\n' "${query}" >&2; exit 1; }
        answer "${GH_FIXTURES}/starTriage/${login}/${BASH_REMATCH[1]}.json"
        ;;
    starTriageItems)
        [[ "${query}" =~ node\(id:[[:space:]]*\"([^\"]+)\" ]] || exit 1
        answer "${GH_FIXTURES}/starTriageItems/${BASH_REMATCH[1]}.json"
        ;;
    starAddToTriage)
        [[ "${query}" =~ projectId:[[:space:]]*\"([^\"]+)\",[[:space:]]*contentId:[[:space:]]*\"([^\"]+)\" ]] || exit 1
        printf 'PVTI_new_%s %s\n' "${BASH_REMATCH[2]}" "${BASH_REMATCH[1]}" >>"${GH_STATE}"
        jq -cn --arg id "PVTI_new_${BASH_REMATCH[2]}" '{data: {addProjectV2ItemById: {item: {id: $id}}}}' |
            if [[ -n "${jq_program}" ]]; then jq -r -c "${jq_program}"; else cat; fi
        ;;
    starSetStatus)
        jq -cn '{data: {updateProjectV2ItemFieldValue: {projectV2Item: {id: "set"}}}}'
        ;;
    starComment)
        jq -cn --arg s "${vars[s]:-}" '{data: {addComment: {commentEdge: {node: {id: ("IC_" + $s)}}}}}' |
            if [[ -n "${jq_program}" ]]; then jq -r -c "${jq_program}"; else cat; fi
        ;;
    starItem)
        [[ "${query}" =~ node\(id:[[:space:]]*\"([^\"]+)\" ]] || exit 1
        project="$(awk -v id="${BASH_REMATCH[1]}" '$1 == id { print $2 }' "${GH_STATE}")"
        jq -cn --arg p "${project}" '{data: {node: {project: {id: $p}, status: {name: "Open"}}}}' |
            if [[ -n "${jq_program}" ]]; then jq -r -c "${jq_program}"; else cat; fi
        ;;
    *)
        printf 'stand-in gh: no answer for %s\n' "${operation}" >&2
        exit 1
        ;;
esac
GH
    chmod +x "${run_directory}/bin/gh"
}

# write_models writes the two fixture models: NobleFactor's, an organization's, and test-user's, a user account's, each
# unsigned, which make_extension signs as it copies them; and a minimal one for each, holding the hierarchy's types
# alone, so that a pull's diff shows every record it adds.
#
