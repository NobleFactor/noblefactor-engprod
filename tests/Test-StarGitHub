# The jq that says whether calls came in an order: each [operation, argument] pair names the first call whose query
# names the operation and that was given the argument, and each such call comes after the one before it.
declare -r in_order='def call_at($op; $arg): [to_entries[] | select(any(.value[]; type == "string" and startswith("query=")
        and contains($op)) and any(.value[]; . == $arg)) | .key][0];
    def in_order($pairs): . as $calls | [$pairs[] | . as $p | $calls | call_at($p[0]; $p[1])]
        | all(.[]; . != null) and . == sort and (unique | length) == length;'

