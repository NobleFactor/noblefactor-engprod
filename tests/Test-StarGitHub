    and faulted("test-user/personal#2"; "two-labels")'
expect "4: a clean issue passes every rule" ok "${entry}"'
    absent("NobleFactor/alpha#1") and absent("NobleFactor/alpha#4") and absent("NobleFactor/alpha#11")
