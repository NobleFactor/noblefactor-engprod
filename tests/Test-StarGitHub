                notificationSetting: "NOTIFICATIONS_ENABLED", parentTeam: null,
                repositories: {edges: [{permission: "MAINTAIN", node: {nameWithOwner: "NobleFactor/alpha"}},
                    {permission: "READ", node: {nameWithOwner: "NobleFactor/beta"}}]}},
            {name: "DevLore", slug: "devlore", id: "T_devlore", description: "", privacy: "VISIBLE",
