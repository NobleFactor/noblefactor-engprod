# 32. restore applies the account's backup: main's, or the revision named.
remote NobleFactor
first="$(commit_model NobleFactor "$(jq '.types += [{name: "Chore", level: 2, description: "Level 2: housekeeping",
    color: "gray", enabled: true}]' <<<"${model_nf}")")"
commit_model NobleFactor "$(jq '.types += [{name: "Spike", level: 2, description: "Level 2: an experiment", color: "gray",
    enabled: true}]' <<<"${model_nf}")" >/dev/null
run_star "${data}" github model restore NobleFactor
expect "32: restore applies main's backup" ok '[.[] | select(.kind == "issue-type" and .action == "created") | .path] == ["Spike"]'
run_star "${data}" github model restore NobleFactor "${first}"
expect "32: restore <revision> applies that revision's backup" ok '[.[] | select(.kind == "issue-type" and .action == "created") | .path] == ["Chore"]'

# 33. A token from a file must be readable by its owner alone; --token replaces a secret already set.
printf 'token-from-file' >"${run_directory}/work/token"
chmod 644 "${run_directory}/work/token"
