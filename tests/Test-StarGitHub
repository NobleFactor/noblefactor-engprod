# 62 to 74: star github plan link (#557), docs/plans/feature/557-plan-row.md's cases 1 to 13, each named with its number
# there. Each case makes the repositories whose default branch, main, holds its plans, with repository, and the issues
# they serve, with plan_world; then it checks the records, the exit, the writes the stand-in logged, and every byte of
# each body the run left.
data_plan="${run_directory}/data-plan"
make_extension "${data_plan}"
declare -r plan_library='
    def link($repo; $path): "https://github.com/\($repo)/blob/main/\($path)";
    def plan_row($repo; $path): "| Plan | [\($path)](\(link($repo; $path))) |";
    def alpha($path): plan_row("NobleFactor/alpha"; $path);
    def table($hashes; $rows; $eol): ([$hashes + " Plan and design documents", "", "| Kind | Document |", "| --- | --- |"] + $rows) | join($eol);
    def section($rows): table("##"; $rows; "\n");
    def body($k): .issues[$k].body;
    def placeholder: "| Plan | Not yet opened |";
'
declare -r plan_writes='[$calls[] | select(any(.[]; type == "string" and test("^query=mutation starPlanWrite")))]'
declare -r written_ids="${plan_writes}"' | map(.[] | select(type == "string" and startswith("i=")) | ltrimstr("i=")) | sort'
declare -r plan_reads='[$calls[] | select(any(.[]; type == "string" and test("^query=query starPlanBody")))]'

# 62 (plan 1). The section at ##, followed by another section, and at ###, as a form writes it, with no last newline:
# each written, its heading's level kept, and read back.
repository NobleFactor/alpha \
    "docs/plans/feature/1-first.md=$(plan_text https://github.com/NobleFactor/alpha/issues/1)" \
    "docs/plans/feature/2-second.md=$(plan_text https://github.com/NobleFactor/alpha/issues/2)"
jq -n "${plan_library}"'{
    "NobleFactor/alpha#1": {body: ("Problem.\n\n" + section([placeholder]) + "\n\n## Notes\n\nKeep.\n")},
    "NobleFactor/alpha#2": {body: ("### Problem\n\nA form.\n\n" + table("###"; ["| Plan | _No response_ |"]; "\n"))}}' | plan_world
run_star "${data_plan}" github plan link --all --repository NobleFactor/alpha
expect "62 (plan 1): plan link writes the section at ## and at ###, each read back" ok "${plan_library}"'
    map({issue, action, dropped}) == [{issue: "NobleFactor/alpha#1", action: "written", dropped: [placeholder]},
        {issue: "NobleFactor/alpha#2", action: "written", dropped: ["| Plan | _No response_ |"]}]
    and .[0].plans == ["NobleFactor/alpha:docs/plans/feature/1-first.md"] and .[0].url == "https://github.com/NobleFactor/alpha/issues/1"
    and .[0].before == section([placeholder]) + "\n\n" and .[0].after == section([alpha("docs/plans/feature/1-first.md")]) + "\n\n"
    and ('"${written_ids}"') == ["I_alpha_1", "I_alpha_2"] and ('"${plan_reads}"' | length) == 2'
