def values_of($p; $item):
    [$item.values | to_entries[] | . as $e | ($p.fields[] | select(.name == $e.key)) as $f |
        if $f.dataType == "SINGLE_SELECT" then
            {name: $e.value, optionId: ([$f.options[] | select(.name == $e.value) | .id][0]), field: {name: $e.key}}
        else {number: $e.value, field: {name: $e.key}} end];
