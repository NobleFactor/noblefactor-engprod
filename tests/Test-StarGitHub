run_star "${data}" github model diff "${reference}/organization.yaml" Acme
expect "29: afterward diff finds no file or workflow to change" ok '[.[] | select(.kind == "file" or .kind == "workflow")] == []'

# 29b. --token names a secret the template signs in with, or none: an organization's template uses no token.
