# 56 to 61. Each team's project of a kind is held to its template's README, and to the short description the template
# names for a copy, copy_short_description, the team's slug, or the user account, written {owner} (#555), as
# docs/plans/fix/555-copy-readme.md's test plan lists them. Here NobleFactor has a Backlog template, and a third team,
# it, which maintains NobleFactor/gamma: its slug is part of a word, waiting, in its Triage project's short description.
# Each project's README is its template's but Schedule: engprod's, and their short descriptions are:
#
#   Triage: engprod (project 5), the oldest copy of Triage, a text of its own; Triage: devlore (13) and Triage: it (14)
#   one text, each naming its team.
#   Schedule: engprod (12) and Schedule: devlore (15) one text, each naming its team; it has no Schedule project.
#   Backlog: engprod (16) and Backlog: devlore (17) a text each; it has no Backlog project.
make_extension "${run_directory}/data-copies"
jq '.[0].data.organization.teams.nodes += [{name: "IT", slug: "it", id: "T_it", description: "", privacy: "VISIBLE",
        notificationSetting: "NOTIFICATIONS_ENABLED", parentTeam: null,
        repositories: {edges: [{permission: "MAINTAIN", node: {nameWithOwner: "NobleFactor/gamma"}}]}}]' \
    "${run_directory}/fixtures/starOrganizationModel/NobleFactor.json" |
    override "${run_directory}/data-copies" starOrganizationModel/NobleFactor.json
jq -n '[[]]' | override "${run_directory}/data-copies" rest/repos/NobleFactor/gamma/labels_per_page_100.json
jq 'def copy($id; $n; $title; $short; $readme): .id as $from | walk(if type == "string" then gsub($from; $id) else . end)
        | .number = $n | .title = $title | .template = false | .shortDescription = $short | .readme = $readme;
    def queue($team): "Triage for \($team): the queue of issues waiting to be classified";
    def committed($team): "Schedule of \($team): its committed tasks and bugs";
    .[0].data.organization.projectsV2.nodes |= (first(.[] | select(.id == "PVT_template_triage")) as $triage
        | first(.[] | select(.id == "PVT_template_schedule")) as $schedule
        | ($triage | copy("PVT_template_backlog"; 25; "Backlog"; "The Backlog project"; "# Backlog") | .template = true) as $backlog
        | map(if .id == "PVT_triage_engprod" then .shortDescription = "Triage for engprod, before" | .readme = "# Triage"
            elif .id == "PVT_schedule_engprod" then .shortDescription = committed("engprod") | .readme = "# Schedule, before"
            else . end)
        + [$backlog,
            ($triage | copy("PVT_triage_devlore"; 13; "Triage: devlore"; queue("devlore"); "# Triage")),
            ($triage | copy("PVT_triage_it"; 14; "Triage: it"; queue("it"); "# Triage")),
            ($schedule | copy("PVT_schedule_devlore"; 15; "Schedule: devlore"; committed("devlore"); "# Schedule")),
            ($backlog | copy("PVT_backlog_engprod"; 16; "Backlog: engprod"; "Backlog of engprod: its accepted work not yet scheduled";
                "# Backlog")),
            ($backlog | copy("PVT_backlog_devlore"; 17; "Backlog: devlore"; "Backlog of devlore: accepted work"; "# Backlog"))])' \
    "${run_directory}/fixtures/starProjects/NobleFactor.json" | override "${run_directory}/data-copies" starProjects/NobleFactor.json

