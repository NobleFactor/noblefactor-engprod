    "NobleFactor/alpha#23": ({body: ""} + closed(pull(123; $a))),
    "NobleFactor/alpha#24": ({body: ""} + closed({__typename: "Commit", oid: $a, associatedPullRequests: {nodes: [pull(999; $b), pull(124; $a)]}})),
    "NobleFactor/alpha#25": {body: "", state: "CLOSED", stateReason: "COMPLETED"}}' | plan_world
declare -r placed="${plan_library}"'
    def at($oid; $path): "https://github.com/NobleFactor/alpha/blob/\($oid)/\($path)";
    def design($link): "| Design | [docs/design/a.md](\($link)) |";
    def a: "'"${merged_a}"'"; def b: "'"${merged_b}"'";
'
