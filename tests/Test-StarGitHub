# request links each file at that pull request's merge commit, and any other the default branch. alpha's main has two
# commits: the first, A, holds docs/design/a.md and the plans of #20 to #25, each naming it; the second, B, moves #23's
# plan from feature/ to fix/. #20 is open; #21 was closed by pull request #121, merged as A; #22 closed as not planned,
# though its closer names a merged pull request; #23 closed by #123, merged as A, its plan moved since; #24 closed by
# the commit A, the squash merge of #124, among the commit's pull requests one merged as B; and #25 closed by hand, its
# last ClosedEvent naming no closer.
design=$'documents:\n  - kind: Design\n    path: docs/design/a.md\n'
repository NobleFactor/alpha "docs/design/a.md=# A" \
    "docs/plans/feature/20-open.md=$(plan_text https://github.com/NobleFactor/alpha/issues/20 "${design}")" \
    "docs/plans/feature/21-merged.md=$(plan_text https://github.com/NobleFactor/alpha/issues/21 "${design}")" \
    "docs/plans/feature/22-not-planned.md=$(plan_text https://github.com/NobleFactor/alpha/issues/22 "${design}")" \
    "docs/plans/feature/23-moved.md=$(plan_text https://github.com/NobleFactor/alpha/issues/23 "${design}")" \
    "docs/plans/feature/24-squash.md=$(plan_text https://github.com/NobleFactor/alpha/issues/24 "${design}")" \
