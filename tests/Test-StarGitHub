    and (test("test-user/elsewhere") | not) and (test("\\+fields:") | not)' "" text

# 1b. An account with no model file yet gets its first: the pull starts from an empty model of it.
make_extension "${run_directory}/data-first" "${run_directory}/models/minimal.yaml" none
run_star "${run_directory}/data-first" github model pull --check --account test-user --output value
expect "1b: an account with no model file gets its first, model.test-user.yaml" ok '
    test("/model\\.test-user\\.yaml") and test("would be written, the account.s first") and test("\\+    label: \"task\"")
    and test("\\+    label: \"scenario\"")' "" text

# 1c. A record's keys come from its repository owner's model: Area from the field in an organization, from the area:
