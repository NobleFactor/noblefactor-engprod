# 30. A new user account joins through apply: with no --token, it names the missing secret to set by hand, and makes the
# rest; with --token env:<NAME>, it sets the secret on each repository, showing the token's fingerprint, not the token.
repository David-Noble-at-work/.github ".github/ISSUE_TEMPLATE/task.yml=name: Task" "workflow-templates/triage.yml=${user_template}" \
    "README.md=# David-Noble-at-work's .github"
repository test-user/personal
run_star "${data}" github model apply "${reference}/user.yaml" test-user
expect "30: with no --token, apply names the missing secret to set by hand, and makes the rest" ok '
    any(.[]; .kind == "secret" and .path == "test-user/personal/ADD_TO_PROJECT_PAT" and .action == "by-hand"
        and (.steps[0] | test("gh secret set ADD_TO_PROJECT_PAT --repo test-user/personal")))
    and any(.[]; .kind == "workflow" and .path == "test-user/personal" and .action == "created")
    and any(.[]; .kind == "file" and .path == "test-user/.github/.github/ISSUE_TEMPLATE/task.yml" and .action == "created")
    and any(.[]; .kind == "file" and .path == "test-user/.github/README.md" and .action == "changed")'
check "30: test-user/.github's README names test-user" shows test-user/.github README.md "# test-user's .github"
check "30: test-user/personal holds the Triage workflow" shows test-user/personal .github/workflows/triage.yml "${user_template}"
run_star "${data}" github model apply "${reference}/user.yaml" test-user --token env:SITE_TOKEN
unset SITE_TOKEN
fingerprint="$(printf %s token-for-site | { sha256sum 2>/dev/null || shasum -a 256; } | cut -c1-12)"
expect "30: --token env:<NAME> sets the secret, its record showing the token's fingerprint and never the token" ok "
    any(.[]; .kind == \"secret\" and .path == \"test-user/personal/ADD_TO_PROJECT_PAT\" and .action == \"created\"
        and .fingerprint == \"${fingerprint}\")
    and (tostring | test(\"token-for-site\") | not)"
check "30: test-user/personal's secret is the token --token named" grep -qxF "secret test-user/personal ADD_TO_PROJECT_PAT token-for-site" \
    "${run_directory}/remotes/secrets"
check "30: the token appears in none of gh's calls" bash -c "! grep -qF token-for-site '${run_directory}/calls.jsonl'"

# 31. apply refuses star's --dry-run, whose reads are skipped until NobleFactor/devlore-cli#1170.
run_star "${data}" github model apply noblefactor.json NobleFactor --dry-run
expect "31: apply refuses --dry-run, naming NobleFactor/devlore-cli#1170, and writes nothing" error "${writes}"'
