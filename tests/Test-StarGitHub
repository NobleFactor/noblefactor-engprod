# The jq that finds one issue's record in the report's output, or one issue's entry in the sweep's.
declare -r record='def record($k): first(.[] | select(.issue == $k));'
declare -r entry='def entry($k): first(.[] | select(.issue == $k and (.action == "added" or .action == "in-triage")));
    def absent($k): [.[] | select(.issue == $k and .faults != [])] | length == 0;'
declare -r faulted='def faulted($k; $rule): [entry($k).faults[].rule] | index($rule) != null;'

# 1. The model's load: a type with neither a level nor a Collection: description stops the extension, named; a
# collection type loads.
sed 's/^  - name: "Scenario"$/  - name: "Chore"\n    id: 7\n    color: "gray"\n    description: "Work of no level"\n  - name: "Scenario"/' \
    "${run_directory}/models/model.yaml" >"${run_directory}/models/model.chore.yaml"
make_extension "${run_directory}/data-chore" "${run_directory}/models/model.chore.yaml"
quiet=""
run_star "${run_directory}/data-chore" github schedule report NobleFactor/alpha
quiet="--silent"
expect "1: a type with no level and no Collection: description is refused, named" error "" "type Chore"
run_star "${data}" github schedule report NobleFactor/alpha
expect "1: a model with collection types loads, and the report runs" ok 'type == "array" and length == 11'

# 1a. pull reads collection types, fields with their options and teams with the repositories they maintain. The
# models hold the hierarchy's types alone, so the diff shows every record the pull adds.
make_extension "${run_directory}/data-minimal" "${run_directory}/models/minimal.yaml" \
    "${run_directory}/models/minimal.test-user.yaml"
run_star "${run_directory}/data-minimal" github model pull --check --output value
