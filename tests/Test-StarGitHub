function write_models {
    local spec name level id label types="" labels=""

    mkdir -p -- "${run_directory}/models"
    for spec in Epic:0:1 Feature:1:2 Bug:2:3 Task:2:4; do
        IFS=: read -r name level id <<<"${spec}"
        label="$(tr '[:upper:]' '[:lower:]' <<<"${name}")"
        types+="  - name: \"${name}\"
    id: ${id}
    level: ${level}
    color: \"c\"
    description: \"Level ${level}: a type\"
"
        labels+="  - name: \"${name}\"
    id: \"LA_${label}\"
    label: \"${label}\"
    level: ${level}
    color: \"c\"
    description: \"Level ${level}: a type\"
"
