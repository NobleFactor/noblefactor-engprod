            PVT_old: {id: "PVT_old", title: "Schedule: issue tracking, iteration 1", number: 12, closed: true,
                fields: [{id: "F_lane", name: "Step", dataType: "NUMBER"}, status],
                items: [{id: "IT_old_25", content: id("NobleFactor/alpha"; 25), values: {Step: 11, Status: "Open"}}]},
            PVT_s_dev: {id: "PVT_s_dev", title: "Schedule: devlore", number: 29,
                fields: schedule_fields([{id: "O_d1", name: "d1", description: "NobleFactor/beta#50"}]),
                items: [item("NobleFactor/beta"; 50; {Schedule: "d1", Status: "Open"}),
                    item("NobleFactor/beta"; 51; step("d1"; 1; "Open")), item("NobleFactor/beta"; 52; step("d1"; 2; "Open"))]},
            PVT_s_user: {id: "PVT_s_user", title: "Schedule: test-user", number: 7,
                fields: schedule_fields([{id: "O_u1", name: "u1", description: "test-user/personal#10"}]),
                items: [item("test-user/personal"; 10; {Schedule: "u1", Status: "Open"}),
                    item("test-user/personal"; 11; step("u1"; 1; "Open"))]},
            PVT_t_user: {id: "PVT_t_user", title: "Triage: test-user", number: 9, fields: [status], items: []},
            PVT_c_user: {id: "PVT_c_user", title: "Scenario: test-user", number: 8,
                fields: scenario_fields([{id: "O_uwalk", name: "user walk", description: "test-user/personal#20"}]),
                items: [item("test-user/personal"; 20; {Scenario: "user walk", Status: "Open"})]}}}
        | .projects |= with_entries(.key as $project | .value.fields |= map(.id += "_" + $project))'
}

# world gives one of add's cases its GitHub: base_world, changed by a jq program when one is given, as the world the
# stand-in's schedule operations answer from.
#
# Parameters:
#   - `$1`: a jq program to change base_world by; optional, none by default.
#
# Returns:
#   - 0, the world written.
function world {
    base_world | jq "${1:-.}" >"${run_directory}/remotes/world.json"
}

# world_holds succeeds when a jq program over the world, as the last run left it, prints true.
#
# Parameters:
#   - `$1`: the jq program.
#
# Returns:
#   - 0 when it prints true; 1 otherwise.
function world_holds {
    [[ "$(jq "$1" "${run_directory}/remotes/world.json")" == true ]]
}

# calls_hold succeeds when a jq program over the calls the last run made, as one array of argument arrays, prints true.
#
# Parameters:
#   - `$1`: the jq program.
#
# Returns:
#   - 0 when it prints true; 1 otherwise.
function calls_hold {
    [[ "$(jq --slurp "$1" "${run_directory}/calls.jsonl")" == true ]]
}

# plan_world gives one of plan link's cases its issues (#557), ${run_directory}/remotes/plan-issues.json, which the
# stand-in's starPlan operations answer from and its writes change: each issue of a JSON object on standard input, by
# its key, owner/name#N, with its body, and its kind, Issue unless it says PullRequest; its node ID and URL made from
# its key. The plans are files on the default branches of the repositories the case makes with repository.
#
# Parameters:
#   - standard input: the issues, as a JSON object.
#   - `$1`: true to make each write answer as done while the body stays as it was; optional, false by default.
#
# Returns:
#   - 0, the issues written.
function plan_world {
    jq -c --argjson drop "${1:-false}" '{drop_write: $drop, issues: (with_entries(.key as $k | .value |= ({kind: "Issue", body: ""}
        + . + {id: ("I_" + ($k | split("/")[1] | gsub("[#.-]"; "_"))), url: ("https://github.com/" + ($k | sub("#"; "/issues/")))})))}' \
        >"${run_directory}/remotes/plan-issues.json"
}

# plan_holds succeeds when a jq program over the issues, as the last run left them, prints true. It is given the
# library plan_library defines.
#
# Parameters:
#   - `$1`: the jq program.
#
# Returns:
#   - 0 when it prints true; 1 otherwise.
function plan_holds {
    [[ "$(jq "${plan_library}$1" "${run_directory}/remotes/plan-issues.json")" == true ]]
}

# plan_text prints a plan as the repositories hold them: its frontmatter, with a title carrying an unquoted colon, which
# is no YAML, so that a case reads only the keys the command decodes; its issue: line; the lines of frontmatter given;
# and its body.
#
# Parameters:
#   - `$1`: what the issue: line says, as YAML.
#   - `$2`: more frontmatter, each line ending in a newline; optional, none by default.
#   - `$3`: the plan's body; optional, none by default.
#
# Returns:
#   - 0, the plan printed.
function plan_text {
    printf -- '---\ntitle: Plan: a plan for a test\nissue: %s\nstatus: active\n%s---\n\n# Plan\n\n%s' "$1" "${2:-}" "${3:-}"
}

# issue_form prints an issue form as each account's .github repository holds its Schedule and Scenario forms (read
# 2026-11-16): its name, what sets its issues' type, its Area dropdown, its textareas, each required, and its Plan and
# design documents textarea with its default table (#509).
#
# Parameters:
#   - `$1`: the form's name, Schedule or Scenario.
#   - `$2`: what sets its type: type: <type> in an organization's form, labels: and its label in a user account's.
#   - `${@:3}`: its textareas before the documents one, in its order, each id=label.
#
# Returns:
#   - 0, the form printed.
function issue_form {
    local name="$1" sets="$2" textarea
    shift 2

    printf 'name: %s\ndescription: A %s\n%s\nbody:\n' "${name}" "${name,,}" "${sets}"
    printf -- '- type: dropdown\n  id: area\n  attributes:\n    label: Area\n    options:\n    - Product\n    - Engineering\n'
    printf '  validations:\n    required: true\n'
    for textarea in "$@"; do
        printf -- '- type: textarea\n  id: %s\n  attributes:\n    label: %s\n  validations:\n    required: true\n' \
            "${textarea%%=*}" "${textarea#*=}"
    done
    printf -- '- type: textarea\n  id: documents\n  attributes:\n    label: Plan and design documents\n    value: |\n'
    printf '      | Document | Link |\n      | --- | --- |\n      | Plan | Not yet opened |\n  validations:\n    required: true\n'
}

# write_stand_in writes the stand-in for gh to the run's bin directory.
#
# It records each call as a JSON array of its arguments, one per line of ${GH_CALLS}, and answers from ${GH_FIXTURES}:
# a GraphQL request by the operation name the extension gives it, a REST request by its path. Every fixture file is a
# JSON array of responses, one per page; --paginate answers every page and a request without it the first, and --jq
# is applied to each, as gh does. An addition to a project is remembered in ${GH_STATE}, so that reading the row back
# finds it.
#
# A fixture may be the data directory's own, under ${XDG_DATA_HOME}/fixtures, which a case gives it with override; it
# is answered before the run's. A login in a fixture's path matches in any case, as GitHub's logins do (#485), and a
# REST fixture of more than one page answers its first with a Link header naming the next, as GitHub does (#484). An
# account's .github repository is a bare repository under ${GH_REMOTES}, which `repo view`, `repo create` and `repo
# clone` answer from, and a pull request opened on it is merged by moving its main to the pull request's branch: the
# git side of `star github model backup` (#426). Its pull requests are remembered in ${GH_REMOTES}/pulls, across runs,
# so that a backup run again finds the one an earlier run left open; its main's rules, its head commit's workflow runs
# and its checks are as the case's ci set them.
#
# The stand-in for sleep records how long it was asked to wait, among gh's calls, and returns at once. The stand-in for
# date answers `date -u +%Y-%m-%d`, the day star dates what it writes by, with ${STAR_TEST_TODAY}, the day the suite
# began, so that a run that crosses midnight UTC dates each write as the cases expect; any other use is the real date's.
#
# A write, a REST call with -X or a GraphQL mutation, is recorded among the calls and answered with a new ID; a secret
# set is remembered, value and all, a newline written as \n, in ${GH_REMOTES}/secrets, on a repository or an
# organization, so that a case can read back the token it was given.
#
# Any repository under ${GH_REMOTES} answers what apply reads and writes of it (#437): GitHub's record of it, its files
# raw at a revision, the git data API apply commits through, a ref, a commit, a tree, and its variables, remembered in
# ${GH_REMOTES}/variables. A body sent with --input - is read from standard input.
#
# The schedule and scenario commands' operations (#438, #511, #509, #512), starViewer and every starStep one, answer
# from one world, ${GH_REMOTES}/world.json, which a case writes with world and its writes change, through world.jq
# beside the stand-in, so that a read after a write finds it, as GitHub's would: a project found by its title, a comment
# kept on its issue, an issue filed, and an issue closed, among them. How an issue closed is what a case gives it: its
# stateReason, its closedAt, its references, the pull requests GitHub records as closing it, and its closer. The world
# may name an operation to fail once, fail_on, after letting fail_skip calls of it through, none by default, and
# another writer's change to make after an operation's first answer, change.
#
# star github plan link's operations (#557): starPlanBlobs and starPlanAt answer each aliased object(expression:
# "<revision>:<path>") with the file's text from the repository's bare repository under ${GH_REMOTES}, or null;
# starPlanIssues answers each aliased issueOrPullRequest from ${GH_REMOTES}/plan-issues.json, which plan_world writes,
# with the issue's state, its state reason, its last ClosedEvent's closer, its type, its labels and its issue fields, as
# the issue gives them, and a number it lacks with null and a NOT_FOUND error, gh's exit 1 with it, as GitHub and gh
# answer; starPlanWrite sets an issue's body there, unless the case asked that writes not stick, drop_write; and
# starPlanBody reads it back.
#
# Returns:
#   - 0, the stand-ins written and executable.
function write_stand_in {
    mkdir -p -- "${run_directory}/bin"
    cat >"${run_directory}/bin/sleep" <<'SLEEP'
#!/usr/bin/env bash
printf '%s\0' sleep "$@" | jq -c -R -s 'split("\u0000") | .[:-1]' >>"${GH_CALLS}"
SLEEP
    chmod +x "${run_directory}/bin/sleep"
    cat >"${run_directory}/bin/date" <<DATE
#!/usr/bin/env bash
if [[ \$# -eq 2 && \$1 == -u && \$2 == +%Y-%m-%d ]]; then
    printf '%s\\n' "\${STAR_TEST_TODAY:?}"
    exit 0
fi
exec $(command -v date) "\$@"
DATE
    chmod +x "${run_directory}/bin/date"
    cat >"${run_directory}/bin/world.jq" <<'JQ'
# The schedule commands' GitHub: one world that their reads answer from and their writes change. Its issues and its
# projects are keyed by node ID; a project's items are its rows, in its order, each with its content's ID and its
# values by field name, each answered as GitHub types the field's value. The answer is {answer} for a read, {answer,
# world} for a write.
def values_of($p; $item):
    [$item.values | to_entries[] | . as $e | ($p.fields[] | select(.name == $e.key)) as $f |
        if $f.dataType == "SINGLE_SELECT" then
            {name: $e.value, optionId: ([$f.options[] | select(.name == $e.value) | .id][0]), field: {name: $e.key}}
        elif $f.dataType == "TEXT" then {text: $e.value, field: {name: $e.key}}
        elif $f.dataType == "ITERATION" then {title: $e.value, field: {name: $e.key}}
        else {number: $e.value, field: {name: $e.key}} end];
def content($w; $id):
    $w.issues[$id] as $i |
    {id: $i.id, number: $i.number, title: $i.title, state: $i.state,
        issueType: (if $i.type then {name: $i.type} else null end),
        labels: {nodes: [($i.labels // [])[] | {name: .}]}, repository: {nameWithOwner: $i.repo},
        assignees: {nodes: [($i.assignees // [])[] | {login: .}]},
        blockedBy: {nodes: [($i.blockedBy // [])[] | $w.issues[.] | {id, number, state, repository: {nameWithOwner: .repo}}]}};
def issue_node($w; $i):
    content($w; $i.id) + {body: $i.body, url: "https://github.com/\($i.repo)/issues/\($i.number)",
        projectItems: {nodes: [$w.projects[] as $p | $p.items[] | select(.content == $i.id) |
            {id, project: {id: $p.id, title: $p.title, number: $p.number, closed: ($p.closed // false)},
                fieldValues: {nodes: values_of($p; .)}}]}};
def field($w; $p; $f): $w.projects[$p].fields[] | select(.id == $f);
def set_value($w; $p; $i; $name; $value):
    $w | .projects[$p].items |= map(if .id == $i then .values[$name] = $value else . end);

. as $w |
(if $op == "starViewer" then {answer: {data: {viewer: {login: $w.viewer}}}}
elif $op == "starStepIssue" then
    {answer: {data: {repository: {issue: ([$w.issues[] | select(.repo == $repo and (.number | tostring) == $number)][0]
        | if . then issue_node($w; .) else null end)}}}}
elif $op == "restFileIssue" then
    ($body | fromjson) as $in | (((([$w.issues[] | select(.repo == $repo) | .number] | max) // 0) + 1)) as $n |
    ("I_" + ($repo | split("/")[1]) + "_" + ($n | tostring)) as $id |
    {world: ($w | .issues[$id] = {id: $id, repo: $repo, number: $n, title: $in.title, state: "OPEN", type: ($in.type // null),
            labels: ($in.labels // []), assignees: ($in.assignees // []), blockedBy: [], body: $in.body}),
        answer: {number: $n, node_id: $id, html_url: "https://github.com/\($repo)/issues/\($n)"}}
elif $op == "starStepOpen" then
    {answer: {data: {repository: {issues: {nodes: ([$w.issues[] | select(.repo == $repo and .state == "OPEN")] | sort_by(-.number)
        | map({number, title}))}}}}}
elif $op == "starStepFields" then
    {answer: {data: {node: {issueFieldValues: {nodes: [($w.issues[$node].fields // {}) | to_entries[]
        | {name: .value, field: {name: .key}}]}}}}}
elif $op == "starStepClose" then
    {world: ($w | .issues[$i] |= (.state = "CLOSED" | .stateReason = "COMPLETED")), answer: {data: {closeIssue: {issue: {id: $i}}}}}
elif $op == "starStepRepository" then
    # A repository's node ID, its issue types, an organization's six, and its labels, the world's or the user account's.
    {answer: {data: {repository: {id: ("R_" + $repo),
        issueTypes: {nodes: (if ($repo | startswith("test-user/")) then []
            else (["Epic", "Feature", "Task", "Bug", "Schedule", "Scenario"] | map({id: ("IT_" + .), name: .})) end)},
        labels: {nodes: (($w.labels[$repo] // ["epic", "feature", "task", "bug", "schedule", "scenario", "area:product",
            "area:engineering", "priority:urgent", "priority:high", "priority:medium", "priority:low", "severity:critical",
            "severity:high", "severity:medium", "severity:low", "severity:n/a"]) | map({id: ("L_" + .), name: .}))}}}}}
elif $op == "starStepSubIssues" then
    # An issue's sub-issues, open and closed: every issue whose parent it is.
    ([$w.issues[] | select(.repo == $repo and (.number | tostring) == $number) | .id][0]) as $pid |
    {answer: {data: {repository: {issue: {subIssues: {nodes: [$w.issues[] | select(.parent == $pid and $pid != null)
        | {number, title, repository: {nameWithOwner: .repo}}]}}}}}}
elif $op == "starStepCreate" then
    # GitHub's createIssue, its input the JSON star sent: the issue joins the world, numbered after its repository's last.
    ($body | fromjson | .variables.input) as $in | ($in.repositoryId | ltrimstr("R_")) as $r |
    (([$w.issues[] | select(.repo == $r) | .number] | max // 0) + 1) as $n |
    ("I_" + ($r | split("/")[1]) + "_" + ($n | tostring)) as $id |
    {world: ($w | .issues[$id] = {id: $id, repo: $r, number: $n, title: $in.title, state: "OPEN",
            type: (($in.issueTypeId // "") | ltrimstr("IT_") | if . == "" then null else . end),
            labels: [($in.labelIds // [])[] | ltrimstr("L_")], assignees: [($in.assigneeIds // [])[] | ltrimstr("U_")],
            blockedBy: [], body: $in.body, parent: ($in.parentIssueId // null),
            fields: (reduce ($in.issueFields // [])[] as $f ({};
                . + {($w.issue_fields[$f.fieldId].name): $w.issue_fields[$f.fieldId].options[$f.singleSelectOptionId]}))}),
        answer: {data: {createIssue: {issue: {number: $n}}}}}
elif $op == "starStepReopen" then
    {world: ($w | .issues[$i] |= (.state = "OPEN" | .stateReason = null)), answer: {data: {reopenIssue: {issue: {id: $i}}}}}
elif $op == "starStepClearField" then
    $w.issue_fields[$f] as $field |
    {world: ($w | .issues[$i].fields |= ((. // {}) | del(.[$field.name]))), answer: {data: {deleteIssueFieldValue: {clientMutationId: null}}}}
elif $op == "starStepState" then
    {answer: {data: {node: ($w.issues[$node] | {state, stateReason: (.stateReason // (if .state == "CLOSED" then "COMPLETED" else null end))})}}}
elif $op == "starStepClosing" then
    # How an issue closed: what a case gives it, its references the pull requests GitHub records as closing it, and its
    # closer its last ClosedEvent's; a closed issue with no reason given closed as completed.
    {answer: {data: {repository: {issue: ([$w.issues[] | select(.repo == $repo and (.number | tostring) == $number)][0]
        | if . == null then null else {state, stateReason: (.stateReason // (if .state == "CLOSED" then "COMPLETED" else null end)),
            closedAt: (.closedAt // null), labels: {nodes: [(.labels // [])[] | {name: .}]},
            issueFieldValues: {nodes: [(.fields // {}) | to_entries[] | {name: .value, field: {name: .key}}]},
            closedByPullRequestsReferences: {nodes: (.references // [])},
            timelineItems: {nodes: (if .closer then [{closer: .closer}] else [] end)}} end)}}}}
elif $op == "starStepSetField" then
    $w.issue_fields[$f] as $field |
    {world: ($w | .issues[$i].fields[$field.name] = $field.options[$o]), answer: {data: {setIssueFieldValue: {clientMutationId: null}}}}
elif $op == "starStepOptions" then
    # A field's options written whole, as a literal in the mutation: each kept by its ID, each without one made anew.
    ($query | capture("fieldId: \"(?<f>[^\"]+)\", singleSelectOptions: \\[(?<o>.*)\\]\\}\\)")) as $m |
    ("[" + ($m.o | gsub("(?<p>\\{|, )(?<k>id|name|color|description): "; "\(.p)\"\(.k)\": ")
        | gsub("\"color\": (?<c>[A-Z_]+)"; "\"color\": \"\(.c)\"")) + "]" | fromjson) as $options |
    {world: ($w | .projects |= map_values(.fields |= map(if .id == $m.f then .options = [$options[]
            | {id: (.id // ("O_" + (.name | gsub("[^A-Za-z0-9]"; "_")))), name, color, description}] else . end))),
        answer: {data: {r: {projectV2Field: {id: $m.f}}}}}
elif $op == "starStepProject" then
    {answer: {data: {node: ($w.projects[$node] | {id, title, number, fields: {nodes: .fields}})}}}
elif $op == "starStepRows" then
    {answer: {data: {node: {items: {pageInfo: {hasNextPage: false, endCursor: null}, nodes: [$w.projects[$node] as $p |
        $p.items[] | {id, content: content($w; .content), fieldValues: {nodes: values_of($p; .)}}]}}}}}
elif $op == "starStepReadRow" then
    ([$w.projects[] as $p | $p.items[] | select(.id == $node) | {project: {id: $p.id}, fieldValues: {nodes: values_of($p; .)}}][0])
    | if . then {answer: {data: {node: .}}} else {error: "Could not resolve to a node with the global id of \($node)"} end
elif $op == "starStepBody" then {answer: {data: {node: {body: $w.issues[$node].body}}}}
elif $op == "starStepTeam" then
    {answer: {data: {organization: {team: {members: {nodes: [($w.teams[$slug] // [])[]
        | select(ascii_downcase | contains($member | ascii_downcase)) | {login: .}]}}}}}}
elif $op == "starStepUser" then {answer: {data: {user: {id: ("U_" + $user)}}}}
elif $op == "starStepAddRow" then
    ([$w.projects[$p].items[] | select(.content == $c) | .id][0]) as $have |
    if $have then {answer: {data: {addProjectV2ItemById: {item: {id: $have}}}}}
    else ("PVTI_" + $c) as $id |
        {world: ($w | .projects[$p].items += [{id: $id, content: $c, values: {}}]),
            answer: {data: {addProjectV2ItemById: {item: {id: $id}}}}} end
elif $op == "starStepSetOption" then
    field($w; $p; $f) as $fd |
    {world: set_value($w; $p; $i; $fd.name; ([$fd.options[] | select(.id == $o) | .name][0])),
        answer: {data: {updateProjectV2ItemFieldValue: {projectV2Item: {id: $i}}}}}
elif $op == "starStepSetStep" or $op == "starStepSetBeat" then
    {world: set_value($w; $p; $i; field($w; $p; $f).name; ($v | tonumber)),
        answer: {data: {updateProjectV2ItemFieldValue: {projectV2Item: {id: $i}}}}}
elif $op == "starStepFind" then
    {projectsV2: {nodes: [$w.projects[] | select(.title | contains($title)) | {id, title, closed: (.closed // false)}]}} as $found |
    {answer: {data: {organization: $found, user: $found}}}
elif $op == "starStepComment" then
    (($w.issues[$s].comments // []) | length) as $n |
    {world: ($w | .issues[$s].comments = ((.issues[$s].comments // []) + [$b])),
        answer: {data: {addComment: {commentEdge: {node: {id: ("IC_" + $s + "_" + ($n | tostring))}}}}}}
elif $op == "starStepPlace" then
    # With no row to follow, the row is placed first.
    ($w.projects[$p].items | map(select(.id == $i))[0]) as $it | ($w.projects[$p].items | map(select(.id != $i))) as $rest |
    (if $a == "" then -1 else ($rest | map(.id) | index($a)) end) as $at |
    {world: ($w | .projects[$p].items = ($rest[:($at + 1)] + [$it] + $rest[($at + 1):])),
        answer: {data: {updateProjectV2ItemPosition: {clientMutationId: null}}}}
elif $op == "starStepDeleteRow" then
    {world: ($w | .projects[$p].items |= map(select(.id != $i))), answer: {data: {deleteProjectV2Item: {deletedItemId: $i}}}}
elif $op == "starStepAmend" then {world: ($w | .issues[$i].body = $b), answer: {data: {updateIssue: {issue: {id: $i}}}}}
elif $op == "starStepParent" then
    # An issue's sub-issue parent, its parent the ID a case gives it, and the states of every issue with that parent.
    ([$w.issues[] | select(.repo == $repo and (.number | tostring) == $number)][0].parent // null) as $pid |
    {answer: {data: {repository: {issue: {parent: (if $pid == null then null else $w.issues[$pid] |
        {number, state, repository: {nameWithOwner: .repo}, subIssues: {nodes: [$w.issues[] | select(.parent == $pid) | {state}]}} end)}}}}}
elif $op == "restAddLabels" then
    # Labels added to an issue by REST, its number given as issue(number: N), the body {labels: [...]}.
    ([$w.issues[] | select(.repo == $repo and (.number | tostring) == $number) | .id][0]) as $id |
    {world: ($w | .issues[$id].labels = ((.issues[$id].labels // []) + ($body | fromjson | .labels) | unique)),
        answer: [($w.issues[$id].labels // [])[] | {name: .}]}
elif $op == "restRemoveLabel" then
    # A label removed from an issue by REST, its name given as label("<name>").
    ([$w.issues[] | select(.repo == $repo and (.number | tostring) == $number) | .id][0]) as $id |
    ($query | capture("label\\(\"(?<l>[^\"]+)\"\\)").l) as $label |
    {world: ($w | .issues[$id].labels = [(.issues[$id].labels // [])[] | select(. != $label)]), answer: []}
elif $op == "starStepBlock" then
    {world: ($w | .issues[$i].blockedBy += [$b]), answer: {data: {addBlockedBy: {clientMutationId: null}}}}
elif $op == "starStepAssign" then
    {world: ($w | .issues[$a].assignees += [$u | ltrimstr("U_")]), answer: {data: {addAssigneesToAssignable: {clientMutationId: null}}}}
else error("the world has no answer for " + $op) end) as $r |

# Another writer, as a case may ask: after the first answer to the operation it names, the rows it sets change.
if ($w.change.on? // "") == $op then
    $r | .world = ((.world // $w) | reduce $w.change.set[] as $s (.;
        .projects[$s.project].items |= map(if .id == $s.item then .values[$s.field] = $s.value else . end)) | del(.change))
else $r end
JQ
    cat >"${run_directory}/bin/gh" <<'GH'
#!/usr/bin/env bash
set -uo pipefail

# Each argument NUL-terminated, so that jq reads them as data: given them as --args, it parses gh's own options.
printf '%s\0' "$@" | jq -c -R -s 'split("\u0000") | .[:-1]' >>"${GH_CALLS}"

# answer prints a fixture's responses, every page with --paginate, through --jq when it was given.
function answer {
    local file="$1" filter="${2:-.}" count index
    [[ -r "${file}" ]] || { printf 'stand-in gh: no fixture %s\n' "${file}" >&2; exit 1; }
    count="$(jq 'length' "${file}")"
    ((paginate)) || count=1
    for ((index = 0; index < count; index++)); do
        jq -c ".[${index}] | ${filter}" "${file}" | if [[ -n "${jq_program}" ]]; then jq -r -c "${jq_program}"; else cat; fi
    done
}

# cased names a file under a fixtures directory as given, or, since GitHub's logins ignore case, the file whose path
# matches it in another case (#485); as given when neither is there.
function cased {
    local root="$1" relative="$2" found=""
    if [[ -e "${root}/${relative}" ]]; then
        printf '%s' "${root}/${relative}"
        return 0
    fi
    [[ -d "${root}" ]] && found="$(find "${root}" -ipath "${root}/${relative}" -print -quit 2>/dev/null)"
    printf '%s' "${found:-${root}/${relative}}"
}

# fixture names a fixture: the data directory's own, which a case may give it, before the run's.
function fixture {
    local own
    own="$(cased "${XDG_DATA_HOME}/fixtures" "$1")"
    if [[ -r "${own}" ]]; then printf '%s' "${own}"; else cased "${GH_FIXTURES}" "$1"; fi
}

# ci_mode prints how a repository's CI behaves, as the case's ci set it: none, pass, fail, never, private or refused.
function ci_mode {
    cat "${GH_REMOTES}/$1.ci" 2>/dev/null || echo none
}

# filtered prints standard input through --jq, when the arguments give it, as gh does.
function filtered {
    local program
    program="$(option --jq "$@")"
    if [[ -n "${program}" ]]; then jq -r "${program}"; else cat; fi
}

# option prints the value that follows a flag among the arguments, or nothing.
function option {
    local flag="$1"
    shift 1
    while (($#)); do
        [[ "$1" == "${flag}" ]] && { printf '%s' "${2:-}"; return 0; }
        shift 1
    done
}

# An account's .github repository is a bare repository under ${GH_REMOTES}; each pull request is remembered in
# ${GH_REMOTES}/pulls as `pr <repository> <number> <branch> <open|merged>`, and merging one moves main to its branch.
pulls="${GH_REMOTES}/pulls"
case "${1:-} ${2:-}" in
    "repo view" | "repo create" | "repo clone")
        target="${3:-}"
        if [[ "$2" == view && (-z "${target}" || "${target}" == -*) ]]; then
            echo "NobleFactor/alpha"
            exit 0
        fi
        bare="${GH_REMOTES}/${target}.git"
        case $2 in
            view)
                [[ -d "${bare}" ]] || { printf 'GraphQL: Could not resolve to a Repository with the name %s. (repository)\n' "${target}" >&2; exit 1; }
                printf '%s\n' "${target##*/}"
                ;;
            create)
                seed="${GH_REMOTES}/seed-${target//\//-}"
                mkdir -p -- "$(dirname "${bare}")"
                git init --quiet --bare --initial-branch=main "${bare}" && git init --quiet --initial-branch=main "${seed}" &&
                    printf '# .github\n' >"${seed}/README.md" && git -C "${seed}" add --all &&
                    git -C "${seed}" commit --quiet -m "Initial commit" && git -C "${seed}" push --quiet "${bare}" main &&
                    rm -rf -- "${seed}" || exit 1
                printf 'https://github.com/%s\n' "${target}"
                ;;
            clone)
                [[ -d "${bare}" ]] || { printf 'stand-in gh: no repository %s\n' "${target}" >&2; exit 1; }
                git clone --quiet "${bare}" "${4:-${target##*/}}" || exit 1
                ;;
        esac
        exit 0
        ;;
    "pr create")
        repo="$(option --repo "$@")" head="$(option --head "$@")"
        number=$(($(awk '$1 == "pr" && $5 == "open"' "${pulls}" 2>/dev/null | wc -l) + 1))
        printf 'pr %s %s %s open\n' "${repo}" "${number}" "${head}" >>"${pulls}"
        printf 'https://github.com/%s/pull/%s\n' "${repo}" "${number}"
        exit 0
        ;;
    "pr list")
        repo="$(option --repo "$@")" head="$(option --head "$@")"
        awk -v r="${repo}" -v h="${head}" '$1 == "pr" && $2 == r && $4 == h { state[$3] = $5 }
            END { for (n in state) if (state[n] == "open") print n }' "${pulls}" 2>/dev/null |
            jq -R -s -c --arg r "${repo}" '[split("\n")[] | select(. != "") | {number: tonumber, url: ("https://github.com/" + $r + "/pull/" + .)}]' |
            filtered "$@"
        exit 0
        ;;
    "pr checks")
        repo="$(option --repo "$@")"
        case "$(ci_mode "${repo}")" in
            pass) bucket=pass ;;
            fail) bucket=fail ;;
            *)
                printf "no checks reported on the 'chore' branch\n" >&2
                exit 1
                ;;
        esac
        jq -cn --arg b "${bucket}" '[{name: "quality-gate", bucket: $b}]' | filtered "$@"
        exit 0
        ;;
    "pr comment" | "pr edit")
        exit 0
        ;;
    "secret set")
        repo="$(option --repo "$@")" org="$(option --org "$@")" value="$(cat)"
        printf 'secret %s %s %s\n' "${repo:-${org}}" "$3" "${value//$'\n'/\\n}" >>"${GH_REMOTES}/secrets"
        exit 0
        ;;
    "secret list")
        repo="$(option --repo "$@")" org="$(option --org "$@")"
        awk -v r="${repo:-${org}}" '$1 == "secret" && $2 == r { print $3 }' "${GH_REMOTES}/secrets" 2>/dev/null |
            jq -R -s -c '[split("\n")[] | select(. != "") | {name: ., visibility: "all"}] | unique' | filtered "$@"
        exit 0
        ;;
    "pr merge")
        repo="$(option --repo "$@")" number="${3:-}"
        head="$(awk -v r="${repo}" -v n="${number}" '$1 == "pr" && $2 == r && $3 == n { print $4; exit }' "${pulls}")"
        [[ -n "${head}" ]] || { printf 'stand-in gh: no pull request %s in %s\n' "${number}" "${repo}" >&2; exit 1; }
        git --git-dir="${GH_REMOTES}/${repo}.git" update-ref refs/heads/main "refs/heads/${head}" || exit 1
        printf 'pr %s %s %s merged\n' "${repo}" "${number}" "${head}" >>"${pulls}"
        exit 0
        ;;
    "pr view")
        repo="$(option --repo "$@")" number="${3:-}" state=OPEN
        grep -q "^pr ${repo} ${number} .* merged$" "${pulls}" 2>/dev/null && state=MERGED
        jq -cn --arg s "${state}" --arg u "https://github.com/${repo}/pull/${number}" '{state: $s, url: $u}' | filtered "$@"
        exit 0
        ;;
esac

case "${1:-} ${2:-}" in
    "auth status")
        printf '%s\n' "github.com" "  ✓ Logged in to github.com account tester (keyring)" "  - Active account: true" \
            "  - Git operations protocol: https" "  - Token scopes: 'admin:org', 'project', 'read:org', 'repo', 'workflow'"
        exit 0
        ;;
    "api rate_limit")
        echo "4999 0"
        exit 0
        ;;
esac

declare -A vars=()
declare -a headers=()
paginate=0 jq_program="" rest_path="" include=0 method=GET input="" body=""
shift 1
while (($#)); do
    case $1 in
        graphql) rest_path=graphql ;;
        -f | -F)
            vars["${2%%=*}"]="${2#*=}"
            shift 1
            ;;
        --paginate) paginate=1 ;;
        --jq)
            jq_program="$2"
            shift 1
            ;;
        -i) include=1 ;;
        -X)
            method="$2"
            shift 1
            ;;
        --input)
            input="$2"
            shift 1
            ;;
        -H)
            headers+=("$2")
            shift 1
            ;;
        *) rest_path="$1" ;;
    esac
    shift 1
done

[[ "${input}" != - ]] || body="$(cat)"

# A GraphQL call sent with --input, as star github issue open sends createIssue (#338), is recorded with its query and its
# variables, as a call with -f records them, so that in_order and no_writes find it: its record, the last, is rewritten.
if [[ "${rest_path}" == graphql && "${input}" == - && -n "${body}" ]]; then
    last="$(tail -n 1 "${GH_CALLS}")"
    sed -i '$ d' "${GH_CALLS}"
    jq -c --arg q "query=$(jq -r '.query // ""' <<<"${body}")" --arg v "variables=$(jq -c '.variables // {}' <<<"${body}")" \
        '. + [$q, $v]' <<<"${last}" >>"${GH_CALLS}"
fi

# The rules on a repository's branch, and its head commit's workflow runs, as the case's ci set them.
ci_path='^repos/([^/]+/[^/]+)/(rules/branches/[^?]+|actions/runs\?head_sha=)'
if [[ "${rest_path}" =~ ${ci_path} ]]; then
    repo="${BASH_REMATCH[1]}" kind="${BASH_REMATCH[2]}"
    mode="$(ci_mode "${repo}")"
    if [[ "${kind}" == rules/* ]]; then
        if [[ "${mode}" == private || "${mode}" == refused ]]; then
            refusal='Upgrade to GitHub Pro or make this repository public to enable this feature.'
            jq -cn --arg m "${refusal}" '{message: $m, status: "403"}'
            printf 'gh: %s (HTTP 403)\n' "${refusal}" >&2
            exit 1
        fi
        body='[]'
        [[ "${mode}" == none ]] ||
            body='[{"type": "pull_request"}, {"type": "required_status_checks", "parameters": {"required_status_checks": [{"context": "quality-gate"}]}}]'
    else
        printf 'runs %s\n' "${repo}" >>"${GH_STATE}"
        reads="$(grep -c "^runs ${repo}$" "${GH_STATE}")"
        if [[ "${mode}" == none || "${mode}" == never ]] || ((reads < 3)); then
            body='{"workflow_runs": []}'
        elif ((reads < 5)); then
            body='{"workflow_runs": [{"id": 1, "status": "in_progress"}]}'
        else
            body='{"workflow_runs": [{"id": 1, "status": "completed"}]}'
        fi
    fi
    jq -c . <<<"${body}" | if [[ -n "${jq_program}" ]]; then jq -r "${jq_program}"; else cat; fi
    exit 0
fi

# respond prints an answer as gh does: with -i, its status line and headers first; through --jq, a success; and exits 1
# on an error, its body on standard output.
function respond {
    local status="$1" answer="$2"
    if ((include)); then
        printf 'HTTP/2.0 %s\r\nContent-Type: application/json\r\n\r\n%s' "${status}" "${answer}"
    elif [[ "${status}" == 2* && -n "${jq_program}" ]]; then
        jq -r "${jq_program}" <<<"${answer}"
    else
        printf '%s' "${answer}"
    fi
    [[ "${status}" == 2* ]] || exit 1
    exit 0
}

# A repository on the stand-in's GitHub, a bare repository under ${GH_REMOTES}: what GitHub says of it, its files raw at
# a revision, its default branch's by default, and the git data API's reads and writes, which apply commits through; and
# its variables, remembered in ${GH_REMOTES}/variables as `variable <repository> <name> <value>`. A path none of these
# answers is left to the fixtures below.
repo_path='^repos/([^/]+/[^/?]+)(/(.*))?$'
if [[ "${rest_path}" =~ ${repo_path} ]]; then
    repo="${BASH_REMATCH[1]}" part="${BASH_REMATCH[3]}" git_dir="${GH_REMOTES}/${BASH_REMATCH[1]}.git"
    not_found='{"message": "Not Found", "status": "404"}'
    export GIT_AUTHOR_NAME=stand-in GIT_AUTHOR_EMAIL=stand-in@example.com GIT_COMMITTER_NAME=stand-in GIT_COMMITTER_EMAIL=stand-in@example.com
    case "${method} ${part}" in
        "GET ")
            [[ -d "${git_dir}" ]] || respond "404 Not Found" "${not_found}"
            respond "200 OK" "$(jq -cn --arg r "${repo}" --arg m "$(ci_mode "${repo}")" \
                '{full_name: $r, default_branch: "main", private: ($m == "private")}')"
            ;;
        "GET contents/"*)
            path="${part#contents/}" ref=main
            if [[ "${path}" == *"?ref="* ]]; then
                ref="${path#*\?ref=}" path="${path%%\?*}"
            fi
            path="$(printf '%b' "${path//%/\\x}")"
            if [[ -d "${git_dir}" ]] && content="$(git --git-dir="${git_dir}" show "${ref}:${path}" 2>/dev/null && printf x)"; then
                respond "200 OK" "${content%x}"
            fi
            respond "404 Not Found" "${not_found}"
            ;;
        "GET git/ref/heads/"*)
            ref="refs/heads/${part#git/ref/heads/}"
            sha="$(git --git-dir="${git_dir}" rev-parse --verify --quiet "${ref}" 2>/dev/null)" || respond "404 Not Found" "${not_found}"
            respond "200 OK" "$(jq -cn --arg s "${sha}" --arg r "${ref}" '{ref: $r, object: {sha: $s}}')"
            ;;
        "GET git/commits/"*)
            sha="${part#git/commits/}"
            tree="$(git --git-dir="${git_dir}" rev-parse --verify --quiet "${sha}^{tree}" 2>/dev/null)" || respond "404 Not Found" "${not_found}"
            respond "200 OK" "$(jq -cn --arg s "${sha}" --arg t "${tree}" '{sha: $s, tree: {sha: $t}}')"
            ;;
        "GET git/trees/"*)
            ref="${part#git/trees/}"
            listing="$(git --git-dir="${git_dir}" ls-tree -r --name-only "${ref%%\?*}" 2>/dev/null)" || respond "404 Not Found" "${not_found}"
            respond "200 OK" "$(jq -R -s -c '{tree: [split("\n")[] | select(. != "") | {path: ., type: "blob"}]}' <<<"${listing}")"
            ;;
        "POST git/trees")
            index="${GH_REMOTES}/index-$$"
            GIT_INDEX_FILE="${index}" git --git-dir="${git_dir}" read-tree "$(jq -r .base_tree <<<"${body}")" || exit 1
            for ((entry = 0; entry < $(jq '.tree | length' <<<"${body}"); entry++)); do
                blob="$(jq -j ".tree[${entry}].content" <<<"${body}" | git --git-dir="${git_dir}" hash-object -w --stdin)" || exit 1
                GIT_INDEX_FILE="${index}" git --git-dir="${git_dir}" update-index --add \
                    --cacheinfo "100644,${blob},$(jq -r ".tree[${entry}].path" <<<"${body}")" || exit 1
            done
            tree="$(GIT_INDEX_FILE="${index}" git --git-dir="${git_dir}" write-tree)" || exit 1
            rm -f -- "${index}"
            respond "201 Created" "$(jq -cn --arg t "${tree}" '{sha: $t}')"
            ;;
        "POST git/commits")
            commit="$(git --git-dir="${git_dir}" commit-tree "$(jq -r .tree <<<"${body}")" -p "$(jq -r '.parents[0]' <<<"${body}")" \
                -m "$(jq -r .message <<<"${body}")")" || exit 1
            respond "201 Created" "$(jq -cn --arg s "${commit}" '{sha: $s}')"
            ;;
        "POST git/refs")
            ref="$(jq -r .ref <<<"${body}")"
            ! git --git-dir="${git_dir}" rev-parse --verify --quiet "${ref}" >/dev/null ||
                respond "422 Unprocessable Entity" '{"message": "Reference already exists"}'
            git --git-dir="${git_dir}" update-ref "${ref}" "$(jq -r .sha <<<"${body}")" || exit 1
            respond "201 Created" "$(jq -cn --arg r "${ref}" '{ref: $r}')"
            ;;
        "PATCH git/refs/heads/"*)
            git --git-dir="${git_dir}" update-ref "refs/heads/${part#git/refs/heads/}" "$(jq -r .sha <<<"${body}")" || exit 1
            respond "200 OK" '{}'
            ;;
        "DELETE git/refs/heads/"*)
            git --git-dir="${git_dir}" update-ref -d "refs/heads/${part#git/refs/heads/}" || exit 1
            respond "204 No Content" ''
            ;;
        "GET actions/variables/"*)
            name="${part#actions/variables/}"
            value="$(awk -v r="${repo}" -v n="${name}" '$1 == "variable" && $2 == r && $3 == n { v = $4 } END { print v }' \
                "${GH_REMOTES}/variables" 2>/dev/null)"
            [[ -n "${value}" ]] || respond "404 Not Found" "${not_found}"
            respond "200 OK" "$(jq -cn --arg n "${name}" --arg v "${value}" '{name: $n, value: $v}')"
            ;;
        "POST actions/variables" | "PATCH actions/variables/"*)
            printf 'variable %s %s %s\n' "${repo}" "$(jq -r .name <<<"${body}")" "$(jq -r .value <<<"${body}")" >>"${GH_REMOTES}/variables"
            respond "201 Created" '{}'
            ;;
    esac
fi

# world_answer answers an operation of the schedule and scenario commands from their world, through world.jq, and keeps
# what a write changes; when the world names the operation in fail_on, it fails once, after letting fail_skip calls of
# it through. What world.jq reads of a request is parsed from its GraphQL query, none for a REST call, and gh's -f and
# -F values, with a REST call's body.
#
# Parameters:
#   - `$1`: the operation: a GraphQL query's name, or, for a REST call, a name the stand-in gives it.
#   - `$2`: the repository a query or a REST path names, owner/name.
#
# Returns:
#   - it does not return: the stand-in prints the answer and exits 0, or exits 1.
function world_answer {
    local op="$1" repo="$2" world="${GH_REMOTES}/world.json" result number="" node="" slug="" member="" user="" title=""

    [[ -r "${world}" ]] || { printf 'stand-in gh: no world for %s\n' "${op}" >&2; exit 1; }
    if [[ "$(jq -r '.fail_on // ""' "${world}")" == "${op}" ]]; then
        if (($(jq '.fail_skip // 0' "${world}") > 0)); then
            jq '.fail_skip -= 1' "${world}" >"${world}.next" && mv -- "${world}.next" "${world}"
        else
            jq '.fail_on = ""' "${world}" >"${world}.next" && mv -- "${world}.next" "${world}"
            printf 'gh: %s failed, as the case asked\n' "${op}" >&2
            exit 1
        fi
    fi
    # GitHub takes a repository's name in any case, and answers in its own: the world's.
    if [[ -n "${repo}" ]]; then
        repo="$(jq -r --arg r "${repo}" '[.issues[].repo | select(ascii_downcase == ($r | ascii_downcase))][0] // $r' "${world}")"
    fi
    [[ "${query}" =~ issue\(number:[[:space:]]*([0-9]+)\) ]] && number="${BASH_REMATCH[1]}"
    [[ "${query}" =~ node\(id:[[:space:]]*\"([^\"]+)\" ]] && node="${BASH_REMATCH[1]}"
    [[ "${query}" =~ team\(slug:[[:space:]]*\"([^\"]+)\" ]] && slug="${BASH_REMATCH[1]}"
    [[ "${query}" =~ members\(query:[[:space:]]*\"([^\"]*)\" ]] && member="${BASH_REMATCH[1]}"
    [[ "${query}" =~ user\(login:[[:space:]]*\"([^\"]+)\" ]] && user="${BASH_REMATCH[1]}"
    [[ "${query}" =~ projectsV2\(first:[[:space:]]*[0-9]+,[[:space:]]*query:[[:space:]]*\"([^\"]*)\" ]] && title="${BASH_REMATCH[1]}"
    result="$(jq -c --arg op "${op}" --arg repo "${repo}" --arg number "${number}" --arg node "${node}" \
        --arg slug "${slug}" --arg member "${member}" --arg user "${user}" --arg title "${title}" --arg p "${vars[p]:-}" \
        --arg i "${vars[i]:-}" --arg c "${vars[c]:-}" --arg f "${vars[f]:-}" --arg o "${vars[o]:-}" --arg v "${vars[v]:-}" \
        --arg a "${vars[a]:-}" --arg b "${vars[b]:-}" --arg u "${vars[u]:-}" --arg s "${vars[s]:-}" --arg query "${query}" \
        --arg body "${body}" -f "${BASH_SOURCE[0]%/*}/world.jq" "${world}")" || exit 1
    # A node GitHub can't resolve, such as a deleted row read by its ID, is an error, and gh exits 1, as they do.
    if jq -e 'has("error")' <<<"${result}" >/dev/null; then
        printf 'gh: %s\n' "$(jq -r '.error' <<<"${result}")" >&2
        exit 1
    fi
    if jq -e 'has("world")' <<<"${result}" >/dev/null; then
        jq '.world' <<<"${result}" >"${world}.next" && mv -- "${world}.next" "${world}"
    fi
    # --jq prints a null result as gh does, an empty line.
    jq -c '.answer' <<<"${result}" |
        if [[ -n "${jq_program}" ]]; then jq -r -c "(${jq_program}) | if . == null then \"\" else . end"; else cat; fi
    exit 0
}

# An issue filed by a REST call, star github schedule open's and scenario open's (#509), when their world is there: it
# joins the world, as GitHub files it.
if [[ "${method}" == POST && "${rest_path}" =~ ^repos/([^/]+/[^/]+)/issues$ && -r "${GH_REMOTES}/world.json" ]]; then
    query=""
    world_answer restFileIssue "${BASH_REMATCH[1]}"
fi

# An issue's labels added and removed by REST, star github issue close's and reopen's resolution: label in a user
# account (#590, #587), when their world is there: the world's issue changes, as GitHub's would.
if [[ "${method}" == POST && "${rest_path}" =~ ^repos/([^/]+/[^/]+)/issues/([0-9]+)/labels$ && -r "${GH_REMOTES}/world.json" ]]; then
    query="issue(number: ${BASH_REMATCH[2]})"
    world_answer restAddLabels "${BASH_REMATCH[1]}"
fi
if [[ "${method}" == DELETE && "${rest_path}" =~ ^repos/([^/]+/[^/]+)/issues/([0-9]+)/labels/(.+)$ && -r "${GH_REMOTES}/world.json" ]]; then
    query="issue(number: ${BASH_REMATCH[2]}) label(\"$(printf '%b' "${BASH_REMATCH[3]//%/\\x}")\")"
    world_answer restRemoveLabel "${BASH_REMATCH[1]}"
fi

# A REST write: recorded among the calls, and answered with an ID.
if [[ "${method}" != GET && "${rest_path}" != graphql ]]; then
    jq -cn --arg p "${rest_path}" '{id: 9000, node_id: ("N_" + $p), html_url: ("https://github.com/" + $p)}' |
        if [[ -n "${jq_program}" ]]; then jq -r "${jq_program}"; else cat; fi
    exit 0
fi

if [[ "${rest_path}" != graphql ]]; then
    ((include)) || { printf 'stand-in gh: a REST call without -i: %s\n' "${rest_path}" >&2; exit 1; }
    file="$(fixture "rest/${rest_path//[?=&]/_}.json")"
    if [[ "${rest_path}" =~ ^orgs/[^/]+$ ]]; then
        printf 'HTTP/2.0 200 OK\n\n{}\n'
        exit 0
    fi
    [[ -r "${file}" ]] || { printf 'HTTP/2.0 404 Not Found\n\n{}\n'; exit 1; }
    printf 'HTTP/2.0 200 OK\nEtag: "e-%s"\n' "${rest_path//[^a-z]/}"
    # A fixture of more than one page says so as GitHub does, in a Link header naming the next (#484).
    if [[ "$(jq length "${file}")" -gt 1 ]]; then
        printf 'Link: <https://api.github.com/%s&page=2>; rel="next"\n' "${rest_path}"
    fi
    printf '\n'
    jq -c '.[0]' "${file}"
    exit 0
fi

query="${vars[query]:-}"
# A GraphQL call sent with --input, as star github issue open sends createIssue (#338): its query is in the JSON it reads.
[[ -n "${query}" || -z "${body}" ]] || query="$(jq -r '.query // ""' <<<"${body}")"
[[ "${query}" =~ (query|mutation)[[:space:]]+(star[A-Za-z]+) ]] || { printf 'stand-in gh: no operation name in %s\n' "${query}" >&2; exit 1; }
operation_kind="${BASH_REMATCH[1]}" operation="${BASH_REMATCH[2]}"
login="" owner="" name=""
[[ "${query}" =~ login:[[:space:]]*\"([^\"]+)\" ]] && login="${BASH_REMATCH[1]}"
[[ "${query}" =~ repository\(owner:[[:space:]]*\"([^\"]+)\",[[:space:]]*name:[[:space:]]*\"([^\"]+)\" ]] && owner="${BASH_REMATCH[1]}" name="${BASH_REMATCH[2]}"

# The schedule commands' GitHub (#438): the world, read and changed through world.jq.
if [[ "${operation}" == starViewer || "${operation}" == starStep* ]]; then
    world_answer "${operation}" "${owner}/${name}"
fi

case ${operation} in
    starPlanBlobs | starPlanAt)
        git_dir="${GH_REMOTES}/${owner}/${name}.git" blobs='{}' rest="${query}"
        blob='(f[0-9]+): object\(expression: "([^"]*)"\)'
        while [[ "${rest}" =~ ${blob} ]]; do
            field="${BASH_REMATCH[1]}" expression="${BASH_REMATCH[2]}"
            rest="${rest#*"${BASH_REMATCH[0]}"}"
            if text="$(git --git-dir="${git_dir}" show "${expression}" 2>/dev/null && printf x)"; then
                blobs="$(jq -c --arg f "${field}" --arg t "${text%x}" '.[$f] = {__typename: "Blob", text: $t, isTruncated: false}' <<<"${blobs}")"
            else
                blobs="$(jq -c --arg f "${field}" '.[$f] = null' <<<"${blobs}")"
            fi
        done
        jq -c '{data: {repository: .}}' <<<"${blobs}"
        exit 0
        ;;
    starPlanIssues)
        answer="$(jq -c --arg repo "${owner}/${name}" --arg q "${query}" '
            [$q | scan("i([0-9]+): issueOrPullRequest") | .[0]] as $numbers | .issues as $issues
            | {data: {repository: (reduce $numbers[] as $n ({}; .["i" + $n] = ($issues[$repo + "#" + $n]
                | if . == null then null elif .kind == "PullRequest" then {__typename: "PullRequest", url}
                  else {__typename: "Issue", id, url, body, state: (.state // "OPEN"), stateReason: (.stateReason // null),
                      timelineItems: {nodes: (if .closer then [{closer: .closer}] else [] end)},
                      issueType: (if .type then {name: .type} else null end), labels: {nodes: [(.labels // [])[] | {name: .}]},
                      issueFieldValues: {nodes: [(.fields // {}) | to_entries[] | {field: {name: .key}, name: .value}]}} end)))},
              errors: [$numbers[] | select($issues[$repo + "#" + .] == null) | {type: "NOT_FOUND", path: ["repository", ("i" + .)],
                message: ("Could not resolve to an issue or pull request with the number of " + . + ".")}]}
            | if .errors == [] then del(.errors) else . end' "${GH_REMOTES}/plan-issues.json")" || exit 1
        printf '%s\n' "${answer}"
        if jq -e 'has("errors")' <<<"${answer}" >/dev/null; then
            printf 'gh: %s\n' "$(jq -r '.errors[0].message' <<<"${answer}")" >&2
            exit 1
        fi
        exit 0
        ;;
    starPlanWrite)
        world="${GH_REMOTES}/plan-issues.json"
        jq --arg i "${vars[i]:-}" --arg b "${vars[b]:-}" \
            'if .drop_write then . else .issues |= map_values(if .id == $i then .body = $b else . end) end' "${world}" >"${world}.next" &&
            mv -- "${world}.next" "${world}"
        jq -cn --arg i "${vars[i]:-}" '{data: {updateIssue: {issue: {id: $i}}}}'
        exit 0
        ;;
    starPlanBody)
        [[ "${query}" =~ node\(id:[[:space:]]*\"([^\"]+)\" ]] || exit 1
        jq -c --arg i "${BASH_REMATCH[1]}" '{data: {node: (first(.issues[] | select(.id == $i)) | {body})}}' "${GH_REMOTES}/plan-issues.json"
        exit 0
        ;;
    starIssues)
        filter=.
        [[ "${query}" == *"states: [OPEN]"* ]] && filter='.data.repository.issues.nodes |= map(select(.state == "OPEN"))'
        answer "$(cased "${GH_FIXTURES}" "issues/${owner}/${name}.json")" "${filter}"
        ;;
    starSearchCount | starSearch)
        [[ "${vars[q]:-}" =~ repo:([^/[:space:]]+)/([^[:space:]\)]+) ]] || { printf 'stand-in gh: no repo: in %s\n' "${vars[q]:-}" >&2; exit 1; }
        answer "$(cased "${GH_FIXTURES}" "search/${BASH_REMATCH[1]}/${BASH_REMATCH[2]}.json")"
        ;;
    starOwner | starOrganizationModel | starUserModel | starProjects)
        answer "$(fixture "${operation}/${login}.json")"
        ;;
    starTriage)
        [[ "${query}" =~ query:[[:space:]]*\"Triage:[[:space:]]*([^\"]+)\" ]] || { printf 'stand-in gh: no Triage title in %s\n' "${query}" >&2; exit 1; }
        answer "$(cased "${GH_FIXTURES}" "starTriage/${login}/${BASH_REMATCH[1]}.json")"
        ;;
    starTriageItems)
        [[ "${query}" =~ node\(id:[[:space:]]*\"([^\"]+)\" ]] || exit 1
        answer "${GH_FIXTURES}/starTriageItems/${BASH_REMATCH[1]}.json"
        ;;
    starAddToTriage)
        [[ "${query}" =~ projectId:[[:space:]]*\"([^\"]+)\",[[:space:]]*contentId:[[:space:]]*\"([^\"]+)\" ]] || exit 1
        printf 'PVTI_new_%s %s\n' "${BASH_REMATCH[2]}" "${BASH_REMATCH[1]}" >>"${GH_STATE}"
        jq -cn --arg id "PVTI_new_${BASH_REMATCH[2]}" '{data: {addProjectV2ItemById: {item: {id: $id}}}}' |
            if [[ -n "${jq_program}" ]]; then jq -r -c "${jq_program}"; else cat; fi
        ;;
    starSetStatus)
        jq -cn '{data: {updateProjectV2ItemFieldValue: {projectV2Item: {id: "set"}}}}'
        ;;
    starComment)
        jq -cn --arg s "${vars[s]:-}" '{data: {addComment: {commentEdge: {node: {id: ("IC_" + $s)}}}}}' |
            if [[ -n "${jq_program}" ]]; then jq -r -c "${jq_program}"; else cat; fi
        ;;
    starProject)
        # A project apply has just made or copied: GitHub's own fields, Status with its three options, and View 1. The
        # IDs of a project made begin N and those of a copy C, so that a case can tell whose part a write names.
        prefix=N
        [[ "${query}" == *NEW_starCopyProject* ]] && prefix=C
        jq -cn --arg p "${prefix}" 'def names($list): {nodes: [$list[] | {name: .}]};
            {data: {node: {id: "NEW", number: 99, title: "new", template: false, closed: false, shortDescription: "", readme: "",
            public: false, teams: {nodes: []}, repositories: {nodes: []}, fields: {nodes: [
                {id: ($p + "F_title"), name: "Title", dataType: "TITLE"},
                {id: ($p + "F_assignees"), name: "Assignees", dataType: "ASSIGNEES"},
                {id: ($p + "F_status"), name: "Status", dataType: "SINGLE_SELECT", options: [
                    {id: ($p + "O_todo"), name: "Todo", color: "GRAY", description: ""},
                    {id: ($p + "O_progress"), name: "In Progress", color: "YELLOW", description: ""},
                    {id: ($p + "O_done"), name: "Done", color: "PURPLE", description: ""}]},
                {id: ($p + "F_labels"), name: "Labels", dataType: "LABELS"},
                {id: ($p + "F_prs"), name: "Linked pull requests", dataType: "LINKED_PULL_REQUESTS"},
                {id: ($p + "F_subissues"), name: "Sub-issues progress", dataType: "SUB_ISSUES_PROGRESS"}]},
            views: {nodes: [{id: ($p + "V_1"), name: "View 1", number: 1, layout: "TABLE_LAYOUT", filter: "",
                fields: names(["Title", "Assignees", "Status"]), groupByFields: names([]), verticalGroupByFields: names([]),
                sortByFields: {nodes: []}}]}}}}' |
            if [[ -n "${jq_program}" ]]; then jq -r -c "${jq_program}"; else cat; fi
        ;;
    starWorkflows)
        # The built-in workflows GitHub gives a project made or copied: two stand for them all, their IDs begun alike.
        prefix=N
        [[ "${query}" == *NEW_starCopyProject* ]] && prefix=C
        jq -cn --arg p "${prefix}" '{data: {node: {workflows: {nodes: [{id: ($p + "W_closed"), name: "Item closed"},
            {id: ($p + "W_merged"), name: "Pull request merged"}]}}}}' |
            if [[ -n "${jq_program}" ]]; then jq -r -c "${jq_program}"; else cat; fi
        ;;
    starIterations)
        # An Iteration field's iterations, completed ones among them, as the projects' fixture holds them, the data
        # directory's own first.
        [[ "${query}" =~ node\(id:[[:space:]]*\"([^\"]+)\" ]] || exit 1
        field_id="${BASH_REMATCH[1]}" configuration=null
        for file in "${XDG_DATA_HOME}"/fixtures/starProjects/*.json "${GH_FIXTURES}"/starProjects/*.json; do
            [[ -r "${file}" && "${configuration}" == null ]] || continue
            configuration="$(jq -c --arg id "${field_id}" \
                'first(.[] | .. | objects | select(.id? == $id and has("configuration")) | .configuration) // null' "${file}")"
        done
        jq -cn --argjson c "${configuration}" '{data: {node: {configuration: $c}}}' |
            if [[ -n "${jq_program}" ]]; then jq -r -c "${jq_program}"; else cat; fi
        ;;
    starCount)
        jq -cn '{data: {search: {issueCount: 3}}}' | if [[ -n "${jq_program}" ]]; then jq -r -c "${jq_program}"; else cat; fi
        ;;
    starItem)
        [[ "${query}" =~ node\(id:[[:space:]]*\"([^\"]+)\" ]] || exit 1
        project="$(awk -v id="${BASH_REMATCH[1]}" '$1 == id { print $2 }' "${GH_STATE}")"
        jq -cn --arg p "${project}" '{data: {node: {project: {id: $p}, status: {name: "Open"}}}}' |
            if [[ -n "${jq_program}" ]]; then jq -r -c "${jq_program}"; else cat; fi
        ;;
    *)
        # A mutation the cases need no particular answer from: a new ID, number and URL, for the caller to read. One
        # that selects what GitHub's schema lacks is refused, as GitHub refuses it: a view's deletion answers the view,
        # and no deletedViewId (GitHub's GraphQL schema, DeleteProjectV2ViewPayload, read 2026-11-11). So is one that
        # writes an iteration's duration, an Int in that schema, as a decimal, which a number read from GitHub's JSON
        # becomes when it is decoded.
        if [[ "${operation_kind}" == mutation ]]; then
            if [[ "${query}" == *deletedViewId* ]]; then
                printf '%s\n' "{\"errors\": [{\"message\": \"Field 'deletedViewId' doesn't exist on type 'DeleteProjectV2ViewPayload'\"}]}"
                printf '%s\n' "gh: Field 'deletedViewId' doesn't exist on type 'DeleteProjectV2ViewPayload'" >&2
                exit 1
            fi
            if [[ "${query}" =~ duration:[[:space:]]*([0-9]+\.[0-9]+) ]]; then
                printf '%s\n' "{\"errors\": [{\"message\": \"Argument 'duration' has an invalid value (${BASH_REMATCH[1]}). Expected type 'Int!'.\"}]}"
                printf '%s\n' "gh: Argument 'duration' has an invalid value (${BASH_REMATCH[1]}). Expected type 'Int!'." >&2
                exit 1
            fi
            jq -cn --arg op "${operation}" '{data: {r: {node: {id: ("NEW_" + $op), number: 99,
                url: ("https://github.com/orgs/new/projects/99")}}}}' |
                if [[ -n "${jq_program}" ]]; then jq -r -c "${jq_program}"; else cat; fi
            exit 0
        fi
        printf 'stand-in gh: no answer for %s\n' "${operation}" >&2
        exit 1
        ;;
esac
GH
    chmod +x "${run_directory}/bin/gh"
}

# write_fixtures writes what the stand-in answers: each repository's issues, the searches, the accounts' records as
# the model's pull reads them, and the Triage projects with their rows.
#
# The issues, by what each case reads of them:
#
#   NobleFactor/alpha, engprod's: #1 an epic; #2 a feature under it, labeled good first issue; #3 a task under #2 at
#   step 2 of schedule s1, blocked by #4 at step 3; #4 a task at step 3, blocked by #6, closed; #5 a bug with no
#   Area, no evidence and Severity N/A, on no project; #6 a closed task; #7 a feature on Backlog: engprod and on
#   Schedule: engprod, already a row of Triage: engprod; #8 an open task with a Resolution; #9 a task on Scenario:
#   engprod with no Area and no evidence; #10 a task with Severity High; #11 a task at step 5 of s1, blocked by
#   NobleFactor/beta#1, on no schedule.
#   NobleFactor/beta, devlore's: #1 a task under NobleFactor/alpha#2.
#   test-user/personal: #1 an epic; #2 a task under it with two area: labels; #3 a bug with area:product.
#   NobleFactor/many: 250 issues over three pages, every fifth closed.
#
# Returns:
#   - 0, with the fixtures under fixtures/.
function write_fixtures {
    local fixtures="${run_directory}/fixtures" library

    mkdir -p -- "${fixtures}"/{issues/NobleFactor,issues/test-user,search/NobleFactor,rest/orgs/NobleFactor,rest/repos/NobleFactor/noblefactor-engprod}
    mkdir -p -- "${fixtures}"/{rest/repos/NobleFactor/alpha,rest/repos/NobleFactor/beta,rest/orgs/Acme,rest/repos/Acme/site}
    mkdir -p -- "${fixtures}"/{rest/repos/Acme/app,rest/repos/Acme/docs}
    mkdir -p -- "${fixtures}"/{starOwner,starOrganizationModel,starUserModel,starProjects,starTriageItems}
    mkdir -p -- "${fixtures}"/starTriage/{NobleFactor,test-user}

    # The jq that builds an issue node as GraphQL returns it, from the few things a fixture says of it.
    library='
        def evidence: "## Evidence of completion\n\nShown.";
        def node($repo; $n; $spec): {
            id: ("I_" + ($repo | gsub("/"; "_")) + "_" + ($n | tostring)), number: $n, title: ($spec.title // "Issue \($n)"),
            url: "https://github.com/\($repo)/issues/\($n)", state: ($spec.state // "OPEN"),
            stateReason: (if ($spec.state // "OPEN") == "CLOSED" then "COMPLETED" else null end),
            createdAt: "2026-11-01T00:00:00Z", updatedAt: "2026-11-02T00:00:00Z",
            closedAt: (if ($spec.state // "OPEN") == "CLOSED" then "2026-11-03T00:00:00Z" else null end),
            body: ($spec.body // evidence), repository: {nameWithOwner: $repo},
            issueType: (if $spec.type then {name: $spec.type} else null end),
            labels: {nodes: [($spec.labels // [])[] | {name: .}]}, assignees: {nodes: []},
            blockedBy: {nodes: [($spec.blocked // [])[] | {number: .[1], state: .[2], repository: {nameWithOwner: .[0]}}]},
            subIssuesSummary: {total: 0, completed: 0},
            issueFieldValues: {nodes: [($spec.fields // {}) | to_entries[] | {field: {name: .key}, name: .value}]},
            projectItems: {nodes: [($spec.rows // [])[] | {id: ("PVTI_" + .[0]), project: {id: .[0], number: .[1], title: .[2]},
                fieldValues: {nodes: ([{field: {name: "Title", dataType: "TITLE"}, text: "t"}] +
                    [.[3] | to_entries[] | if (.value | type) == "number" then {field: {name: .key, dataType: "NUMBER"}, number: .value}
                        else {field: {name: .key, dataType: "SINGLE_SELECT"}, name: .value} end])}}]},
            parent: $spec.parent
        };
        def parent($repo; $n; $type; $grand): {number: $n, repository: {nameWithOwner: $repo},
            issueType: (if $type then {name: $type} else null end), labels: {nodes: []}, parent: $grand};
        def uparent($repo; $n; $label; $grand): {number: $n, repository: {nameWithOwner: $repo}, issueType: null,
            labels: {nodes: [{name: $label}]}, parent: $grand};
        def page($nodes; $next): {data: {repository: {issues: {pageInfo: {hasNextPage: $next, endCursor: "c"}, nodes: $nodes}}}};
        def search($count; $nodes): {data: {search: {issueCount: $count, pageInfo: {hasNextPage: false, endCursor: null}, nodes: $nodes}}};
        def schedule($n; $step): ["PVT_schedule", 26, "Schedule: engprod", {Schedule: "s1", Step: $step, Status: "Open"}];
    '

    jq -n "${library}"'
        def epic: parent("NobleFactor/alpha"; 1; "Epic"; null);
        def feature: parent("NobleFactor/alpha"; 2; "Feature"; epic);
        [page([
            node("NobleFactor/alpha"; 1; {type: "Epic", fields: {Area: "Engineering", Severity: "N/A"}}),
            node("NobleFactor/alpha"; 2; {type: "Feature", parent: epic, labels: ["good first issue"], fields: {Area: "Engineering", Severity: "N/A"}}),
            node("NobleFactor/alpha"; 3; {type: "Task", parent: feature, fields: {Area: "Product", Severity: "N/A"},
                rows: [schedule(3; 2)], blocked: [["NobleFactor/alpha", 4, "OPEN"]]}),
            node("NobleFactor/alpha"; 4; {type: "Task", parent: feature, fields: {Area: "Product", Severity: "N/A"},
                rows: [schedule(4; 3)], blocked: [["NobleFactor/alpha", 6, "CLOSED"]]}),
            node("NobleFactor/alpha"; 5; {type: "Bug", fields: {Severity: "N/A"}, body: "A bug."}),
            node("NobleFactor/alpha"; 6; {type: "Task", parent: feature, state: "CLOSED", fields: {Area: "Product", Severity: "N/A"},
                rows: [schedule(6; 1)]}),
            node("NobleFactor/alpha"; 7; {type: "Feature", parent: epic, fields: {Area: "Product", Severity: "N/A"},
                rows: [["PVT_backlog", 24, "Backlog: engprod", {Status: "Open"}], schedule(7; 4),
                    ["PVT_triage_engprod", 5, "Triage: engprod", {Status: "Open"}]]}),
            node("NobleFactor/alpha"; 8; {type: "Task", parent: feature, fields: {Area: "Product", Severity: "N/A", Resolution: "Declined"}}),
            node("NobleFactor/alpha"; 9; {type: "Task", parent: feature, fields: {Severity: "N/A"}, body: "Found while walking.",
                rows: [["PVT_scenario", 8, "Scenario: engprod", {Scenario: "walk", Beat: 1}]]}),
            node("NobleFactor/alpha"; 10; {type: "Task", parent: feature, fields: {Area: "Product", Severity: "High"}}),
            node("NobleFactor/alpha"; 11; {type: "Task", parent: feature, fields: {Area: "Product", Severity: "N/A"},
                rows: [schedule(11; 5)], blocked: [["NobleFactor/beta", 1, "OPEN"]]}),
            node("NobleFactor/alpha"; 12; {type: "Task", parent: feature, fields: {Area: "Product", Severity: "N/A"},
                rows: [["PVT_schedule", 26, "Schedule: engprod", {Schedule: "s1", Status: "Open"}]]}),
            node("NobleFactor/alpha"; 13; {type: "Schedule", title: "Schedule: s1", fields: {Area: "Engineering", Severity: "N/A"},
                rows: [["PVT_schedule", 26, "Schedule: engprod", {Schedule: "s1", Status: "Open"}]]})
        ]; false)]' >"${fixtures}/issues/NobleFactor/alpha.json"

    jq -n "${library}"'
        [page([node("NobleFactor/beta"; 1; {type: "Task", fields: {Area: "Engineering", Severity: "N/A"},
            parent: parent("NobleFactor/alpha"; 2; "Feature"; parent("NobleFactor/alpha"; 1; "Epic"; null))})]; false)]
    ' >"${fixtures}/issues/NobleFactor/beta.json"

    jq -n "${library}"'
        [page([
            node("test-user/personal"; 1; {labels: ["epic", "area:engineering", "severity:n/a"]}),
            node("test-user/personal"; 2; {labels: ["task", "area:product", "area:engineering", "severity:n/a"],
                parent: uparent("test-user/personal"; 1; "epic"; null)}),
            node("test-user/personal"; 3; {labels: ["bug", "area:product", "severity:high"]}),
            node("test-user/personal"; 4; {labels: ["task", "bug", "area:product", "severity:n/a"]})
        ]; false)]' >"${fixtures}/issues/test-user/personal.json"

    jq -n "${library}"'
        [range(0; 3) as $p | page([range($p * 100 + 1; [($p + 1) * 100, 250] | min + 1) as $n |
            node("NobleFactor/many"; $n; {type: "Task", state: (if $n % 5 == 0 then "CLOSED" else "OPEN" end),
                fields: {Area: "Product", Severity: "N/A"}})]; $p < 2)]
    ' >"${fixtures}/issues/NobleFactor/many.json"

    jq -n "${library}"'[search(1; [node("NobleFactor/alpha"; 5; {type: "Bug", fields: {Severity: "N/A"}})])]' \
        >"${fixtures}/search/NobleFactor/alpha.json"
    jq -n "${library}"'[search(1001; [])]' >"${fixtures}/search/NobleFactor/huge.json"

    # The records the model's pull and every command's read-first make.
    jq -n '[{data: {repositoryOwner: {__typename: "Organization", login: "NobleFactor", id: "O_NobleFactor"}}}]' >"${fixtures}/starOwner/NobleFactor.json"
    jq -n '[{data: {repositoryOwner: {__typename: "User", login: "test-user", id: "U_test_user"}}}]' >"${fixtures}/starOwner/test-user.json"
    jq -n '[[
        {id: 1, name: "Epic", description: "Level 0: the root", color: "purple", is_enabled: true},
        {id: 2, name: "Feature", description: "Level 1: a capability", color: "blue", is_enabled: true},
        {id: 3, name: "Bug", description: "Level 2: unplanned work", color: "red", is_enabled: true},
        {id: 4, name: "Task", description: "Level 2: planned work", color: "yellow", is_enabled: true},
        {id: 5, name: "Schedule", description: "Collection: a schedule", color: "green", is_enabled: true},
        {id: 6, name: "Scenario", description: "Collection: a scenario", color: "orange", is_enabled: true}
    ]]' >"${fixtures}/rest/orgs/NobleFactor/issue-types.json"
    jq -n '[[]]' >"${fixtures}/rest/repos/NobleFactor/noblefactor-engprod/labels_per_page_100.json"
    # The labels of each repository a team maintains: alpha, engprod's, and beta, devlore's (#437).
    jq -n '[[{id: 101, node_id: "LA_alpha_gfi", name: "good first issue", color: "7057ff", description: "Good for newcomers"}]]' \
        >"${fixtures}/rest/repos/NobleFactor/alpha/labels_per_page_100.json"
    jq -n '[[{id: 201, node_id: "LA_beta_gfi", name: "good first issue", color: "7057ff", description: "Good for newcomers"}]]' \
        >"${fixtures}/rest/repos/NobleFactor/beta/labels_per_page_100.json"
    # Acme, an organization new to the model: GitHub's three issue types; three teams, web, b and c, each maintaining a
    # repository, site, app and docs; GitHub's default labels on each; no issue fields and no projects (#437).
    jq -n '[{data: {repositoryOwner: {__typename: "Organization", login: "Acme", id: "O_Acme"}}}]' >"${fixtures}/starOwner/Acme.json"
    jq -n '[[
        {id: 11, name: "Task", description: "A specific piece of work", color: "yellow", is_enabled: true},
        {id: 12, name: "Bug", description: "An unexpected problem or behavior", color: "red", is_enabled: true},
        {id: 13, name: "Feature", description: "A request, idea, or new functionality", color: "blue", is_enabled: true}
    ]]' >"${fixtures}/rest/orgs/Acme/issue-types.json"
    jq -n 'def team($slug; $repo): {name: $slug, slug: $slug, id: "T_\($slug)", description: "", privacy: "VISIBLE",
            notificationSetting: "NOTIFICATIONS_ENABLED", parentTeam: null,
            repositories: {edges: [{permission: "MAINTAIN", node: {nameWithOwner: $repo}}]}};
        [{data: {organization: {issueFields: {nodes: []}, issueTypes: {nodes: []},
            teams: {nodes: [team("web"; "Acme/site"), team("b"; "Acme/app"), team("c"; "Acme/docs")]}}}}]' \
        >"${fixtures}/starOrganizationModel/Acme.json"
    jq -n '[[{id: 301, node_id: "LA_site_bug", name: "bug", color: "d73a4a", description: "Something is not working"},
        {id: 302, node_id: "LA_site_gfi", name: "good first issue", color: "7057ff", description: "Good for newcomers"}]]' \
        >"${fixtures}/rest/repos/Acme/site/labels_per_page_100.json"
    for repo in app docs; do
        jq -n --arg r "${repo}" '[[{id: 401, node_id: "LA_\($r)_bug", name: "bug", color: "d73a4a", description: "Something is not working"},
            {id: 402, node_id: "LA_\($r)_gfi", name: "good first issue", color: "7057ff", description: "Good for newcomers"}]]' \
            >"${fixtures}/rest/repos/Acme/${repo}/labels_per_page_100.json"
    done
    jq -n '[{data: {organization: {projectsV2: {nodes: []}}}}]' >"${fixtures}/starProjects/Acme.json"
    jq -n '[{data: {organization: {
        issueFields: {nodes: [
            {__typename: "IssueFieldSingleSelect", name: "Area", dataType: "SINGLE_SELECT", id: "IF_area", fullDatabaseId: "71",
                description: "Product or engineering work", visibility: "ALL",
                options: [{id: "o_product", databaseId: 711, name: "Product", color: "BLUE", description: "", priority: 1},
                    {id: "o_engineering", databaseId: 712, name: "Engineering", color: "GREEN", description: "", priority: 2}]},
            {__typename: "IssueFieldSingleSelect", name: "Severity", dataType: "SINGLE_SELECT", id: "IF_severity",
                fullDatabaseId: "72", description: "How much harm a bug does", visibility: "ORG_ONLY",
                options: [{id: "o_critical", databaseId: 721, name: "Critical", color: "RED", description: "Stops the work", priority: 1},
                    {id: "o_high", databaseId: 722, name: "High", color: "ORANGE", description: "", priority: 2},
                    {id: "o_medium", databaseId: 723, name: "Medium", color: "YELLOW", description: "", priority: 3},
                    {id: "o_low", databaseId: 724, name: "Low", color: "GREEN", description: "", priority: 4},
                    {id: "o_na", databaseId: 725, name: "N/A", color: "GRAY", description: "Not a bug", priority: 5}]},
            {__typename: "IssueFieldSingleSelect", name: "Resolution", dataType: "SINGLE_SELECT", id: "IF_resolution",
                options: [{id: "o_declined", name: "Declined"}, {id: "o_duplicate", name: "Duplicate"}, {id: "o_invalid", name: "Invalid"}]},
            {__typename: "IssueFieldDate", name: "Target date", dataType: "DATE", id: "IF_target"}]},
        issueTypes: {nodes: [{name: "Bug", pinnedFields: [{name: "Severity"}, {name: "Area"}]},
            {name: "Task", pinnedFields: [{name: "Area"}]}, {name: "Epic", pinnedFields: []}]},
        teams: {nodes: [
            {name: "engprod", slug: "engprod", id: "T_engprod", description: "Engineering productivity", privacy: "VISIBLE",
                notificationSetting: "NOTIFICATIONS_ENABLED", parentTeam: null,
