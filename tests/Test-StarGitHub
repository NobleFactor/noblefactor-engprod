    test("/model\\.yaml") and test("\\+  - name: \"Schedule\"\n\\+    id: 5\n\\+    color: \"green\"")
    and test("\\+fields:") and test("\"Severity\"") and test("\"N/A\"") and test("\\+teams:") and test("slug: \"devlore\"")
    and test("\"NobleFactor/beta\"")' "" text

# 1b. pull --account for a user account reads its types from its type labels, in its issue-model repositories only.
