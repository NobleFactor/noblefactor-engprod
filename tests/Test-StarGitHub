                    item("NobleFactor/alpha"; 21; step("s1"; 1; "Closed")), item("NobleFactor/alpha"; 22; step("s1"; 2; "Open")),
                    item("NobleFactor/alpha"; 23; step("s1"; 3; "Closed")), item("NobleFactor/alpha"; 24; step("s1"; 4; "Open")),
