expect "11.1: backup opens a pull request on doc/model-<date> and merges it" ok '
    ([$calls[] | select(.[0:2] == ["pr", "create"]) | .[index("--head") + 1]] | length == 1
        and (.[0] | test("^doc/model-[0-9]{4}-[0-9]{2}-[0-9]{2}$")))
