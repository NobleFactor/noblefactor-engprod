jq -n "${plan_library}${headings}"'{
    "NobleFactor/alpha#1": {body: "Problem.\n\n## Plan And Design Documents\n\n| Kind | Document |\n| --- | --- |\n| Plan | Not yet opened |\n"},
    "NobleFactor/alpha#2": {body: "### plan and design documents\n\n| Kind | Document |\n| --- | --- |\n| Plan | Not yet opened |\n"},
    "NobleFactor/alpha#3": {body: setext}}' | plan_world
run_star "${data_plan}" github plan link --all --repository NobleFactor/alpha
expect "85 (heading case): a heading in other capitals is the section; a setext heading of its words is not" ok "${plan_library}"'
    map({issue, action, dropped}) == [{issue: "NobleFactor/alpha#1", action: "written", dropped: [placeholder]},
        {issue: "NobleFactor/alpha#2", action: "written", dropped: [placeholder]},
        {issue: "NobleFactor/alpha#3", action: "appended", dropped: []}]'
check "85 (heading case): each body holds one section, at its heading's level, the setext heading kept above #3's" plan_holds "${headings}"'
    body("NobleFactor/alpha#1") == "Problem.\n\n" + section([alpha("docs/plans/feature/1-first.md")]) + "\n"
    and body("NobleFactor/alpha#2") == table("###"; [alpha("docs/plans/feature/2-second.md")]; "\n") + "\n"
    and body("NobleFactor/alpha#3") == setext + "\n" + section([alpha("docs/plans/fix/3-third.md")]) + "\n"'
run_star "${data_plan}" github plan link --all --repository NobleFactor/alpha
expect "85 (heading case): run again, all three are unchanged" ok 'map(.action) == ["unchanged", "unchanged", "unchanged"]'

((failures == 0)) || error $EX_SOFTWARE "${failures} of the ${case_count} cases failed"
success "every case passed"
