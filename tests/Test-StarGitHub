                title("PVT_triage_engprod")]; [missing_area]),
            project("PVT_template_old"; 7; "Old"; true; true; []; []),
            project("PVT_schedule_engprod"; 12; "Schedule: engprod"; false; false; [status("PVT_schedule_engprod"),
                schedule("PVT_schedule_engprod"; ["s1", "s2"]), title("PVT_schedule_engprod")]; []),
            project("PVT_template_triage"; 23; "Triage"; true; false; [status("PVT_template_triage"),
                title("PVT_template_triage")]; [missing_area, board]),
            project("PVT_template_schedule"; 24; "Schedule"; true; false; [status("PVT_template_schedule"),
                schedule("PVT_template_schedule"; ["placeholder"]), title("PVT_template_schedule")]; [])]}}}}]' \
        >"${fixtures}/starProjects/NobleFactor.json"
    jq -n 'def project($id; $n; $title): {id: $id, number: $n, title: $title, template: false, closed: false,
            fields: {nodes: []}, views: {nodes: []}};
        [{data: {user: {projectsV2: {nodes: [project("PVT_copy_triage"; 4; "Triage"), project("PVT_copy_backlog"; 5; "Backlog"),
            project("PVT_triage_user"; 9; "Triage: test-user"), project("PVT_notes"; 10; "Notes")]}}}}]' \
        >"${fixtures}/starProjects/test-user.json"

    # The Triage projects and their rows: Triage: engprod holds NobleFactor/alpha#7 and one closed issue.
    local status_field='{id: "F_status", name: "Status", options: [{id: "o_open", name: "Open"}, {id: "o_closed", name: "Closed"}]}'
    jq -n "[{data: {organization: {projectsV2: {nodes: [{id: \"PVT_triage_engprod\", number: 5, title: \"Triage: engprod\",
        fields: {nodes: [${status_field}]}}]}}}}]" >"${fixtures}/starTriage/NobleFactor/engprod.json"
    jq -n "[{data: {organization: {projectsV2: {nodes: [{id: \"PVT_triage_devlore\", number: 6, title: \"Triage: devlore\",
        fields: {nodes: [${status_field}]}}]}}}}]" >"${fixtures}/starTriage/NobleFactor/devlore.json"
    jq -n "[{data: {user: {projectsV2: {nodes: [{id: \"PVT_triage_user\", number: 9, title: \"Triage: test-user\",
        fields: {nodes: [${status_field}]}}]}}}}]" >"${fixtures}/starTriage/test-user/test-user.json"
    jq -n 'def content($n; $state; $type): {number: $n, title: "Issue \($n)", url: "https://github.com/NobleFactor/alpha/issues/\($n)",
            state: $state, issueType: {name: $type}, labels: {nodes: []}, repository: {nameWithOwner: "NobleFactor/alpha"}};
        [{data: {node: {items: {pageInfo: {hasNextPage: false, endCursor: null}, nodes: [
        {id: "PVTI_PVT_triage_engprod", content: content(7; "OPEN"; "Feature"), status: {name: "Open"}},
        {id: "PVTI_closed", content: content(6; "CLOSED"; "Task"), status: {name: "Closed"}}]}}}}]' \
        >"${fixtures}/starTriageItems/PVT_triage_engprod.json"
    jq -n '[{data: {node: {items: {pageInfo: {hasNextPage: false, endCursor: null}, nodes: []}}}}]' \
        >"${fixtures}/starTriageItems/PVT_triage_devlore.json"
    jq -n '[{data: {node: {items: {pageInfo: {hasNextPage: false, endCursor: null}, nodes: []}}}}]' \
        >"${fixtures}/starTriageItems/PVT_triage_user.json"
}

