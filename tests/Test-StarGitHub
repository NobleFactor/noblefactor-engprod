# cased names a file under a fixtures directory as given, or, since GitHub's logins ignore case, the file whose path
# matches it in another case (#485); as given when neither is there.
function cased {
    local root="$1" relative="$2" found=""
    if [[ -e "${root}/${relative}" ]]; then
        printf '%s' "${root}/${relative}"
        return 0
    fi
    [[ -d "${root}" ]] && found="$(find "${root}" -ipath "${root}/${relative}" -print -quit 2>/dev/null)"
    printf '%s' "${found:-${root}/${relative}}"
}

# fixture names a fixture: the data directory's own, which a case may give it, before the run's.
function fixture {
    local own
    own="$(cased "${XDG_DATA_HOME}/fixtures" "$1")"
    if [[ -r "${own}" ]]; then printf '%s' "${own}"; else cased "${GH_FIXTURES}" "$1"; fi
