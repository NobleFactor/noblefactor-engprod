# 11. backup writes the model get returns into the account's .github repository through a pull request on
# chore/model-<date>, merged, with nothing asked, its comments recording the checks and the merge (#426). It merges
# only once every workflow run on the head commit has finished and every check main requires has passed; a run that
# never starts, or a check that fails, stops it unmerged, and running it again reuses the pull request it left open. A
# backup that is current opens none; an account with no .github repository is given one, which requires no check.
remote NobleFactor "old: true"
ci NobleFactor pass
run_star "${data}" github model backup NobleFactor
expect "11.1: backup opens a pull request on chore/model-<date> and merges it" ok '
    ([$calls[] | select(.[0:2] == ["pr", "create"]) | .[index("--head") + 1]] | length == 1
        and (.[0] | test("^chore/model-[0-9]{4}-[0-9]{2}-[0-9]{2}$")))
    and ([$calls[] | select(.[0:2] == ["pr", "merge"])] | length == 1)'
expect "11.1: the pull request's comments record the checks and the merge" ok '
    [$calls[] | select(.[0:2] == ["pr", "comment"]) | .[index("--body") + 1]]
    | length == 2 and (.[0] | test("^Checks passed")) and (.[1] | test("^Merged") and test("reads back as the model"))'
expect "11.1: backup waits for the head commit's workflow run to start and to finish, then merges" ok '
    ($calls | map((.[1] // "") | test("/actions/runs\\?head_sha=")) | indices(true)) as $runs
    | ($calls | map(.[0:2] == ["pr", "merge"]) | index(true)) as $merge
    | ($runs | length) == 5 and $runs[-1] < $merge and any($calls[]; .[0] == "sleep")'
run_star "${data}" github model get NobleFactor --output yaml
get_yaml="${output}"
check "11.1: NobleFactor/.github's main holds the model get returns" main_holds_model NobleFactor
check "11.1: the clone is left in the home's Workspace" test -d "${run_directory}/home/Workspace/NobleFactor/.github/.git"
run_star "${data}" github model backup NobleFactor
expect "11.2: a backup that is current opens no pull request" ok '([$calls[] | select(.[0] == "pr")] | length) == 0'
run_star "${data}" github model backup test-user
expect "11.3: backup creates the account's .github repository when it is missing" ok \
