declare -r entry='def entry($k): first(.[] | select(.issue == $k and (.action == "added" or .action == "in-triage")));
    def absent($k): [.[] | select(.issue == $k and .faults != [])] | length == 0;'
declare -r faulted='def faulted($k; $rule): [entry($k).faults[].rule] | index($rule) != null;'

# 1. The model GitHub holds: a type with neither a level nor a Collection: description stops the command that reads it,
# named; a collection type loads.
