    def pull($n; $oid): {__typename: "PullRequest", number: $n, mergedAt: "2026-11-15T00:00:00Z", mergeCommit: {oid: $oid},
        repository: {nameWithOwner: "NobleFactor/alpha"}};
    def closed($closer): {state: "CLOSED", stateReason: "COMPLETED", closer: $closer};
'
