            issue("NobleFactor/alpha"; 20; "Schedule"; "Schedule: s1"; {body: body("s1"; "- 2026-11-01, on the owner'"'"'s word: step 4 was added, Task NobleFactor/alpha#24.\n")})
            + issue("NobleFactor/alpha"; 21; "Task"; "the first step"; {state: "CLOSED"})
            + issue("NobleFactor/alpha"; 22; "Task"; "the second step"; {})
            + issue("NobleFactor/alpha"; 23; "Bug"; "the third step"; {state: "CLOSED"})
            + issue("NobleFactor/alpha"; 24; "Task"; "the fourth step"; {priority: "High"})
            + issue("NobleFactor/alpha"; 25; "Task"; "a task from the backlog"; {})
            + issue("NobleFactor/alpha"; 26; "Bug"; "a bug from triage"; {body: ("### What happened\n\nIt broke.\n\n"
                + "### Plan and design documents\n\n| Kind | Document |\n| --- | --- |\n| Plan | Not yet opened |\n")})
            + issue("NobleFactor/alpha"; 27; "Task"; "a task found walking"; {body: "Found while walking #40\n"})
            + issue("NobleFactor/alpha"; 28; "Epic"; "an epic"; {})
