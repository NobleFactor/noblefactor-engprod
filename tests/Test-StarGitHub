expect "33: a token file others can read is refused, and nothing written" error "${writes}"'(writes | length) == 0' 'others can read' text
chmod 600 "${run_directory}/work/token"
run_star "${data}" github model apply "${reference}/user.yaml" test-user --token file:token
expect "33: a token file only its owner can read replaces the secret already set" ok '
    any(.[]; .kind == "secret" and .path == "test-user/personal/ADD_TO_PROJECT_PAT" and .action == "changed")'
check "33: the secret is the file's token" grep -qxF "secret test-user/personal ADD_TO_PROJECT_PAT token-from-file" "${run_directory}/remotes/secrets"
run_star "${data}" github model apply "${reference}/user.yaml" test-user --token file:no-such-token
expect "33: a token file that is not there is refused, and nothing written" error "${writes}"'(writes | length) == 0' 'no-such-token' text

# 34. No token's value is taken on the command line, nor a source but env: and file:.
for token in ghp_0123456789abcdefghijABCDEFGHIJ012345 vault:kv-acme/site; do
