make_extension "${run_directory}/data-431"
cp -- "${run_directory}/models/model.chore.yaml" "${run_directory}/data-431/devlore/star/extensions/${extension_name}/model.yaml"
cache_home="${run_directory}/cache-431"
declare -r model_copy="${cache_home}/devlore/star/gh/model/NobleFactor.model.yaml"
declare -r model_read='[$calls[] | select(index("repos/NobleFactor/.github/contents/model.yaml") != null)]'

run_star "${run_directory}/data-431" github schedule report NobleFactor/alpha
expect "9.1: a first read takes NobleFactor's model from NobleFactor/.github, raw, with no ETag to send" ok '
    length == 11 and ('"${model_read}"' | length == 1
        and (.[0] | index("Accept: application/vnd.github.raw+json") != null)
        and (.[0] | map(select(type == "string" and startswith("If-None-Match"))) | length == 0))
    and ([$calls[] | select(index("repos/test-user/.github/contents/model.yaml") != null)] | length == 0)'
check "9.1: GitHub answered 200, and star kept a copy of the model it read" \
    grep --quiet --line-regexp 'contents NobleFactor 200' "${run_directory}/state"
check "9.1: the copy is NobleFactor/.github's model.yaml" \
    cmp -s "${run_directory}/data-431/remote/NobleFactor/.github/model.yaml" "${model_copy}"

run_star "${run_directory}/data-431" github schedule report NobleFactor/alpha
expect "9.2: a second read sends the copy's ETag" ok '
    length == 11 and ('"${model_read}"' | length == 1
        and (.[0] | map(select(type == "string" and startswith("If-None-Match: \""))) | length == 1))'
check "9.2: GitHub answered 304, and the model came from the copy" \
    grep --quiet --line-regexp 'contents NobleFactor 304' "${run_directory}/state"

touch -- "${run_directory}/data-431/unreachable"
quiet=""
run_star "${run_directory}/data-431" github schedule report NobleFactor/alpha
quiet="--silent"
expect "9.3: with GitHub out of reach, the model comes from the copy, and star says so" ok 'length == 11' \
    'NobleFactor/\.github.*copy'

cache_home="${run_directory}/cache-431-none"
quiet=""
run_star "${run_directory}/data-431" github schedule report NobleFactor/alpha
quiet="--silent"
expect "9.4: with GitHub out of reach and no copy, star fails, naming NobleFactor/.github" error "" 'NobleFactor/\.github'
rm -f -- "${run_directory}/data-431/unreachable"

# NobleFactor/.github without a model.yaml fails, though a copy is kept: the file was taken away, not left behind.
make_extension "${run_directory}/data-431-gone" none
cache_home="${run_directory}/cache-431"
quiet=""
run_star "${run_directory}/data-431-gone" github schedule report NobleFactor/alpha
quiet="--silent"
expect "9.4: NobleFactor/.github without model.yaml fails, naming it, though a copy is kept" error "" \
    'NobleFactor/\.github.*model\.yaml'

quiet=""
run_star "${run_directory}/data-431" github model pull --account NobleFactor
expect "9.5: pull without --asset refuses for an account whose model is in its .github repository, naming the file" \
    error "" '(--asset.*NobleFactor/\.github|NobleFactor/\.github.*--asset)'
run_star "${run_directory}/data-431" github model digest --check
expect "9.5: digest without --asset refuses the same way" error "" '(--asset.*NobleFactor/\.github|NobleFactor/\.github.*--asset)'
quiet="--silent"

run_star "${run_directory}/data-431" github schedule report test-user/personal
expect "9.6: test-user's model is still read from beside the extension" ok '
    length > 0 and all(.[]; .issue | startswith("test-user/personal#"))
    and ([$calls[] | select(index("repos/test-user/.github/contents/model.yaml") != null)] | length == 0)'
cache_home="${run_directory}/cache"

# 10. Each account star works with, the default account and the owner of each writ layer repository, has its model
# read from its .github repository (#441). test-user, the owner of a layer here, is read from GitHub and kept; a model
# beside the extension for it as well is refused as a second; an account that owns no layer is still read from beside
# the extension; and pull refuses without --asset for a layer's owner.
declare -r data_441="${run_directory}/data-441"
make_extension "${data_441}"
add_layer "${data_441}" base NobleFactor/alpha
add_layer "${data_441}" personal test-user/personal
mkdir -p -- "${data_441}/remote/test-user/.github"
mv -- "${data_441}/devlore/star/extensions/${extension_name}/model.test-user.yaml" "${data_441}/remote/test-user/.github/model.yaml"
cache_home="${run_directory}/cache-441"

run_star "${data_441}" github schedule report test-user/personal
expect "10.1: a layer's owner has its model read from its .github repository" ok '
    length > 0 and all(.[]; .issue | startswith("test-user/personal#"))
    and ([$calls[] | select(index("repos/test-user/.github/contents/model.yaml") != null)] | length == 1)'
check "10.1: star keeps a copy of test-user's model" \
    cmp -s "${data_441}/remote/test-user/.github/model.yaml" "${cache_home}/devlore/star/gh/model/test-user.model.yaml"

cp -- "${data_441}/remote/test-user/.github/model.yaml" "${data_441}/devlore/star/extensions/${extension_name}/model.test-user.yaml"
quiet=""
run_star "${data_441}" github schedule report test-user/personal
quiet="--silent"
expect "10.2: a model beside the extension for a layer's owner is refused as a second, both named" error "" \
    'model\.test-user\.yaml.*test-user/\.github/model\.yaml'
rm -f -- "${data_441}/devlore/star/extensions/${extension_name}/model.test-user.yaml"

make_extension "${run_directory}/data-441-outside"
add_layer "${run_directory}/data-441-outside" base NobleFactor/alpha
run_star "${run_directory}/data-441-outside" github schedule report test-user/personal
expect "10.3: an account that owns no layer is still read from beside the extension" ok '
    length > 0 and all(.[]; .issue | startswith("test-user/personal#"))
    and ([$calls[] | select(index("repos/test-user/.github/contents/model.yaml") != null)] | length == 0)'

quiet=""
run_star "${data_441}" github model pull --account test-user
quiet="--silent"
expect "10.4: pull without --asset refuses for a layer's owner, naming the file" error "" \
    '(--asset.*test-user/\.github|test-user/\.github.*--asset)'
cache_home="${run_directory}/cache"

((failures == 0)) || error $EX_SOFTWARE "${failures} of the ${case_count} cases failed"
success "every case passed"
