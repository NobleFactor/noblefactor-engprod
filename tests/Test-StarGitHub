run_star "${data}" github schedule report NobleFactor/alpha
expect "1: a model with collection types loads, and the report runs" ok 'type == "array" and length == 13'

# 1a. get returns an organization's model as GitHub holds it: its types with their levels, the collection types without
# one, its fields, its teams with the repositories each maintains, and its open templates with their fields and views,
# not the projects made from them (#426).
run_star "${data}" github model get NobleFactor
expect "1a: get NobleFactor returns its types, fields, teams and projects" ok '
    .account == "NobleFactor" and .version == 1 and (has("pulled") | not)
    and ([.types[] | select(.level != null) | "\(.name):\(.level)"] | sort) == ["Bug:2", "Epic:0", "Feature:1", "Task:2"]
    and ([.types[] | select(.level == null) | .name] | sort) == ["Scenario", "Schedule"]
    and ([.fields[].name] | sort) == ["Area", "Resolution", "Severity", "Target date"]
    and ([.teams[] | {slug, repositories}] | sort_by(.slug))
        == [{slug: "devlore", repositories: ["NobleFactor/beta"]}, {slug: "engprod", repositories: ["NobleFactor/alpha"]},
            {slug: "owners", repositories: []}]
    and [.projects[] | {name, template}] == [{name: "Triage", template: true}, {name: "Schedule", template: true}]
    and [.projects[0].fields[] | {name, type}] == [{name: "Status", type: "single-select"}]'
expect "1a: get reads each template's views: layout, filter, and the fields each shows, groups and sorts by" ok '
    .projects[0].views == [
        {name: "Missing Area", number: 2, layout: "table", filter: "-has:area", fields: ["Title", "Status"], group_by: [],
         vertical_group_by: [], sort_by: [{field: "Title", direction: "desc"}]},
        {name: "Board", number: 3, layout: "board", filter: "", fields: ["Title"], group_by: [], vertical_group_by: ["Status"],
         sort_by: []}]'

