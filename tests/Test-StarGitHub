            {name: "DevLore", slug: "devlore", id: "T_devlore",
                repositories: {edges: [{permission: "MAINTAIN", node: {nameWithOwner: "NobleFactor/beta"}}]}},
            {name: "Owners", slug: "owners", id: "T_owners", repositories: {edges: []}}]}}}}]' \
        >"${fixtures}/starOrganizationModel/NobleFactor.json"
    jq -n '[{data: {user: {repositories: {nodes: [
        {nameWithOwner: "test-user/personal", repositoryTopics: {nodes: [{topic: {name: "issue-model"}}]}, labels: {nodes: [
            {id: "LA_epic", name: "epic", color: "7057ff", description: "Level 0: the root"},
            {id: "LA_feature", name: "feature", color: "0e8a16", description: "Level 1: a capability"},
            {id: "LA_bug", name: "bug", color: "d73a4a", description: "Level 2: unplanned work"},
            {id: "LA_task", name: "task", color: "1d76db", description: "Level 2: planned work"},
            {id: "LA_schedule", name: "schedule", color: "cccccc", description: "Collection: a schedule"},
            {id: "LA_scenario", name: "scenario", color: "cccccc", description: "Collection: a scenario"},
            {id: "LA_area_product", name: "area:product", color: "1d76db", description: "Area"},
