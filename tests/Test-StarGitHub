            + issue("NobleFactor/beta"; 50; "Schedule"; "Schedule: d1"; {body: body("d1"; "")})
            + issue("NobleFactor/beta"; 51; "Task"; "d1 first"; {})
            + issue("NobleFactor/beta"; 52; "Task"; "d1 second"; {})
            + issue("NobleFactor/beta"; 53; "Task"; "a devlore task"; {})
