# Test-StarGitHub - Tests the com.noblefactor.ops.GitHub star extension against a stand-in gh: the report's records and
# selection (#379) and the triage sweep (#436), as docs/plans/feature/436-triage-sweep.md's test plan lists them; and
# each account's model read from GitHub when a command needs it, star github model get and backup, and the sweep's
# two-types rule (#426), as docs/plans/feature/426-model-pull-to-dot-github.md's test plan lists them

[[ -r "$(dirname "$0")/../Home/common/.local/bin/Declare-BashScript" ]] || {
    printf '%s: cannot find Declare-BashScript in %s\n' "${0##*/}" "$(dirname "$0")/../Home/common/.local/bin" >&2
    exit 72 # EX_OSFILE
}

# The helper sources Set-Environment from ${XDG_DATA_HOME:-$HOME/.local/share}/shell/functions. This checkout's is the
# file under review, so the test points XDG_DATA_HOME at it while the helper loads; each star the test runs gets an
# XDG_DATA_HOME of its own, holding a copy of this checkout's extension.
XDG_DATA_HOME="$(cd "$(dirname "$0")/../Home/common/.local/share" && pwd)" || exit 72 # EX_OSFILE
export XDG_DATA_HOME

# shellcheck source=Declare-BashScript
source "$(dirname "$0")/../Home/common/.local/bin/Declare-BashScript" "$0" "help" "h" "$@"
require_command git jq mktemp star

declare -r extension_name=com.noblefactor.ops.GitHub
extension_source="${XDG_DATA_HOME}/devlore/star/extensions/${extension_name}"
declare -r extension_source

###########
# Functions
###########

# cleanup removes the run's directory, which holds every case's extension, fixtures and calls, however the run ends;
# with TEST_STAR_GITHUB_KEEP set, it keeps the directory and names it, for a failing case's calls to be read.
#
# Returns:
#   - 0, the run's directory gone, or kept and named.
function cleanup {
    if [[ -n "${run_directory:-}" && -d "${run_directory}" ]]; then
        if [[ -n "${TEST_STAR_GITHUB_KEEP:-}" ]]; then
            printf 'kept: %s\n' "${run_directory}" >&2
            return 0
        fi
        rm -rf -- "${run_directory}"
    fi
}

# make_extension lays out an extension directory as writ deploys one: this checkout's manifest, commands and reference
# models, linked, and no model file: an account's model is what GitHub holds, which the stand-in serves (#426).
#
# Parameters:
#   - `$1`: the data directory to make, which star is given as XDG_DATA_HOME.
#
# Returns:
#   - 0, with `$1`/devlore/star/extensions/com.noblefactor.ops.GitHub laid out.
function make_extension {
    local directory="$1/devlore/star/extensions/${extension_name}"

    mkdir -p -- "${directory}"
    ln -s -- "${extension_source}/extension.yaml" "${directory}/extension.yaml"
    ln -s -- "${extension_source}/commands" "${directory}/commands"
    ln -s -- "${extension_source}/reference" "${directory}/reference"
}

# override gives one data directory's GitHub a piece of its own: the stand-in answers `$1`/fixtures/`$2` before the
# run's fixture of the same path, so that a case may change what GitHub holds.
#
# Parameters:
#   - `$1`: the data directory make_extension made.
#   - `$2`: the fixture's path under fixtures, as the stand-in looks it up.
#   - standard input: the fixture.
#
# Returns:
#   - 0, the fixture written.
function override {
    mkdir -p -- "$(dirname "$1/fixtures/$2")"
    cat >"$1/fixtures/$2"
}

# remote makes an account's .github repository on the stand-in's GitHub: a bare repository under
# ${run_directory}/remotes whose main holds a README and, when given, model.yaml. Whatever an earlier one of the same
# name left goes with it: its pull requests, its CI's setting, and the clone a backup left in the run's home.
#
# Parameters:
#   - `$1`: the account.
#   - `$2`: model.yaml's content; optional, none by default.
#
# Returns:
#   - 0, the repository made.
function remote {
    local bare="${run_directory}/remotes/$1/.github.git" seed="${run_directory}/seed-$1" pulls="${run_directory}/remotes/pulls"

    rm -rf -- "${bare}" "${seed}" "${run_directory}/remotes/$1/.github.ci" "${run_directory}/home/Workspace/$1/.github"
    if [[ -f "${pulls}" ]]; then
        grep -v "^pr $1/.github " "${pulls}" >"${pulls}.kept" || true
        mv -- "${pulls}.kept" "${pulls}"
    fi
    git init --quiet --bare --initial-branch=main "${bare}"
    git init --quiet --initial-branch=main "${seed}"
    printf '# .github\n' >"${seed}/README.md"
    [[ -z "${2:-}" ]] || printf '%s\n' "$2" >"${seed}/model.yaml"
    HOME="${run_directory}/home" git -C "${seed}" add --all
    HOME="${run_directory}/home" git -C "${seed}" commit --quiet -m "seed"
    git -C "${seed}" push --quiet "${bare}" main
    rm -rf -- "${seed}"
}

# main_holds_model succeeds when an account's .github repository's main holds, as model.yaml, what get returns for it
# as YAML, in `get_yaml`.
#
# Parameters:
#   - `$1`: the account.
#
# Returns:
#   - 0 when they match; 1 otherwise.
function main_holds_model {
    [[ -n "${get_yaml}" && "$(git --git-dir="${run_directory}/remotes/$1/.github.git" show main:model.yaml 2>/dev/null)" == "${get_yaml}" ]]
}

# ci sets how the CI of an account's .github repository behaves on the stand-in's GitHub. With none, the default, main
# requires no check and no workflow runs. With pass or fail, main requires quality-gate, and the head commit's workflow
# run appears on the third read of its runs, is in progress on the fourth, and has finished on the fifth, its check
# passing or failing. With never, main requires quality-gate and no run starts.
#
# Parameters:
#   - `$1`: the account.
#   - `$2`: none, pass, fail or never.
#
# Returns:
#   - 0, the setting written.
function ci {
    printf '%s\n' "$2" >"${run_directory}/remotes/$1/.github.ci"
}

# repository makes a repository on the stand-in's GitHub, a bare repository under ${run_directory}/remotes whose main
# holds a README and the files given; one made before goes first, with the clone of it left in the run's home.
#
# Parameters:
#   - `$1`: the repository, owner/name.
#   - `${@:2}`: the files, each path=content.
#
# Returns:
#   - 0, the repository made.
function repository {
    local name="$1" bare="${run_directory}/remotes/$1.git" seed="${run_directory}/seed-${1//\//-}" file
    shift 1

    rm -rf -- "${bare}" "${seed}" "${run_directory}/home/Workspace/${name}"
    git init --quiet --bare --initial-branch=main "${bare}"
    git init --quiet --initial-branch=main "${seed}"
    printf '# %s\n' "${name#*/}" >"${seed}/README.md"
    for file in "$@"; do
        mkdir -p -- "$(dirname "${seed}/${file%%=*}")"
        printf '%s\n' "${file#*=}" >"${seed}/${file%%=*}"
    done
    HOME="${run_directory}/home" git -C "${seed}" add --all
    HOME="${run_directory}/home" git -C "${seed}" commit --quiet -m "seed"
    git -C "${seed}" push --quiet "${bare}" main
    rm -rf -- "${seed}"
}

# commit_model commits a model.yaml to an account's .github repository's main on the stand-in's GitHub, and prints the
# commit.
#
# Parameters:
#   - `$1`: the account.
#   - `$2`: model.yaml's content.
#
# Returns:
#   - 0, the commit made.
function commit_model {
    local bare="${run_directory}/remotes/$1/.github.git" seed="${run_directory}/seed-commit-$1"

    rm -rf -- "${seed}"
    git clone --quiet "${bare}" "${seed}"
    printf '%s\n' "$2" >"${seed}/model.yaml"
    HOME="${run_directory}/home" git -C "${seed}" add model.yaml
    HOME="${run_directory}/home" git -C "${seed}" commit --quiet -m "a backup"
    git -C "${seed}" push --quiet origin main
    git -C "${seed}" rev-parse HEAD
    rm -rf -- "${seed}"
}

# shows succeeds when a repository's main on the stand-in's GitHub holds a file with the content given.
#
# Parameters:
#   - `$1`: the repository, owner/name.
#   - `$2`: the file's path.
#   - `$3`: its content.
#
# Returns:
#   - 0 when it does; 1 otherwise.
function shows {
    [[ "$(git --git-dir="${run_directory}/remotes/$1.git" show "main:$2" 2>/dev/null)" == "$3" ]]
}

# lacks succeeds when a repository's main on the stand-in's GitHub holds no file at the path given.
#
# Parameters:
#   - `$1`: the repository, owner/name.
#   - `$2`: the file's path.
#
# Returns:
#   - 0 when it does not; 1 when it does.
function lacks {
    ! git --git-dir="${run_directory}/remotes/$1.git" cat-file -e "main:$2" 2>/dev/null
}

# same_text succeeds when two texts are the same and not empty.
#
# Parameters:
#   - `$1`, `$2`: the texts.
#
# Returns:
#   - 0 when they match; 1 otherwise.
function same_text {
    [[ -n "$1" && "$1" == "$2" ]]
}

# no_model_cached succeeds when star's cache holds no copy of a model.
#
# Returns:
#   - 0 when none is there; 1 otherwise.
function no_model_cached {
    [[ -z "$(find "${cache_home}" -name '*model*' 2>/dev/null)" ]]
}

# run_star runs one star command against a case's extension and the stand-in gh, outside any git tree, so that no
# project-local extension or configuration reaches it.
#
# Sets `output`, `errors` and `status`, and empties the calls the stand-in recorded before it runs. star runs with
# --silent unless `quiet` is set empty: an extension that fails to load says why only in star's narration. Its cache is
# `cache_home`; its home is the run's own, so that a clone goes under its Workspace and a commit names its identity.
#
# Parameters:
#   - `$1`: the data directory make_extension made.
#   - `${@:2}`: star's arguments.
#
# Returns:
#   - 0.
function run_star {
    local data="$1"
    shift 1

    : >"${run_directory}/calls.jsonl"
    : >"${run_directory}/state"
    status=0
    output="$(
        cd "${run_directory}/work" &&
            HOME="${run_directory}/home" PATH="${run_directory}/bin:${PATH}" XDG_DATA_HOME="${data}" \
                XDG_CACHE_HOME="${cache_home}" XDG_CONFIG_HOME="${run_directory}/config" \
                XDG_STATE_HOME="${run_directory}/state-home" GH_FIXTURES="${run_directory}/fixtures" \
                GH_REMOTES="${run_directory}/remotes" GH_CALLS="${run_directory}/calls.jsonl" GH_STATE="${run_directory}/state" \
                star "$@" ${quiet} 2>"${run_directory}/errors"
    )" || status=$?
    errors="$(<"${run_directory}/errors")"
}

# expect checks the last run_star: its status, and a jq program over its output that must print true.
#
# Parameters:
#   - `$1`: the case's name.
#   - `$2`: `ok` for a zero status, `error` for any other, `any` for either.
#   - `$3`: a jq program run over the output, which must print true; empty to check nothing. It sees the calls the
#     stand-in recorded as `$calls`, an array of argument arrays.
#   - `$4`: an extended regular expression a line of the errors must match; optional, empty to check nothing.
#   - `$5`: `json`, the default, when the output is JSON; `text` to give the program the output as one string.
#
# Returns:
#   - 0, the case counted as passed or failed.
function expect {
    local name="$1" want="$2" program="$3" pattern="${4:-}" input="${5:-json}" problem="" verdict
    local -a read_as=()

    case_count=$((case_count + 1))
    if [[ "${want}" == ok && ${status} -ne 0 ]]; then
        problem+="its status was ${status}, not 0; "
    elif [[ "${want}" == error && ${status} -eq 0 ]]; then
        problem+="its status was 0, not an error; "
    fi
    [[ "${input}" == json ]] || read_as=(--raw-input --slurp)
    if [[ -n "${program}" ]]; then
        verdict="$(jq "${read_as[@]}" --raw-output --slurpfile calls "${run_directory}/calls.jsonl" "${program}" \
            <<<"${output}" 2>&1)" || true
        [[ "${verdict}" == true ]] || problem+="the output does not satisfy ${program} (${verdict}); "
    fi
    if [[ -n "${pattern}" ]] && ! grep --quiet --extended-regexp --regexp="${pattern}" <<<"${errors}"; then
        problem+="no line of the errors matches '${pattern}'; "
    fi

    if [[ -z "${problem}" ]]; then
        success "${name}"
        return 0
    fi
    error 0 "${name}: ${problem%; }:"
    printf '    output: %s\n' "${output:0:2000}" >&2
    printf '    errors: %s\n' "${errors:0:2000}" >&2
    failures=$((failures + 1))
}

# check counts a case decided by a command rather than by star's output: a file the run left, or what the stand-in
# answered, as ${run_directory}/state records it.
#
# Parameters:
#   - `$1`: the case's name.
#   - `${@:2}`: the command, which must succeed.
#
# Returns:
#   - 0, the case counted as passed or failed.
function check {
    local name="$1"
    shift 1

    case_count=$((case_count + 1))
    if "$@"; then
        success "${name}"
        return 0
    fi
    error 0 "${name}: this did not hold: $*"
    printf '    errors: %s\n' "${errors:0:2000}" >&2
    failures=$((failures + 1))
}

# write_stand_in writes the stand-in for gh to the run's bin directory.
#
# It records each call as a JSON array of its arguments, one per line of ${GH_CALLS}, and answers from ${GH_FIXTURES}:
# a GraphQL request by the operation name the extension gives it, a REST request by its path. Every fixture file is a
# JSON array of responses, one per page; --paginate answers every page and a request without it the first, and --jq
# is applied to each, as gh does. An addition to a project is remembered in ${GH_STATE}, so that reading the row back
# finds it.
#
# A fixture may be the data directory's own, under ${XDG_DATA_HOME}/fixtures, which a case gives it with override; it
# is answered before the run's. An account's .github repository is a bare repository under ${GH_REMOTES}, which `repo
# view`, `repo create` and `repo clone` answer from, and a pull request opened on it is merged by moving its main to the
# pull request's branch: the git side of `star github model backup` (#426). Its pull requests are remembered in
# ${GH_REMOTES}/pulls, across runs, so that a backup run again finds the one an earlier run left open; its main's rules,
# its head commit's workflow runs and its checks are as the case's ci set them.
#
# The stand-in for sleep records how long it was asked to wait, among gh's calls, and returns at once.
#
# A write, a REST call with -X or a GraphQL mutation, is recorded among the calls and answered with a new ID; a secret
# set is remembered, value and all, a newline written as \n, in ${GH_REMOTES}/secrets, on a repository or an
# organization, so that a case can read back the token it was given.
#
# Any repository under ${GH_REMOTES} answers what apply reads and writes of it (#437): GitHub's record of it, its files
# raw at a revision, the git data API apply commits through, a ref, a commit, a tree, and its variables, remembered in
# ${GH_REMOTES}/variables. A body sent with --input - is read from standard input.
#
# Returns:
#   - 0, the stand-ins written and executable.
function write_stand_in {
    mkdir -p -- "${run_directory}/bin"
    cat >"${run_directory}/bin/sleep" <<'SLEEP'
#!/usr/bin/env bash
printf '%s\0' sleep "$@" | jq -c -R -s 'split("\u0000") | .[:-1]' >>"${GH_CALLS}"
SLEEP
    chmod +x "${run_directory}/bin/sleep"
    cat >"${run_directory}/bin/gh" <<'GH'
#!/usr/bin/env bash
set -uo pipefail

# Each argument NUL-terminated, so that jq reads them as data: given them as --args, it parses gh's own options.
printf '%s\0' "$@" | jq -c -R -s 'split("\u0000") | .[:-1]' >>"${GH_CALLS}"

# answer prints a fixture's responses, every page with --paginate, through --jq when it was given.
function answer {
    local file="$1" filter="${2:-.}" count index
    [[ -r "${file}" ]] || { printf 'stand-in gh: no fixture %s\n' "${file}" >&2; exit 1; }
    count="$(jq 'length' "${file}")"
    ((paginate)) || count=1
    for ((index = 0; index < count; index++)); do
        jq -c ".[${index}] | ${filter}" "${file}" | if [[ -n "${jq_program}" ]]; then jq -r -c "${jq_program}"; else cat; fi
    done
}

# fixture names a fixture: the data directory's own, which a case may give it, before the run's.
function fixture {
    if [[ -r "${XDG_DATA_HOME}/fixtures/$1" ]]; then printf '%s' "${XDG_DATA_HOME}/fixtures/$1"; else printf '%s' "${GH_FIXTURES}/$1"; fi
}

# ci_mode prints how a repository's CI behaves, as the case's ci set it: none, pass, fail or never.
function ci_mode {
    cat "${GH_REMOTES}/$1.ci" 2>/dev/null || echo none
}

# filtered prints standard input through --jq, when the arguments give it, as gh does.
function filtered {
    local program
    program="$(option --jq "$@")"
    if [[ -n "${program}" ]]; then jq -r "${program}"; else cat; fi
}

# option prints the value that follows a flag among the arguments, or nothing.
function option {
    local flag="$1"
    shift 1
    while (($#)); do
        [[ "$1" == "${flag}" ]] && { printf '%s' "${2:-}"; return 0; }
        shift 1
    done
}

# An account's .github repository is a bare repository under ${GH_REMOTES}; each pull request is remembered in
# ${GH_REMOTES}/pulls as `pr <repository> <number> <branch> <open|merged>`, and merging one moves main to its branch.
pulls="${GH_REMOTES}/pulls"
case "${1:-} ${2:-}" in
    "repo view" | "repo create" | "repo clone")
        target="${3:-}"
        if [[ "$2" == view && (-z "${target}" || "${target}" == -*) ]]; then
            echo "NobleFactor/alpha"
            exit 0
        fi
        bare="${GH_REMOTES}/${target}.git"
        case $2 in
            view)
                [[ -d "${bare}" ]] || { printf 'GraphQL: Could not resolve to a Repository with the name %s. (repository)\n' "${target}" >&2; exit 1; }
                printf '%s\n' "${target##*/}"
                ;;
            create)
                seed="${GH_REMOTES}/seed-${target//\//-}"
                mkdir -p -- "$(dirname "${bare}")"
                git init --quiet --bare --initial-branch=main "${bare}" && git init --quiet --initial-branch=main "${seed}" &&
                    printf '# .github\n' >"${seed}/README.md" && git -C "${seed}" add --all &&
                    git -C "${seed}" commit --quiet -m "Initial commit" && git -C "${seed}" push --quiet "${bare}" main &&
                    rm -rf -- "${seed}" || exit 1
                printf 'https://github.com/%s\n' "${target}"
                ;;
            clone)
                [[ -d "${bare}" ]] || { printf 'stand-in gh: no repository %s\n' "${target}" >&2; exit 1; }
                git clone --quiet "${bare}" "${4:-${target##*/}}" || exit 1
                ;;
        esac
        exit 0
        ;;
    "pr create")
        repo="$(option --repo "$@")" head="$(option --head "$@")"
        number=$(($(awk '$1 == "pr" && $5 == "open"' "${pulls}" 2>/dev/null | wc -l) + 1))
        printf 'pr %s %s %s open\n' "${repo}" "${number}" "${head}" >>"${pulls}"
        printf 'https://github.com/%s/pull/%s\n' "${repo}" "${number}"
        exit 0
        ;;
    "pr list")
        repo="$(option --repo "$@")" head="$(option --head "$@")"
        awk -v r="${repo}" -v h="${head}" '$1 == "pr" && $2 == r && $4 == h { state[$3] = $5 }
            END { for (n in state) if (state[n] == "open") print n }' "${pulls}" 2>/dev/null |
            jq -R -s -c --arg r "${repo}" '[split("\n")[] | select(. != "") | {number: tonumber, url: ("https://github.com/" + $r + "/pull/" + .)}]' |
            filtered "$@"
        exit 0
        ;;
    "pr checks")
        repo="$(option --repo "$@")"
        case "$(ci_mode "${repo}")" in
            pass) bucket=pass ;;
            fail) bucket=fail ;;
            *)
                printf "no checks reported on the 'chore' branch\n" >&2
                exit 1
                ;;
        esac
        jq -cn --arg b "${bucket}" '[{name: "quality-gate", bucket: $b}]' | filtered "$@"
        exit 0
        ;;
    "pr comment" | "pr edit")
        exit 0
        ;;
    "secret set")
        repo="$(option --repo "$@")" org="$(option --org "$@")" value="$(cat)"
        printf 'secret %s %s %s\n' "${repo:-${org}}" "$3" "${value//$'\n'/\\n}" >>"${GH_REMOTES}/secrets"
        exit 0
        ;;
    "secret list")
        repo="$(option --repo "$@")" org="$(option --org "$@")"
        awk -v r="${repo:-${org}}" '$1 == "secret" && $2 == r { print $3 }' "${GH_REMOTES}/secrets" 2>/dev/null |
            jq -R -s -c '[split("\n")[] | select(. != "") | {name: ., visibility: "all"}] | unique' | filtered "$@"
        exit 0
        ;;
    "pr merge")
        repo="$(option --repo "$@")" number="${3:-}"
        head="$(awk -v r="${repo}" -v n="${number}" '$1 == "pr" && $2 == r && $3 == n { print $4; exit }' "${pulls}")"
        [[ -n "${head}" ]] || { printf 'stand-in gh: no pull request %s in %s\n' "${number}" "${repo}" >&2; exit 1; }
        git --git-dir="${GH_REMOTES}/${repo}.git" update-ref refs/heads/main "refs/heads/${head}" || exit 1
        printf 'pr %s %s %s merged\n' "${repo}" "${number}" "${head}" >>"${pulls}"
        exit 0
        ;;
    "pr view")
        repo="$(option --repo "$@")" number="${3:-}" state=OPEN
        grep -q "^pr ${repo} ${number} .* merged$" "${pulls}" 2>/dev/null && state=MERGED
        jq -cn --arg s "${state}" --arg u "https://github.com/${repo}/pull/${number}" '{state: $s, url: $u}' | filtered "$@"
        exit 0
        ;;
esac

case "${1:-} ${2:-}" in
    "auth status")
        printf '%s\n' "github.com" "  ✓ Logged in to github.com account tester (keyring)" "  - Active account: true" \
            "  - Git operations protocol: https" "  - Token scopes: 'admin:org', 'project', 'read:org', 'repo', 'workflow'"
        exit 0
        ;;
    "api rate_limit")
        echo "4999 0"
        exit 0
        ;;
esac

declare -A vars=()
declare -a headers=()
paginate=0 jq_program="" rest_path="" include=0 method=GET input="" body=""
shift 1
while (($#)); do
    case $1 in
        graphql) rest_path=graphql ;;
        -f | -F)
            vars["${2%%=*}"]="${2#*=}"
            shift 1
            ;;
        --paginate) paginate=1 ;;
        --jq)
            jq_program="$2"
            shift 1
            ;;
        -i) include=1 ;;
        -X)
            method="$2"
            shift 1
            ;;
        --input)
            input="$2"
            shift 1
            ;;
        -H)
            headers+=("$2")
            shift 1
            ;;
        *) rest_path="$1" ;;
    esac
    shift 1
done

[[ "${input}" != - ]] || body="$(cat)"

# The rules on a repository's branch, and its head commit's workflow runs, as the case's ci set them.
ci_path='^repos/([^/]+/[^/]+)/(rules/branches/[^?]+|actions/runs\?head_sha=)'
if [[ "${rest_path}" =~ ${ci_path} ]]; then
    repo="${BASH_REMATCH[1]}" kind="${BASH_REMATCH[2]}"
    mode="$(ci_mode "${repo}")"
    if [[ "${kind}" == rules/* ]]; then
        body='[]'
        [[ "${mode}" == none ]] ||
            body='[{"type": "pull_request"}, {"type": "required_status_checks", "parameters": {"required_status_checks": [{"context": "quality-gate"}]}}]'
    else
        printf 'runs %s\n' "${repo}" >>"${GH_STATE}"
        reads="$(grep -c "^runs ${repo}$" "${GH_STATE}")"
        if [[ "${mode}" == none || "${mode}" == never ]] || ((reads < 3)); then
            body='{"workflow_runs": []}'
        elif ((reads < 5)); then
            body='{"workflow_runs": [{"id": 1, "status": "in_progress"}]}'
        else
            body='{"workflow_runs": [{"id": 1, "status": "completed"}]}'
        fi
    fi
    jq -c . <<<"${body}" | if [[ -n "${jq_program}" ]]; then jq -r "${jq_program}"; else cat; fi
    exit 0
fi

# respond prints an answer as gh does: with -i, its status line and headers first; through --jq, a success; and exits 1
# on an error, its body on standard output.
function respond {
    local status="$1" answer="$2"
    if ((include)); then
        printf 'HTTP/2.0 %s\r\nContent-Type: application/json\r\n\r\n%s' "${status}" "${answer}"
    elif [[ "${status}" == 2* && -n "${jq_program}" ]]; then
        jq -r "${jq_program}" <<<"${answer}"
    else
        printf '%s' "${answer}"
    fi
    [[ "${status}" == 2* ]] || exit 1
    exit 0
}

# A repository on the stand-in's GitHub, a bare repository under ${GH_REMOTES}: what GitHub says of it, its files raw at
# a revision, its default branch's by default, and the git data API's reads and writes, which apply commits through; and
# its variables, remembered in ${GH_REMOTES}/variables as `variable <repository> <name> <value>`. A path none of these
# answers is left to the fixtures below.
repo_path='^repos/([^/]+/[^/?]+)(/(.*))?$'
if [[ "${rest_path}" =~ ${repo_path} ]]; then
    repo="${BASH_REMATCH[1]}" part="${BASH_REMATCH[3]}" git_dir="${GH_REMOTES}/${BASH_REMATCH[1]}.git"
    not_found='{"message": "Not Found", "status": "404"}'
    export GIT_AUTHOR_NAME=stand-in GIT_AUTHOR_EMAIL=stand-in@example.com GIT_COMMITTER_NAME=stand-in GIT_COMMITTER_EMAIL=stand-in@example.com
    case "${method} ${part}" in
        "GET ")
            [[ -d "${git_dir}" ]] || respond "404 Not Found" "${not_found}"
            respond "200 OK" "$(jq -cn --arg r "${repo}" '{full_name: $r, default_branch: "main"}')"
            ;;
        "GET contents/"*)
            path="${part#contents/}" ref=main
            if [[ "${path}" == *"?ref="* ]]; then
                ref="${path#*\?ref=}" path="${path%%\?*}"
            fi
            path="$(printf '%b' "${path//%/\\x}")"
            if [[ -d "${git_dir}" ]] && content="$(git --git-dir="${git_dir}" show "${ref}:${path}" 2>/dev/null && printf x)"; then
                respond "200 OK" "${content%x}"
            fi
            respond "404 Not Found" "${not_found}"
            ;;
        "GET git/ref/heads/"*)
            ref="refs/heads/${part#git/ref/heads/}"
            sha="$(git --git-dir="${git_dir}" rev-parse --verify --quiet "${ref}" 2>/dev/null)" || respond "404 Not Found" "${not_found}"
            respond "200 OK" "$(jq -cn --arg s "${sha}" --arg r "${ref}" '{ref: $r, object: {sha: $s}}')"
            ;;
        "GET git/commits/"*)
            sha="${part#git/commits/}"
            tree="$(git --git-dir="${git_dir}" rev-parse --verify --quiet "${sha}^{tree}" 2>/dev/null)" || respond "404 Not Found" "${not_found}"
            respond "200 OK" "$(jq -cn --arg s "${sha}" --arg t "${tree}" '{sha: $s, tree: {sha: $t}}')"
            ;;
        "GET git/trees/"*)
            ref="${part#git/trees/}"
            listing="$(git --git-dir="${git_dir}" ls-tree -r --name-only "${ref%%\?*}" 2>/dev/null)" || respond "404 Not Found" "${not_found}"
            respond "200 OK" "$(jq -R -s -c '{tree: [split("\n")[] | select(. != "") | {path: ., type: "blob"}]}' <<<"${listing}")"
            ;;
        "POST git/trees")
            index="${GH_REMOTES}/index-$$"
            GIT_INDEX_FILE="${index}" git --git-dir="${git_dir}" read-tree "$(jq -r .base_tree <<<"${body}")" || exit 1
            for ((entry = 0; entry < $(jq '.tree | length' <<<"${body}"); entry++)); do
                blob="$(jq -j ".tree[${entry}].content" <<<"${body}" | git --git-dir="${git_dir}" hash-object -w --stdin)" || exit 1
                GIT_INDEX_FILE="${index}" git --git-dir="${git_dir}" update-index --add \
                    --cacheinfo "100644,${blob},$(jq -r ".tree[${entry}].path" <<<"${body}")" || exit 1
            done
            tree="$(GIT_INDEX_FILE="${index}" git --git-dir="${git_dir}" write-tree)" || exit 1
            rm -f -- "${index}"
            respond "201 Created" "$(jq -cn --arg t "${tree}" '{sha: $t}')"
            ;;
        "POST git/commits")
            commit="$(git --git-dir="${git_dir}" commit-tree "$(jq -r .tree <<<"${body}")" -p "$(jq -r '.parents[0]' <<<"${body}")" \
                -m "$(jq -r .message <<<"${body}")")" || exit 1
            respond "201 Created" "$(jq -cn --arg s "${commit}" '{sha: $s}')"
            ;;
        "POST git/refs")
            ref="$(jq -r .ref <<<"${body}")"
            ! git --git-dir="${git_dir}" rev-parse --verify --quiet "${ref}" >/dev/null ||
                respond "422 Unprocessable Entity" '{"message": "Reference already exists"}'
            git --git-dir="${git_dir}" update-ref "${ref}" "$(jq -r .sha <<<"${body}")" || exit 1
            respond "201 Created" "$(jq -cn --arg r "${ref}" '{ref: $r}')"
            ;;
        "PATCH git/refs/heads/"*)
            git --git-dir="${git_dir}" update-ref "refs/heads/${part#git/refs/heads/}" "$(jq -r .sha <<<"${body}")" || exit 1
            respond "200 OK" '{}'
            ;;
        "DELETE git/refs/heads/"*)
            git --git-dir="${git_dir}" update-ref -d "refs/heads/${part#git/refs/heads/}" || exit 1
            respond "204 No Content" ''
            ;;
        "GET actions/variables/"*)
            name="${part#actions/variables/}"
            value="$(awk -v r="${repo}" -v n="${name}" '$1 == "variable" && $2 == r && $3 == n { v = $4 } END { print v }' \
                "${GH_REMOTES}/variables" 2>/dev/null)"
            [[ -n "${value}" ]] || respond "404 Not Found" "${not_found}"
            respond "200 OK" "$(jq -cn --arg n "${name}" --arg v "${value}" '{name: $n, value: $v}')"
            ;;
        "POST actions/variables" | "PATCH actions/variables/"*)
            printf 'variable %s %s %s\n' "${repo}" "$(jq -r .name <<<"${body}")" "$(jq -r .value <<<"${body}")" >>"${GH_REMOTES}/variables"
            respond "201 Created" '{}'
            ;;
    esac
fi

# A REST write: recorded among the calls, and answered with an ID.
if [[ "${method}" != GET && "${rest_path}" != graphql ]]; then
    jq -cn --arg p "${rest_path}" '{id: 9000, node_id: ("N_" + $p), html_url: ("https://github.com/" + $p)}' |
        if [[ -n "${jq_program}" ]]; then jq -r "${jq_program}"; else cat; fi
    exit 0
fi

if [[ "${rest_path}" != graphql ]]; then
    ((include)) || { printf 'stand-in gh: a REST call without -i: %s\n' "${rest_path}" >&2; exit 1; }
    file="$(fixture "rest/${rest_path//[?=&]/_}.json")"
    if [[ "${rest_path}" =~ ^orgs/[^/]+$ ]]; then
        printf 'HTTP/2.0 200 OK\n\n{}\n'
        exit 0
    fi
    [[ -r "${file}" ]] || { printf 'HTTP/2.0 404 Not Found\n\n{}\n'; exit 1; }
    printf 'HTTP/2.0 200 OK\nEtag: "e-%s"\n\n' "${rest_path//[^a-z]/}"
    jq -c '.[0]' "${file}"
    exit 0
fi

query="${vars[query]:-}"
[[ "${query}" =~ (query|mutation)[[:space:]]+(star[A-Za-z]+) ]] || { printf 'stand-in gh: no operation name in %s\n' "${query}" >&2; exit 1; }
operation_kind="${BASH_REMATCH[1]}" operation="${BASH_REMATCH[2]}"
login="" owner="" name=""
[[ "${query}" =~ login:[[:space:]]*\"([^\"]+)\" ]] && login="${BASH_REMATCH[1]}"
[[ "${query}" =~ repository\(owner:[[:space:]]*\"([^\"]+)\",[[:space:]]*name:[[:space:]]*\"([^\"]+)\" ]] && owner="${BASH_REMATCH[1]}" name="${BASH_REMATCH[2]}"

case ${operation} in
    starIssues)
        filter=.
        [[ "${query}" == *"states: [OPEN]"* ]] && filter='.data.repository.issues.nodes |= map(select(.state == "OPEN"))'
        answer "${GH_FIXTURES}/issues/${owner}/${name}.json" "${filter}"
        ;;
    starSearchCount | starSearch)
        [[ "${vars[q]:-}" =~ repo:([^/[:space:]]+)/([^[:space:]\)]+) ]] || { printf 'stand-in gh: no repo: in %s\n' "${vars[q]:-}" >&2; exit 1; }
        answer "${GH_FIXTURES}/search/${BASH_REMATCH[1]}/${BASH_REMATCH[2]}.json"
        ;;
    starOwner | starOrganizationModel | starUserModel | starProjects)
        answer "$(fixture "${operation}/${login}.json")"
        ;;
    starTriage)
        [[ "${query}" =~ query:[[:space:]]*\"Triage:[[:space:]]*([^\"]+)\" ]] || { printf 'stand-in gh: no Triage title in %s\n' "${query}" >&2; exit 1; }
        answer "${GH_FIXTURES}/starTriage/${login}/${BASH_REMATCH[1]}.json"
        ;;
    starTriageItems)
        [[ "${query}" =~ node\(id:[[:space:]]*\"([^\"]+)\" ]] || exit 1
        answer "${GH_FIXTURES}/starTriageItems/${BASH_REMATCH[1]}.json"
        ;;
    starAddToTriage)
        [[ "${query}" =~ projectId:[[:space:]]*\"([^\"]+)\",[[:space:]]*contentId:[[:space:]]*\"([^\"]+)\" ]] || exit 1
        printf 'PVTI_new_%s %s\n' "${BASH_REMATCH[2]}" "${BASH_REMATCH[1]}" >>"${GH_STATE}"
        jq -cn --arg id "PVTI_new_${BASH_REMATCH[2]}" '{data: {addProjectV2ItemById: {item: {id: $id}}}}' |
            if [[ -n "${jq_program}" ]]; then jq -r -c "${jq_program}"; else cat; fi
        ;;
    starSetStatus)
        jq -cn '{data: {updateProjectV2ItemFieldValue: {projectV2Item: {id: "set"}}}}'
        ;;
    starComment)
        jq -cn --arg s "${vars[s]:-}" '{data: {addComment: {commentEdge: {node: {id: ("IC_" + $s)}}}}}' |
            if [[ -n "${jq_program}" ]]; then jq -r -c "${jq_program}"; else cat; fi
        ;;
    starProject)
        # A project apply has just made or copied: GitHub's own fields, Status with its three options, and View 1. The
        # IDs of a project made begin N and those of a copy C, so that a case can tell whose part a write names.
        prefix=N
        [[ "${query}" == *NEW_starCopyProject* ]] && prefix=C
        jq -cn --arg p "${prefix}" 'def names($list): {nodes: [$list[] | {name: .}]};
            {data: {node: {id: "NEW", number: 99, title: "new", template: false, closed: false, shortDescription: "", readme: "",
            public: false, teams: {nodes: []}, repositories: {nodes: []}, fields: {nodes: [
                {id: ($p + "F_title"), name: "Title", dataType: "TITLE"},
                {id: ($p + "F_assignees"), name: "Assignees", dataType: "ASSIGNEES"},
                {id: ($p + "F_status"), name: "Status", dataType: "SINGLE_SELECT", options: [
                    {id: ($p + "O_todo"), name: "Todo", color: "GRAY", description: ""},
                    {id: ($p + "O_progress"), name: "In Progress", color: "YELLOW", description: ""},
                    {id: ($p + "O_done"), name: "Done", color: "PURPLE", description: ""}]},
                {id: ($p + "F_labels"), name: "Labels", dataType: "LABELS"},
                {id: ($p + "F_prs"), name: "Linked pull requests", dataType: "LINKED_PULL_REQUESTS"},
                {id: ($p + "F_subissues"), name: "Sub-issues progress", dataType: "SUB_ISSUES_PROGRESS"}]},
            views: {nodes: [{id: ($p + "V_1"), name: "View 1", number: 1, layout: "TABLE_LAYOUT", filter: "",
                fields: names(["Title", "Assignees", "Status"]), groupByFields: names([]), verticalGroupByFields: names([]),
                sortByFields: {nodes: []}}]}}}}' |
            if [[ -n "${jq_program}" ]]; then jq -r -c "${jq_program}"; else cat; fi
        ;;
    starWorkflows)
        # The built-in workflows GitHub gives a project made or copied: two stand for them all, their IDs begun alike.
        prefix=N
        [[ "${query}" == *NEW_starCopyProject* ]] && prefix=C
        jq -cn --arg p "${prefix}" '{data: {node: {workflows: {nodes: [{id: ($p + "W_closed"), name: "Item closed"},
            {id: ($p + "W_merged"), name: "Pull request merged"}]}}}}' |
            if [[ -n "${jq_program}" ]]; then jq -r -c "${jq_program}"; else cat; fi
        ;;
    starCount)
        jq -cn '{data: {search: {issueCount: 3}}}' | if [[ -n "${jq_program}" ]]; then jq -r -c "${jq_program}"; else cat; fi
        ;;
    starItem)
        [[ "${query}" =~ node\(id:[[:space:]]*\"([^\"]+)\" ]] || exit 1
        project="$(awk -v id="${BASH_REMATCH[1]}" '$1 == id { print $2 }' "${GH_STATE}")"
        jq -cn --arg p "${project}" '{data: {node: {project: {id: $p}, status: {name: "Open"}}}}' |
            if [[ -n "${jq_program}" ]]; then jq -r -c "${jq_program}"; else cat; fi
        ;;
    *)
        # A mutation the cases need no particular answer from: a new ID, number and URL, for the caller to read. One
        # that selects what GitHub's schema lacks is refused, as GitHub refuses it: a view's deletion answers the view,
        # and no deletedViewId (GitHub's GraphQL schema, DeleteProjectV2ViewPayload, read 2026-11-11).
        if [[ "${operation_kind}" == mutation ]]; then
            if [[ "${query}" == *deletedViewId* ]]; then
                printf '%s\n' "{\"errors\": [{\"message\": \"Field 'deletedViewId' doesn't exist on type 'DeleteProjectV2ViewPayload'\"}]}"
                printf '%s\n' "gh: Field 'deletedViewId' doesn't exist on type 'DeleteProjectV2ViewPayload'" >&2
                exit 1
            fi
            jq -cn --arg op "${operation}" '{data: {r: {node: {id: ("NEW_" + $op), number: 99,
                url: ("https://github.com/orgs/new/projects/99")}}}}' |
                if [[ -n "${jq_program}" ]]; then jq -r -c "${jq_program}"; else cat; fi
            exit 0
        fi
        printf 'stand-in gh: no answer for %s\n' "${operation}" >&2
        exit 1
        ;;
esac
GH
    chmod +x "${run_directory}/bin/gh"
}

# write_fixtures writes what the stand-in answers: each repository's issues, the searches, the accounts' records as
# the model's pull reads them, and the Triage projects with their rows.
#
# The issues, by what each case reads of them:
#
#   NobleFactor/alpha, engprod's: #1 an epic; #2 a feature under it, labeled good first issue; #3 a task under #2 at
#   step 2 of schedule s1, blocked by #4 at step 3; #4 a task at step 3, blocked by #6, closed; #5 a bug with no
#   Area, no evidence and Severity N/A, on no project; #6 a closed task; #7 a feature on Backlog: engprod and on
#   Schedule: engprod, already a row of Triage: engprod; #8 an open task with a Resolution; #9 a task on Scenario:
#   engprod with no Area and no evidence; #10 a task with Severity High; #11 a task at step 5 of s1, blocked by
#   NobleFactor/beta#1, on no schedule.
#   NobleFactor/beta, devlore's: #1 a task under NobleFactor/alpha#2.
#   test-user/personal: #1 an epic; #2 a task under it with two area: labels; #3 a bug with area:product.
#   NobleFactor/many: 250 issues over three pages, every fifth closed.
#
# Returns:
#   - 0, with the fixtures under fixtures/.
function write_fixtures {
    local fixtures="${run_directory}/fixtures" library

    mkdir -p -- "${fixtures}"/{issues/NobleFactor,issues/test-user,search/NobleFactor,rest/orgs/NobleFactor,rest/repos/NobleFactor/noblefactor-engprod}
    mkdir -p -- "${fixtures}"/{rest/repos/NobleFactor/alpha,rest/repos/NobleFactor/beta,rest/orgs/Acme,rest/repos/Acme/site}
    mkdir -p -- "${fixtures}"/{rest/repos/Acme/app,rest/repos/Acme/docs}
    mkdir -p -- "${fixtures}"/{starOwner,starOrganizationModel,starUserModel,starProjects,starTriageItems}
    mkdir -p -- "${fixtures}"/starTriage/{NobleFactor,test-user}

    # The jq that builds an issue node as GraphQL returns it, from the few things a fixture says of it.
    library='
        def evidence: "## Evidence of completion\n\nShown.";
        def node($repo; $n; $spec): {
            id: ("I_" + ($repo | gsub("/"; "_")) + "_" + ($n | tostring)), number: $n, title: ($spec.title // "Issue \($n)"),
            url: "https://github.com/\($repo)/issues/\($n)", state: ($spec.state // "OPEN"),
            stateReason: (if ($spec.state // "OPEN") == "CLOSED" then "COMPLETED" else null end),
            createdAt: "2026-11-01T00:00:00Z", updatedAt: "2026-11-02T00:00:00Z",
            closedAt: (if ($spec.state // "OPEN") == "CLOSED" then "2026-11-03T00:00:00Z" else null end),
            body: ($spec.body // evidence), repository: {nameWithOwner: $repo},
            issueType: (if $spec.type then {name: $spec.type} else null end),
            labels: {nodes: [($spec.labels // [])[] | {name: .}]}, assignees: {nodes: []},
            blockedBy: {nodes: [($spec.blocked // [])[] | {number: .[1], state: .[2], repository: {nameWithOwner: .[0]}}]},
            subIssuesSummary: {total: 0, completed: 0},
            issueFieldValues: {nodes: [($spec.fields // {}) | to_entries[] | {field: {name: .key}, name: .value}]},
            projectItems: {nodes: [($spec.rows // [])[] | {id: ("PVTI_" + .[0]), project: {id: .[0], number: .[1], title: .[2]},
                fieldValues: {nodes: ([{field: {name: "Title", dataType: "TITLE"}, text: "t"}] +
                    [.[3] | to_entries[] | if (.value | type) == "number" then {field: {name: .key, dataType: "NUMBER"}, number: .value}
                        else {field: {name: .key, dataType: "SINGLE_SELECT"}, name: .value} end])}}]},
            parent: $spec.parent
        };
        def parent($repo; $n; $type; $grand): {number: $n, repository: {nameWithOwner: $repo},
            issueType: (if $type then {name: $type} else null end), labels: {nodes: []}, parent: $grand};
        def uparent($repo; $n; $label; $grand): {number: $n, repository: {nameWithOwner: $repo}, issueType: null,
            labels: {nodes: [{name: $label}]}, parent: $grand};
        def page($nodes; $next): {data: {repository: {issues: {pageInfo: {hasNextPage: $next, endCursor: "c"}, nodes: $nodes}}}};
        def search($count; $nodes): {data: {search: {issueCount: $count, pageInfo: {hasNextPage: false, endCursor: null}, nodes: $nodes}}};
        def schedule($n; $step): ["PVT_schedule", 26, "Schedule: engprod", {Schedule: "s1", Step: $step, Status: "Open"}];
    '

    jq -n "${library}"'
        def epic: parent("NobleFactor/alpha"; 1; "Epic"; null);
        def feature: parent("NobleFactor/alpha"; 2; "Feature"; epic);
        [page([
            node("NobleFactor/alpha"; 1; {type: "Epic", fields: {Area: "Engineering", Severity: "N/A"}}),
            node("NobleFactor/alpha"; 2; {type: "Feature", parent: epic, labels: ["good first issue"], fields: {Area: "Engineering", Severity: "N/A"}}),
            node("NobleFactor/alpha"; 3; {type: "Task", parent: feature, fields: {Area: "Product", Severity: "N/A"},
                rows: [schedule(3; 2)], blocked: [["NobleFactor/alpha", 4, "OPEN"]]}),
            node("NobleFactor/alpha"; 4; {type: "Task", parent: feature, fields: {Area: "Product", Severity: "N/A"},
                rows: [schedule(4; 3)], blocked: [["NobleFactor/alpha", 6, "CLOSED"]]}),
            node("NobleFactor/alpha"; 5; {type: "Bug", fields: {Severity: "N/A"}, body: "A bug."}),
            node("NobleFactor/alpha"; 6; {type: "Task", parent: feature, state: "CLOSED", fields: {Area: "Product", Severity: "N/A"},
                rows: [schedule(6; 1)]}),
            node("NobleFactor/alpha"; 7; {type: "Feature", parent: epic, fields: {Area: "Product", Severity: "N/A"},
                rows: [["PVT_backlog", 24, "Backlog: engprod", {Status: "Open"}], schedule(7; 4),
                    ["PVT_triage_engprod", 5, "Triage: engprod", {Status: "Open"}]]}),
            node("NobleFactor/alpha"; 8; {type: "Task", parent: feature, fields: {Area: "Product", Severity: "N/A", Resolution: "Declined"}}),
            node("NobleFactor/alpha"; 9; {type: "Task", parent: feature, fields: {Severity: "N/A"}, body: "Found while walking.",
                rows: [["PVT_scenario", 8, "Scenario: engprod", {Scenario: "walk", Beat: 1}]]}),
            node("NobleFactor/alpha"; 10; {type: "Task", parent: feature, fields: {Area: "Product", Severity: "High"}}),
            node("NobleFactor/alpha"; 11; {type: "Task", parent: feature, fields: {Area: "Product", Severity: "N/A"},
                rows: [schedule(11; 5)], blocked: [["NobleFactor/beta", 1, "OPEN"]]})
        ]; false)]' >"${fixtures}/issues/NobleFactor/alpha.json"

    jq -n "${library}"'
        [page([node("NobleFactor/beta"; 1; {type: "Task", fields: {Area: "Engineering", Severity: "N/A"},
            parent: parent("NobleFactor/alpha"; 2; "Feature"; parent("NobleFactor/alpha"; 1; "Epic"; null))})]; false)]
    ' >"${fixtures}/issues/NobleFactor/beta.json"

    jq -n "${library}"'
        [page([
            node("test-user/personal"; 1; {labels: ["epic", "area:engineering", "severity:n/a"]}),
            node("test-user/personal"; 2; {labels: ["task", "area:product", "area:engineering", "severity:n/a"],
                parent: uparent("test-user/personal"; 1; "epic"; null)}),
            node("test-user/personal"; 3; {labels: ["bug", "area:product", "severity:high"]}),
            node("test-user/personal"; 4; {labels: ["task", "bug", "area:product", "severity:n/a"]})
        ]; false)]' >"${fixtures}/issues/test-user/personal.json"

    jq -n "${library}"'
        [range(0; 3) as $p | page([range($p * 100 + 1; [($p + 1) * 100, 250] | min + 1) as $n |
            node("NobleFactor/many"; $n; {type: "Task", state: (if $n % 5 == 0 then "CLOSED" else "OPEN" end),
                fields: {Area: "Product", Severity: "N/A"}})]; $p < 2)]
    ' >"${fixtures}/issues/NobleFactor/many.json"

    jq -n "${library}"'[search(1; [node("NobleFactor/alpha"; 5; {type: "Bug", fields: {Severity: "N/A"}})])]' \
        >"${fixtures}/search/NobleFactor/alpha.json"
    jq -n "${library}"'[search(1001; [])]' >"${fixtures}/search/NobleFactor/huge.json"

    # The records the model's pull and every command's read-first make.
    jq -n '[{data: {repositoryOwner: {__typename: "Organization", login: "NobleFactor", id: "O_NobleFactor"}}}]' >"${fixtures}/starOwner/NobleFactor.json"
    jq -n '[{data: {repositoryOwner: {__typename: "User", login: "test-user", id: "U_test_user"}}}]' >"${fixtures}/starOwner/test-user.json"
    jq -n '[[
        {id: 1, name: "Epic", description: "Level 0: the root", color: "purple", is_enabled: true},
        {id: 2, name: "Feature", description: "Level 1: a capability", color: "blue", is_enabled: true},
        {id: 3, name: "Bug", description: "Level 2: unplanned work", color: "red", is_enabled: true},
        {id: 4, name: "Task", description: "Level 2: planned work", color: "yellow", is_enabled: true},
        {id: 5, name: "Schedule", description: "Collection: a schedule", color: "green", is_enabled: true},
        {id: 6, name: "Scenario", description: "Collection: a scenario", color: "orange", is_enabled: true}
    ]]' >"${fixtures}/rest/orgs/NobleFactor/issue-types.json"
    jq -n '[[]]' >"${fixtures}/rest/repos/NobleFactor/noblefactor-engprod/labels_per_page_100.json"
    # The labels of each repository a team maintains: alpha, engprod's, and beta, devlore's (#437).
    jq -n '[[{id: 101, node_id: "LA_alpha_gfi", name: "good first issue", color: "7057ff", description: "Good for newcomers"}]]' \
        >"${fixtures}/rest/repos/NobleFactor/alpha/labels_per_page_100.json"
    jq -n '[[{id: 201, node_id: "LA_beta_gfi", name: "good first issue", color: "7057ff", description: "Good for newcomers"}]]' \
        >"${fixtures}/rest/repos/NobleFactor/beta/labels_per_page_100.json"
    # Acme, an organization new to the model: GitHub's three issue types; three teams, web, b and c, each maintaining a
    # repository, site, app and docs; GitHub's default labels on each; no issue fields and no projects (#437).
    jq -n '[{data: {repositoryOwner: {__typename: "Organization", login: "Acme", id: "O_Acme"}}}]' >"${fixtures}/starOwner/Acme.json"
    jq -n '[[
        {id: 11, name: "Task", description: "A specific piece of work", color: "yellow", is_enabled: true},
        {id: 12, name: "Bug", description: "An unexpected problem or behavior", color: "red", is_enabled: true},
        {id: 13, name: "Feature", description: "A request, idea, or new functionality", color: "blue", is_enabled: true}
    ]]' >"${fixtures}/rest/orgs/Acme/issue-types.json"
    jq -n 'def team($slug; $repo): {name: $slug, slug: $slug, id: "T_\($slug)", description: "", privacy: "VISIBLE",
            notificationSetting: "NOTIFICATIONS_ENABLED", parentTeam: null,
            repositories: {edges: [{permission: "MAINTAIN", node: {nameWithOwner: $repo}}]}};
        [{data: {organization: {issueFields: {nodes: []}, issueTypes: {nodes: []},
            teams: {nodes: [team("web"; "Acme/site"), team("b"; "Acme/app"), team("c"; "Acme/docs")]}}}}]' \
