# A world for the order get returns rows in: s1's rows out of step order on the project, #22's with its Worktree, its
# Iteration and two blockers, #21, closed, and #24, open, and #44, a row of s1 with no step, placed before them all;
# walk's likewise, #46, with no Beat, just after #40's own row, then #45 at beat 3, then #27 at beat 1.
declare -r unordered='
    def task($n; $title): {("I_alpha_" + ($n | tostring)): {id: ("I_alpha_" + ($n | tostring)), repo: "NobleFactor/alpha",
        number: $n, title: $title, state: "OPEN", type: "Task", labels: [], assignees: [], blockedBy: [], body: ""}};
    def row($n; $values): {id: ("IT_alpha_" + ($n | tostring)), content: ("I_alpha_" + ($n | tostring)), values: $values};
    .issues += task(44; "a row with no step") + task(45; "found at beat 3") + task(46; "found at no beat")
    | .issues.I_alpha_22.blockedBy = ["I_alpha_21", "I_alpha_24"]
    | .projects.PVT_s_eng.items |= (map(if .id == "IT_alpha_22"
            then .values += {Worktree: "https://github.com/NobleFactor/alpha/tree/task/22-second", Iteration: "Iteration 3"} else . end)
        | [.[0], row(44; {Schedule: "s1", Status: "Open"})] + [.[] | select(.id == "IT_alpha_24")] + [.[1:][] | select(.id != "IT_alpha_24")])
    | .projects.PVT_c_eng.items = [.projects.PVT_c_eng.items[0], row(46; {Scenario: "walk", Status: "Open"}),
        row(45; {Scenario: "walk", Beat: 3, Status: "In progress"})] + .projects.PVT_c_eng.items[1:]'

