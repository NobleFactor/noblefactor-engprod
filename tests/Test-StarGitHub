# 113 to 118: star github schedule close and star github scenario close (#512), as
# docs/plans/doc/507-scenario-commands.md's test plan cases 11 and 12 have them, each named for its case. Each starts
# from base_world, changed where it says, and reads back what each left in it.

# A finished s1: #20's Exit criteria both ticked, and every step closed. #21 and #24 are closed by alpha's #101, which
# GitHub records as closing each; #22 by a commit whose merged pull request is beta's #102, its title holding a pipe;
# and #23, a duplicate, by no pull request, its Resolution Duplicate, though alpha's #103, never merged, would have
# closed it.
declare -r finished='
    def pull($repo; $n; $title; $merged): {number: $n, title: $title, merged: ($merged != null), mergedAt: $merged,
        mergeCommit: {oid: ("c" + ($n | tostring))}, repository: {nameWithOwner: $repo}};
    .issues.I_alpha_20.body = ("## Deliverable\n\nWhat s1 delivers.\n\n## Exit criteria\n\n- [x] Each step closed.\n" +
        "- [x] Its proof shown.\n\n## Steps\n\nThe steps are the rows under s1.\n\n## Amendments\n\n")
    | .issues.I_alpha_21 += {closedAt: "2026-11-01T09:00:00Z",
        references: [pull("NobleFactor/alpha"; 101; "the first work"; "2026-11-01T08:00:00Z")]}
    | .issues.I_alpha_22 += {state: "CLOSED", closedAt: "2026-11-03T09:00:00Z", closer: {__typename: "Commit", oid: "c102",
        associatedPullRequests: {nodes: [pull("NobleFactor/beta"; 102; "the second | work"; "2026-11-03T08:00:00Z")]}}}
    | .issues.I_alpha_23 += {closedAt: "2026-11-02T09:00:00Z", fields: {Resolution: "Duplicate"},
        references: [pull("NobleFactor/alpha"; 103; "a try that did not merge"; null)]}
    | .issues.I_alpha_24 += {state: "CLOSED", closedAt: "2026-11-01T10:00:00Z",
        references: [pull("NobleFactor/alpha"; 101; "the first work"; "2026-11-01T08:00:00Z")]}'

