    # its own; a closed template. test-user's copies of Triage and Backlog, beside its own Triage project and a project of
    # no kind. Each project's options have IDs of its own.
    jq -n 'def status($id): {id: "F_\($id)_status", name: "Status", dataType: "SINGLE_SELECT",
