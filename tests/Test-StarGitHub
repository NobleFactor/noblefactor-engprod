# world gives one of add's cases its GitHub: base_world, changed by a jq program when one is given, as the world the
# stand-in's schedule operations answer from.
#
# Parameters:
#   - `$1`: a jq program to change base_world by; optional, none by default.
#
# Returns:
#   - 0, the world written.
function world {
    base_world | jq "${1:-.}" >"${run_directory}/remotes/world.json"
}

# world_holds succeeds when a jq program over the world, as the last run left it, prints true.
#
# Parameters:
#   - `$1`: the jq program.
#
# Returns:
#   - 0 when it prints true; 1 otherwise.
function world_holds {
    [[ "$(jq "$1" "${run_directory}/remotes/world.json")" == true ]]
}

# calls_hold succeeds when a jq program over the calls the last run made, as one array of argument arrays, prints true.
#
# Parameters:
#   - `$1`: the jq program.
#
# Returns:
#   - 0 when it prints true; 1 otherwise.
function calls_hold {
    [[ "$(jq --slurp "$1" "${run_directory}/calls.jsonl")" == true ]]
}

# write_stand_in writes the stand-in for gh to the run's bin directory.
#
# It records each call as a JSON array of its arguments, one per line of ${GH_CALLS}, and answers from ${GH_FIXTURES}:
# a GraphQL request by the operation name the extension gives it, a REST request by its path. Every fixture file is a
# JSON array of responses, one per page; --paginate answers every page and a request without it the first, and --jq
# is applied to each, as gh does. An addition to a project is remembered in ${GH_STATE}, so that reading the row back
# finds it.
#
# A fixture may be the data directory's own, under ${XDG_DATA_HOME}/fixtures, which a case gives it with override; it
# is answered before the run's. A login in a fixture's path matches in any case, as GitHub's logins do (#485), and a
# REST fixture of more than one page answers its first with a Link header naming the next, as GitHub does (#484). An
# account's .github repository is a bare repository under ${GH_REMOTES}, which `repo view`, `repo create` and `repo
# clone` answer from, and a pull request opened on it is merged by moving its main to the pull request's branch: the
# git side of `star github model backup` (#426). Its pull requests are remembered in ${GH_REMOTES}/pulls, across runs,
# so that a backup run again finds the one an earlier run left open; its main's rules, its head commit's workflow runs
# and its checks are as the case's ci set them.
#
# The stand-in for sleep records how long it was asked to wait, among gh's calls, and returns at once.
#
# A write, a REST call with -X or a GraphQL mutation, is recorded among the calls and answered with a new ID; a secret
# set is remembered, value and all, a newline written as \n, in ${GH_REMOTES}/secrets, on a repository or an
# organization, so that a case can read back the token it was given.
#
# Any repository under ${GH_REMOTES} answers what apply reads and writes of it (#437): GitHub's record of it, its files
# raw at a revision, the git data API apply commits through, a ref, a commit, a tree, and its variables, remembered in
# ${GH_REMOTES}/variables. A body sent with --input - is read from standard input.
#
# The schedule commands' operations (#438), starViewer and every starStep one, answer from one world,
# ${GH_REMOTES}/world.json, which a case writes with world and its writes change, through world.jq beside the
# stand-in, so that a read after a write finds it, as GitHub's would. The world may name an operation to fail once,
# fail_on, and another writer's change to make after an operation's first answer, change.
#
# Returns:
#   - 0, the stand-ins written and executable.
function write_stand_in {
    mkdir -p -- "${run_directory}/bin"
    cat >"${run_directory}/bin/sleep" <<'SLEEP'
#!/usr/bin/env bash
printf '%s\0' sleep "$@" | jq -c -R -s 'split("\u0000") | .[:-1]' >>"${GH_CALLS}"
SLEEP
    chmod +x "${run_directory}/bin/sleep"
    cat >"${run_directory}/bin/world.jq" <<'JQ'
# The schedule commands' GitHub: one world that their reads answer from and their writes change. Its issues and its
