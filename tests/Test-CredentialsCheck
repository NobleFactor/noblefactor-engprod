    '([.[] | select(.title == "Token alert: missing")] | last) as $a | $a.state == "closed"
        and ($a.comments[-1].body | test("^Cleared on 2026-11-24: .* #11 and #12 were missed earlier"))'

# GitHub not reached, or answering with a server error, raises nothing for a missed issue.
touch "${state}/unreachable"
