# Test-CredentialsCheck - Tests workflow-templates/credentials-check.sh, the daily check of the token a repository's
# workflows sign in with (#613): each condition raises one incident, assigned and labeled; an open incident gets one
# comment a day while it holds and closes only when its own clearing rule is met; a check in another repository never
# clears it; GitHub not reached raises nothing (#621); and a workflow's failure, reported, raises its incident at once.

[[ -r "$(dirname "$0")/../Home/common/.local/bin/Declare-BashScript" ]] || {
    printf '%s: cannot find Declare-BashScript in %s\n' "${0##*/}" "$(dirname "$0")/../Home/common/.local/bin" >&2
    exit 72 # EX_OSFILE
}

XDG_DATA_HOME="$(cd "$(dirname "$0")/../Home/common/.local/share" && pwd)" || exit 72 # EX_OSFILE
export XDG_DATA_HOME

# shellcheck source=Declare-BashScript
source "$(dirname "$0")/../Home/common/.local/bin/Declare-BashScript" "$0" "help" "h" "$@"
require_command jq openssl mktemp

check_script="$(cd "$(dirname "$0")/../workflow-templates" && pwd)/credentials-check.sh"

###########
# Functions
###########

# cleanup removes the run's directory, however the run ends.
#
# Returns:
#   - 0, the run's directory gone.
function cleanup {
    if [[ -n "${run_directory:-}" && -d "${run_directory}" ]]; then
        rm -rf -- "${run_directory}"
    fi
}

# write_stand_ins writes the stand-ins for curl, gh and date into the run's bin directory.
#
# The stand-in curl answers GitHub's API from the state directory: none of it when unreachable exists; an app's
# installations, from installations.json, refused when app-refused exists; an installation token, its permissions from
# permissions.json, refused when mint-refused exists; and a classic token's user, from tokens, as `<token> <login>
# <scopes,comma-separated> <expiry>`. The stand-in gh keeps the issues in issues.json and answers the runs of a watched
# repository's check from runs, as `<repository> <created_at>`. The stand-in date answers `date -u +%Y-%m-%d` with
# ${TODAY}, the day the case says it is.
#
# Returns:
#   - 0, the stand-ins written.
function write_stand_ins {
    mkdir -p -- "${run_directory}/bin"
    cat >"${run_directory}/bin/curl" <<'CURL'
#!/usr/bin/env bash
state="${STATE:?}" body="" headers="" method=GET url="" auth=""
while (($#)); do
    case "$1" in
        -o) body="$2" && shift ;;
        -D) headers="$2" && shift ;;
        -X) method="$2" && shift ;;
        -H) [[ "$2" == Authorization:* ]] && auth="${2#Authorization: }"; shift ;;
        -w | --max-time) shift ;;
        -*) ;;
        *) url="$1" ;;
    esac
    shift
done
if [[ -e "${state}/unreachable" ]]; then
    printf 'curl: (6) Could not resolve host: api.github.com\n' >&2
    exit 6
fi
answer() {
    printf 'HTTP/2 %s\r\n%s\r\n' "$1" "${3:-}" >"${headers}"
    printf '%s' "$2" >"${body}"
    printf '%s' "$1"
    exit 0
}
case "${method} ${url}" in
    "GET "*/app/installations)
        [[ ! -e "${state}/app-refused" ]] || answer 401 '{"message": "A JSON web token could not be decoded"}'
        answer 200 "$(cat "${state}/installations.json")"
        ;;
    "POST "*/access_tokens)
        [[ ! -e "${state}/mint-refused" ]] || answer 403 '{"message": "Resource not accessible"}'
        answer 201 "$(jq -c '{token: "ghs_minted", permissions: .}' "${state}/permissions.json")"
        ;;
    "GET "*/user)
        line="$(awk -v t="${auth#token }" '$1 == t { $1 = ""; print substr($0, 2) }' "${state}/tokens" 2>/dev/null)"
        [[ -n "${line}" ]] || answer 401 '{"message": "Bad credentials"}'
        read -r login scopes expiry <<<"${line}"
        answer 200 "$(jq -cn --arg l "${login}" '{login: $l}')" \
            "x-oauth-scopes: ${scopes//,/, }"$'\r\n'"github-authentication-token-expiration: ${expiry}"
        ;;
esac
answer 404 '{"message": "Not Found"}'
CURL
    cat >"${run_directory}/bin/gh" <<'GH'
#!/usr/bin/env bash
state="${STATE:?}" issues="${STATE}/issues.json"
[[ -f "${issues}" ]] || printf '[]' >"${issues}"
printf '%s\0' gh "$@" | jq -c -R -s 'split("\u0000") | .[:-1]' >>"${state}/calls"
option() {
    local name="$1"
    shift
    while (($#)); do
        [[ "$1" != "${name}" ]] || { printf '%s' "$2"; return; }
        shift
    done
}
now="${TODAY:?}T07:17:00Z"
case "$1 $2" in
    "label create") exit 0 ;;
    "issue list")
        repo="$(option --repo "$@")" label="$(option --label "$@")"
        jq -c --arg r "${repo}" --arg l "${label}" \
            '[.[] | select(.repo == $r and .state == "open" and (.labels | index($l)))]' \
            "${issues}" | jq -r "$(option --jq "$@")"
        ;;
    "issue create")
        repo="$(option --repo "$@")"
        jq --arg r "${repo}" --arg t "$(option --title "$@")" --arg l "$(option --label "$@")" \
            --arg a "$(option --assignee "$@")" \
            --arg b "$(option --body "$@")" --arg n "${now}" \
            '. + [{number: (length + 1), repo: $r, title: $t, labels: [$l], assignees: [$a], body: $b, state: "open",
                createdAt: $n, comments: []}]' "${issues}" >"${issues}.next" && mv -- "${issues}.next" "${issues}"
        printf 'https://github.com/%s/issues/%s\n' "${repo}" "$(jq length "${issues}")"
        ;;
    "issue view")
        jq -c --argjson n "$3" '.[] | select(.number == $n)' "${issues}" | jq -r "$(option --jq "$@")"
        ;;
    "issue comment")
        jq --argjson n "$3" --arg b "$(option --body "$@")" --arg c "${now}" \
            'map(if .number == $n then .comments += [{createdAt: $c, body: $b}] else . end)' \
            "${issues}" >"${issues}.next" &&
            mv -- "${issues}.next" "${issues}"
        ;;
    "issue close")
        jq --argjson n "$3" 'map(if .number == $n then .state = "closed" else . end)' "${issues}" >"${issues}.next" &&
            mv -- "${issues}.next" "${issues}"
        ;;
    "api repos/"*)
        repository="${2#repos/}" repository="${repository%%/actions/*}"
        created="$(awk -v r="${repository}" '$1 == r { c = $2 } END { print c }' "${state}/runs" 2>/dev/null)"
        jq -cn --arg c "${created}" \
            'if $c == "" then {workflow_runs: []} else {workflow_runs: [{created_at: $c}]} end' |
            jq -r "$(option --jq "$@")"
        ;;
    *)
        printf 'stand-in gh: %s is not answered\n' "$*" >&2
        exit 2
        ;;
esac
GH
    cat >"${run_directory}/bin/date" <<DATE
#!/usr/bin/env bash
if [[ \$# -eq 2 && \$1 == -u && \$2 == +%Y-%m-%d ]]; then
    printf '%s\\n' "\${TODAY:?}"
    exit 0
fi
exec $(command -v date) "\$@"
DATE
    chmod +x "${run_directory}/bin/curl" "${run_directory}/bin/gh" "${run_directory}/bin/date"
}

# fresh_state lays out one case's GitHub: Acme's app installed with every permission the configuration names, and
# test-user's classic token with both scopes, expiring far ahead.
#
# Parameters:
#   - `$1`: the state directory, which must not exist yet.
#
# Returns:
#   - 0, the state laid out.
function fresh_state {
    mkdir -p -- "$1"
    printf '[{"id": 7, "account": {"login": "Acme"}}]' >"$1/installations.json"
    jq '.organization.permissions' "${config}" >"$1/permissions.json"
    printf 'tok-good test-user repo,project 2030-01-01 00:00:00 UTC\n' >"$1/tokens"
}

# check_run runs the check once as a repository's workflow would, its status in ${status} and its output in ${output}.
#
# Parameters:
#   - `$1`: the account's kind, organization or user.
#   - `$2`: the repository.
#   - `$@`: further NAME=value settings for the run.
#
# Returns:
#   - 0, whatever the check's own status.
function check_run {
    local kind="$1" repository="$2"
    shift 2
    status=0
    output="$(env PATH="${run_directory}/bin:${PATH}" STATE="${state}" TODAY="${today}" KIND="${kind}" \
        ACCOUNT="${repository%%/*}" REPOSITORY="${repository}" GH_TOKEN=github-token RUN_URL="run ${today}" "$@" \
        bash "${check_script}" 2>&1)" || status=$?
}

# expect records one case: whether a jq program holds of the issues, and whether the check's status is the one given.
#
# Parameters:
#   - `$1`: the case's name.
#   - `$2`: the status the check should have.
#   - `$3`: a jq program that must be true of the issues, each {number, repo, title, labels, assignees, state,
#     comments}; open is those open.
#
# Returns:
#   - 0, the case recorded.
function expect {
    local name="$1" want="$2" program="$3" problem=""
    case_count=$((case_count + 1))
    ((status == want)) || problem+="its status was ${status}, not ${want}; "
    jq -e "def open: [.[] | select(.state == \"open\")]; ${program}" "${state}/issues.json" >/dev/null 2>&1 ||
        problem+="the issues do not satisfy ${program}; "
    if [[ -z "${problem}" ]]; then
        success "${name}"
    else
        failures=$((failures + 1))
        error 0 "${name}: ${problem}"
        printf '    output: %s\n    issues: %s\n' "${output:0:1500}" \
            "$(jq -c . "${state}/issues.json" 2>/dev/null | cut -c1-1500)" >&2
    fi
}

######
# Main
######

case_count=0
failures=0
run_directory=""

Set-Traps cleanup
run_directory="$(mktemp -d)"
config="$(dirname "${check_script}")/credentials-check.json"
write_stand_ins
openssl genrsa -out "${run_directory}/app.pem" 2048 2>/dev/null
key="$(<"${run_directory}/app.pem")"
app=(APP_ID=4242 "APP_PRIVATE_KEY=${key}")
today=2026-11-21

# An organization whose token is healthy raises nothing.
state="${run_directory}/organization"
fresh_state "${state}"
check_run organization Acme/site "${app[@]}"
expect "an organization's healthy token raises nothing" 0 'length == 0'

# A missing secret raises one incident, assigned and labeled, and the same day's second run adds nothing to it.
check_run organization Acme/site APP_ID= APP_PRIVATE_KEY=
expect "a missing secret raises its incident, assigned to the owner and labeled" 1 \
    'length == 1 and .[0].title == "Token alert: missing" and .[0].assignees == ["David-Noble-at-work"]
        and .[0].labels == ["token-alert"] and .[0].repo == "Acme/site" and .[0].state == "open"'
check_run organization Acme/site APP_ID= APP_PRIVATE_KEY=
expect "a second run the same day adds no incident and no comment" 1 'length == 1 and (.[0].comments | length) == 0'

# The next day it still holds: one comment.
today=2026-11-22
check_run organization Acme/site APP_ID= APP_PRIVATE_KEY=
expect "the next day the incident gets one comment" 1 \
    '(.[0].comments | length) == 1 and (.[0].comments[0].body | test("^Still holds"))'

# A check in another repository, its token healthy, doesn't clear this one's incident.
check_run organization Acme/app "${app[@]}"
expect "a healthy check in another repository leaves this one's incident open" 0 \
    '[.[] | select(.repo == "Acme/site")][0].state == "open"'

# Restored, the incident is cleared and closed.
check_run organization Acme/site "${app[@]}"
expect "restored, the incident is cleared and closed" 0 \
    '.[0].state == "closed" and (.[0].comments[-1].body | test("^Cleared"))'

# A key GitHub refuses.
touch "${state}/app-refused"
check_run organization Acme/site "${app[@]}"
expect "a refused key raises refused" 1 'open | map(.title) == ["Token alert: refused"]'
rm -f -- "${state}/app-refused"
check_run organization Acme/site "${app[@]}"
expect "a key accepted again clears refused" 0 'open == []'

# An app not installed on the account.
printf '[{"id": 8, "account": {"login": "Other"}}]' >"${state}/installations.json"
check_run organization Acme/site "${app[@]}"
expect "an app not installed raises not-installed" 1 'open | map(.title) == ["Token alert: not-installed"]'
printf '[{"id": 7, "account": {"login": "acme"}}]' >"${state}/installations.json"
check_run organization Acme/site "${app[@]}"
expect "installed, whatever the case of its account's name, not-installed clears" 0 'open == []'

# A permission short: organization projects read only.
jq '.organization_projects = "read"' "${state}/permissions.json" >"${state}/p" &&
    mv -- "${state}/p" "${state}/permissions.json"
check_run organization Acme/site "${app[@]}"
expect "a permission short raises short, naming it" 1 \
    'open | length == 1 and .[0].title == "Token alert: short"
        and (.[0].body | test("organization_projects: write, granted read"))'
jq '.organization.permissions' "${config}" >"${state}/permissions.json"

# A token GitHub won't mint: a failed renewal.
touch "${state}/mint-refused"
check_run organization Acme/site "${app[@]}"
expect "a token GitHub won't mint raises refused, and short clears" 1 \
    'open | map(.title) == ["Token alert: refused"]'
rm -f -- "${state}/mint-refused"
check_run organization Acme/site "${app[@]}"
expect "minted again, every incident is closed" 0 'open == []'

# A key due for rotation within the margin warns while it works, until the date moves beyond the margin.
check_run organization Acme/site "${app[@]}" ROTATION_DUE=2026-11-30
expect "a rotation due within 14 days raises rotation-due though the key works" 1 \
    'open | map(.title) == ["Token alert: rotation-due"]'
check_run organization Acme/site "${app[@]}" ROTATION_DUE=2026-11-01
expect "a rotation overdue raises rotation-overdue, and rotation-due clears" 1 \
    'open | map(.title) == ["Token alert: rotation-overdue"]'
check_run organization Acme/site "${app[@]}" ROTATION_DUE=2027-11-22
expect "rotated, its due date a year ahead, the rotation incidents clear" 0 'open == []'

# GitHub not reached raises nothing and makes no issue call (#621): the run exits 2, and the next one checks again.
touch "${state}/unreachable"
before="$(wc -l <"${state}/calls")"
check_run organization Acme/site "${app[@]}"
expect "GitHub not reached exits 2 and raises nothing" 2 'open == []'
case_count=$((case_count + 1))
if [[ "$(wc -l <"${state}/calls")" -eq "${before}" ]]; then
    success "GitHub not reached makes no issue call"
else
    failures=$((failures + 1))
    error 0 "GitHub not reached made an issue call: $(tail -n 1 "${state}/calls")"
fi
rm -f -- "${state}/unreachable"
check_run organization Acme/site "${app[@]}"
expect "GitHub reached again, nothing is open" 0 'open == []'

# A workflow's failure, reported, raises consumer-failed at once; the next healthy check clears it.
check_run organization Acme/site MODE=report DETAIL="the Triage workflow's token step failed"
expect "a reported failure raises consumer-failed at once" 1 \
    'open | length == 1 and .[0].title == "Token alert: consumer-failed" and (.[0].body | test("token step failed"))'
check_run organization Acme/site "${app[@]}"
expect "the next healthy check clears consumer-failed" 0 'open == []'

# A watched repository's check: none, or none for over two days, raises no-recent-check; a recent one clears it. The app
# is installed on NobleFactor too.
printf '[{"id": 7, "account": {"login": "Acme"}}, {"id": 9, "account": {"login": "NobleFactor"}}]' \
    >"${state}/installations.json"
check_run organization NobleFactor/noblefactor-engprod "${app[@]}" WATCH=NobleFactor/devlore-cli
expect "a watched repository with no check run raises no-recent-check" 1 \
    'open | map(.title) == ["Token alert: no-recent-check in NobleFactor/devlore-cli"]'
printf 'NobleFactor/devlore-cli 2026-11-22T07:17:00Z\n' >"${state}/runs"
check_run organization NobleFactor/noblefactor-engprod "${app[@]}" WATCH=NobleFactor/devlore-cli
expect "a recent check clears no-recent-check" 0 'open == []'

# A user account's classic token.
state="${run_directory}/user"
fresh_state "${state}"
check_run user test-user/personal PAT=tok-good
expect "a user account's healthy token raises nothing" 0 'length == 0'
check_run user test-user/personal PAT=
expect "a missing token raises missing" 1 'map(.title) == ["Token alert: missing"]'
check_run user test-user/personal PAT=tok-unknown
expect "a token GitHub refuses raises refused, and missing clears" 1 \
    'open | map(.title) == ["Token alert: refused"]'
printf 'tok-other someone-else repo,project 2030-01-01 00:00:00 UTC\n' >>"${state}/tokens"
check_run user test-user/personal PAT=tok-other
expect "another account's token raises wrong-account" 1 \
    'open | map(.title) == ["Token alert: wrong-account"]'
printf 'tok-short test-user repo 2030-01-01 00:00:00 UTC\n' >>"${state}/tokens"
check_run user test-user/personal PAT=tok-short
expect "a token short of the project scope raises short" 1 \
    'open | map(.title) == ["Token alert: short"] and (.[] | select(.state == "open") | .body | test("project scope"))'
printf 'tok-soon test-user repo,project 2026-11-30 00:00:00 UTC\n' >>"${state}/tokens"
check_run user test-user/personal PAT=tok-soon
expect "a working token expiring within 14 days raises expiring" 1 \
    'open | map(.title) == ["Token alert: expiring"]'
today=2026-11-23
check_run user test-user/personal PAT=tok-soon
expect "the expiring warning stays open while the token works, with a day's comment" 1 \
    'open | length == 1 and .[0].title == "Token alert: expiring" and (.[0].comments | length) == 1'
check_run user test-user/personal PAT=tok-good
expect "renewed beyond the margin, expiring clears" 0 'open == []'
printf 'tok-old test-user repo,project 2026-11-01 00:00:00 UTC\n' >>"${state}/tokens"
check_run user test-user/personal PAT=tok-old
expect "a token already expired raises expired" 1 'open | map(.title) == ["Token alert: expired"]'

((failures == 0)) || error $EX_SOFTWARE "${failures} of the ${case_count} cases failed"
success "every case passed"
