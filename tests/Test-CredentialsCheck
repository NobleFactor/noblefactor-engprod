expect "a missed issue with GitHub not reached raises nothing" 2 'open == []'
rm -f -- "${state}/unreachable"
printf '503\n' >"${state}/answer-installations"
check_run organization Acme/site "${app[@]}" MODE=report ISSUE=13
expect "a missed issue with GitHub answering a server error raises nothing" 2 'open == []'
