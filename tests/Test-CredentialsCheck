expect "with no alert open, an issue reaching Triage changes nothing" 0 "open == [] and length == ${before}"

# A run that failed before it could tell where an issue belongs says so: it claims no Triage miss.
check_run organization Acme/site "${app[@]}" MODE=report ISSUE=14 CLASSIFIED=false
expect "a run that couldn't tell where #14 belongs says it may not have been placed" 1 \
    'titles == [triage] and (open[0].body | test("^\\*\\*#14\\*\\* may not have been placed: run ")
        and test("failed before it could tell whether #14 belongs in Triage, a schedule or a scenario"))'

# Each Triage template's close step, as the workflow runs it: when the issue reached Triage, whatever later steps did,
# and failing the run when it can't close the alert.
mkdir -p -- "${run_directory}/checkout/.github/credentials-check"
ln -sf -- "${check_script}" "${run_directory}/checkout/.github/credentials-check/credentials-check.sh"
ln -sf -- "${config}" "${run_directory}/checkout/.github/credentials-check/credentials-check.json"
for template in organization user; do
    file="$(dirname "${check_script}")/triage.${template}.yml"
    close="$(awk '/MODE: placed/ { placed = 1 } placed && /^        run: / { sub(/^        run: /, ""); print; exit }' \
        "${file}")"
    case_count=$((case_count + 1))
    if grep -qF "if: \${{ always() && steps.triage.outcome == 'success' }}" "${file}" &&
        grep -qF "CLASSIFIED: \${{ steps.scenario.outcome == 'success' && steps.collection.outcome == 'success' }}" \
            "${file}"; then
        success "the ${template} template closes the alert whenever the issue reached Triage, and says where it belongs"
    else
        failures=$((failures + 1))
        error 0 "the ${template} template's close or report step lacks its condition"
    fi
    touch "${state}/fail-close"
    status=0
    output="$(cd "${run_directory}/checkout" &&
        env PATH="${run_directory}/bin:${PATH}" STATE="${state}" TODAY="${today}" KIND=organization ACCOUNT=Acme \
            REPOSITORY=Acme/site GH_TOKEN=github-token RUN_URL="run ${today}" MODE=placed ISSUE=15 \
            bash -c "${close}" 2>&1)" || status=$?
    rm -f -- "${state}/fail-close"
    expect "the ${template} template's close step fails the run when it can't close the alert" 3 'titles == [triage]'
done
check_run organization Acme/site MODE=placed ISSUE=15
expect "a later issue that reaches Triage closes it, naming the issue whose place was unknown as unknown" 0 \
    'open == [] and ([.[] | select(.title == triage)] | last | .comments[-1].body
        | test("#14 may not have been placed: check that it is where it belongs") and (test("#14 was missed") | not))'

# A new issue that didn't reach Triage, its token bad: the token's own alert, naming the issue. A further miss is a
