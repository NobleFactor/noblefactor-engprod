    'titles == ["Token alert: missing", "Token alert: refused"]'

# A rate limit or a server error proves nothing about the token: the run ends 2, and both stay open.
for answer in '503|a server error' '429|a rate limit' '403 x-ratelimit-remaining: 0|a 403 rate limit'; do
    IFS='|' read -r code name <<<"${answer}"
    printf '%s\n' "${code}" >"${state}/answer-user"
    check_run user test-user/personal PAT=tok-good
    expect "${name} signing in ends 2, and the incidents stay open" 2 \
        'titles == ["Token alert: missing", "Token alert: refused"]'
done
