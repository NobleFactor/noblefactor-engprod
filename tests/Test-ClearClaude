# Test-ClearClaude - Tests Clear-Claude against a stand-in for claude, on macOS and Linux (#411, #414): its refusals of
# usage, of a directory that is no clone and of a store entry that holds no id; a schedule with no store entry;
# --clear, which stages the conversation's memories, their index lines and the job's scratch before /clear is typed,
# types it apart from its Enter past the stand-in's command menu, confirms the new conversation in claude's listing,
# and only then removes the old conversation's records, its prompts among them, keeping the session, its store entry,
# the new conversation's files and every other conversation; the failures that put the staged entries back, or keep
# them when the outcome is unknown; --retire, which ends every viewer, stops and removes the session, and removes its
# records, its job folder and its store entry, succeeding only when claude lists the session gone; and the prompt
# history rewritten while other sessions append to it.

[[ -r "$(dirname "$0")/../Home/common/.local/bin/Declare-BashScript" ]] || {
    printf '%s: cannot find Declare-BashScript in %s\n' "${0##*/}" "$(dirname "$0")/../Home/common/.local/bin" >&2
    exit 72 # EX_OSFILE
}

# The helper sources Set-Environment from ${XDG_DATA_HOME:-$HOME/.local/share}/shell/functions. This checkout's is the
# file under review, so the test points XDG_DATA_HOME at it, for itself and for every Clear-Claude it runs.
XDG_DATA_HOME="$(cd "$(dirname "$0")/../Home/common/.local/share" && pwd)" || exit 72 # EX_OSFILE
export XDG_DATA_HOME

# shellcheck source=Declare-BashScript
source "$(dirname "$0")/../Home/common/.local/bin/Declare-BashScript" "$0" "help" "h" "$@"
require_nix
require_command git jq mktemp pkill realpath tmux

# The startup repository is git's alone: no global or system configuration reaches it.
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1

# Clear-Claude's tmux is the run's own server, never the one a terminal running this test is in; and the test is not
# the conversation it clears, whatever conversation runs it.
unset TMUX CLAUDE_CODE_SESSION_ID

###########
# Functions
###########

# cleanup ends the run's own tmux server, and removes the run's directory and its temporary output, however the run
# ends.
#
# Returns:
#   - 0.
function cleanup {
    if [[ -n "${run_directory:-}" && -d "${run_directory}" ]]; then
        tmux -S "${run_directory}/tmux/tmux-$(id -u)/default" kill-server 2>/dev/null || true
        chmod -R u+rwx -- "${run_directory}" 2>/dev/null || true
        rm -rf -- "${run_directory}"
    fi

    [[ -z "${temporary_project:-}" ]] || rm -rf -- "${temporary_project}"
}

# stage lays out what a run of Clear-Claude needs that no case changes, under the run's directory: a copy of
# Clear-Claude beside Declare-BashScript, as writ deploys them, with this platform's lock-store.sh; stand-ins for
# claude and gh first on PATH; and the startup repository, with an origin.
#
# The stand-in for claude lists one background session, 0000beef, running the conversation that session under
# STAND_IN_DIR names, until rm removes it. Its answers can be bent: STAND_IN_AGENTS_FAIL_FROM=N makes the Nth and later
# `agents` calls fail, STAND_IN_AGENTS_MALFORMED_FROM=N makes them answer what is not JSON, STAND_IN_AGENTS_DUPLICATE
# lists the session twice, STAND_IN_AGENTS_BAD_ID lists a sessionId that is no UUID; each call is counted in
# agents-calls. Its viewer draws its input line and echoes what is typed there, shows claude's command menu above it
# while a bare slash command is typed and none once the command has an argument, takes a line only when its Enter
# comes after a pause, as claude does (#412), writes the line to the prompt history under the conversation it was typed
# into, as claude does, and writes it to typed; it leaves once a line is taken, or after STAND_IN_QUIET seconds with no
# key, ten by default. A /clear it takes starts conversation NEW, with its transcript and folder, unless
# STAND_IN_IGNORE_CLEAR is set, and runs STAND_IN_ON_CLEAR, a command, when one is given. `agents`, the first time it
# lists NEW with STAND_IN_WRITERS set, starts two writers that append to the prompt history as other sessions would:
# one at once, and one that opens the file first and appends a second later, through the file it opened. stop and rm
# are written to calls; rm removes the session, unless STAND_IN_RESTART is set, as a connection that reattached would
# leave it. The stand-in for gh names the startup repository's origin, and nothing else.
#
# Parameters:
#   - `$1`: the run's directory.
#
# Returns:
#   - 0, with bin, libexec and repository under `$1`.
function stage {
    local directory="$1" platform_layer

    case "$(uname -s)" in
        Darwin) platform_layer=common.Darwin ;;
        Linux) platform_layer=common.Linux ;;
        *) error $EX_UNAVAILABLE "Clear-Claude runs on macOS and Linux." ;;
    esac

    mkdir -p -- "${directory}/bin" "${directory}/libexec/agent-schedule" "${directory}/tmux"
    cp -- "${repository_root}/Home/common.Unix/.local/bin/Clear-Claude" "${directory}/bin/Clear-Claude"
    cp -- "${repository_root}/Home/common/.local/bin/Declare-BashScript" "${directory}/bin/Declare-BashScript"
    cp -- "${repository_root}/Home/${platform_layer}/.local/libexec/agent-schedule/lock-store.sh" \
        "${directory}/libexec/agent-schedule/lock-store.sh"

    cat >"${directory}/bin/claude" <<'CLAUDE'
#!/usr/bin/env bash
case "$1" in
    agents)
        calls=$(($(cat -- "${STAND_IN_DIR}/agents-calls" 2>/dev/null || echo 0) + 1))
        printf '%s\n' "${calls}" >"${STAND_IN_DIR}/agents-calls"
        [[ -z ${STAND_IN_AGENTS_FAIL_FROM:-} ]] || ((calls < STAND_IN_AGENTS_FAIL_FROM)) || exit 1
        [[ -z ${STAND_IN_AGENTS_MALFORMED_FROM:-} ]] || ((calls < STAND_IN_AGENTS_MALFORMED_FROM)) || {
            printf 'not json\n'
            exit 0
        }
        if [[ -e ${STAND_IN_DIR}/removed ]]; then
            printf '[]\n'
            exit 0
        fi
        session="$(cat -- "${STAND_IN_DIR}/session")"
        [[ -z ${STAND_IN_AGENTS_BAD_ID:-} ]] || session=nope
        if [[ -n ${STAND_IN_WRITERS:-} && ${session} == "${STAND_IN_NEW}" && ! -e ${STAND_IN_DIR}/writers ]]; then
            : >"${STAND_IN_DIR}/writers"
            history="${CLAUDE_CONFIG_DIR}/history.jsonl"
            # Every descriptor closed or sent to /dev/null, so that Clear-Claude's read of this listing ends when
            # this process does, not when the writer does; no setsid, which macOS lacks.
            bash -c 'exec 3>>"$1"; sleep 1; printf "{\"display\":\"late\",\"sessionId\":\"%s\"}\n" "$2" >&3' \
                _ "${history}" "${STAND_IN_OTHER}" </dev/null >/dev/null 2>&1 9>&- &
            printf '{"display":"early","sessionId":"%s"}\n' "${STAND_IN_OTHER}" >>"${history}"
        fi
        entries='[{"id": $id, "kind": "background", "sessionId": $session, "state": "running"}]'
        [[ -z ${STAND_IN_AGENTS_DUPLICATE:-} ]] || entries="${entries%]*}, ${entries#[}"
        jq --null-input --compact-output --arg id "${STAND_IN_ID}" --arg session "${session}" "${entries}"
        ;;
    attach)
        stty -icanon min 1 2>/dev/null || true
        printf '❯ '
        # An Enter already waiting behind the key before it came in the same burst, as one sent with the text does,
        # and is part of the text; one that was not waiting is a press of its own, and submits. Judged by the input
        # buffer, not by the clock, so a busy host does not make a press of its own look like part of the text.
        line="" pending=0 quiet_until=$((SECONDS + ${STAND_IN_QUIET:-10}))
        while ((SECONDS < quiet_until)); do
            if ! IFS= read -r -N 1 -t 0.1 key; then
                sleep 0.02
                continue
            fi
            quiet_until=$((SECONDS + ${STAND_IN_QUIET:-10}))
            if [[ ${key} == $'\n' || ${key} == $'\r' ]]; then
                if [[ -n ${line} ]] && ((pending == 0)); then
                    printf '%s\n' "${line}" >>"${STAND_IN_DIR}/typed"
                    printf '{"display":"%s","sessionId":"%s"}\n' "${line}" "$(cat -- "${STAND_IN_DIR}/session")" \
                        >>"${CLAUDE_CONFIG_DIR}/history.jsonl"
                    if [[ ${line} == /clear ]]; then
                        if [[ -n ${STAND_IN_ON_CLEAR:-} ]]; then
                            bash -c "${STAND_IN_ON_CLEAR}" && printf 'hook ran\n' >>"${STAND_IN_DIR}/typed" ||
                                printf 'hook failed: %s\n' "$?" >>"${STAND_IN_DIR}/typed"
                        fi
                        if [[ -z ${STAND_IN_IGNORE_CLEAR:-} ]]; then
                            printf '%s\n' "${STAND_IN_NEW}" >"${STAND_IN_DIR}/session"
                            printf '%s\n' '{"type":"user"}' >"${STAND_IN_PROJECT}/${STAND_IN_NEW}.jsonl"
                            mkdir -p -- "${STAND_IN_PROJECT}/${STAND_IN_NEW}"
                        fi
                    fi
                    printf '\n❯ '
                    break
                fi
                printf 'enter in the burst: %s\n' "${line//$'\n'/|}" >>"${STAND_IN_DIR}/typed"
                line+=$'\n'
            elif [[ ${key} == [[:print:]] ]]; then
                line+="${key}"
                # The command menu, above the input line, while a bare slash command is typed.
                if [[ ${line} == /?* && ${line} != *" "* ]]; then
                    printf '\n  ❯ %s   Start a new session with empty context\n❯ %s' "${line}" "${line}"
                fi
            fi
            # Whether the next key is already waiting, which says of an Enter whether it came with this key.
            if IFS= read -r -t 0; then pending=1; else pending=0; fi
        done
        ;;
    stop)
        printf 'stop %s\n' "$2" >>"${STAND_IN_DIR}/calls"
        ;;
    rm)
        printf 'rm %s\n' "$2" >>"${STAND_IN_DIR}/calls"
        [[ -n ${STAND_IN_RESTART:-} ]] || : >"${STAND_IN_DIR}/removed"
        ;;
    *)
        printf 'stand-in claude: not handled: %s\n' "$*" >&2
        exit 1
        ;;
esac
CLAUDE

    cat >"${directory}/bin/gh" <<'GH'
#!/usr/bin/env bash
# The startup repository's origin, as Clear-Claude asks for it: by name, or for the directory it runs in.
if [[ $1 == repo && $2 == view && ($3 == --json || $3 == example/clear-claude-test) ]]; then
    printf 'example/clear-claude-test\n'
    exit 0
fi
printf 'stand-in gh: not handled: %s\n' "$*" >&2
exit 1
GH
    chmod +x -- "${directory}/bin/Clear-Claude" "${directory}/bin/claude" "${directory}/bin/gh"

    git init --quiet "${directory}/repository"
    git -C "${directory}/repository" remote add origin https://github.com/example/clear-claude-test.git
}

# seed lays out, afresh, what a case clears: schedule 7's store entry, holding the stand-in's session; the session's
# conversation, OLD, with its transcript and folder, file history, session environment, temporary output, prompts and
# one memory, and its job folder with one scratch file; another conversation, OTHER, with its transcript, a prompt and
# a memory, a memory that only mentions OLD in its body, and an unrelated project with an empty memory folder, none of
# which any case may touch; and a project entry that is a symlink to a folder outside claude's tree, holding OLD's
# transcript, which no case may follow. The stand-in's records are cleared, and it runs OLD again.
#
# Returns:
#   - 0.
function seed {
    rm -rf -- "${CLAUDE_CONFIG_DIR}" "${XDG_STATE_HOME}" "${temporary_project}" "${outside}"
    rm -f -- "${STAND_IN_DIR}/typed" "${STAND_IN_DIR}/calls" "${STAND_IN_DIR}/removed" "${STAND_IN_DIR}/agents-calls" \
        "${STAND_IN_DIR}/writers"
    printf '%s\n' "${old}" >"${STAND_IN_DIR}/session"

    mkdir -p -- "${store}" "${projects}/${old}" "${projects}/memory" "${CLAUDE_CONFIG_DIR}/file-history/${old}" \
        "${CLAUDE_CONFIG_DIR}/session-env/${old}" "${CLAUDE_CONFIG_DIR}/jobs/${short}/tmp" \
        "${temporary_project}/${old}" "${CLAUDE_CONFIG_DIR}/projects/unrelated/memory" "${outside}/${old}"
    printf '%s\n' "${short}" >"${store}/7"

    printf '%s\n' '{"type":"user"}' >"${projects}/${old}.jsonl"
    printf '%s\n' '{"type":"user"}' >"${projects}/${other}.jsonl"
    : >"${projects}/${old}/tool-result.txt"
    : >"${CLAUDE_CONFIG_DIR}/file-history/${old}/edit"
    : >"${CLAUDE_CONFIG_DIR}/session-env/${old}/environment"
    : >"${CLAUDE_CONFIG_DIR}/jobs/${short}/tmp/scratch"
    : >"${CLAUDE_CONFIG_DIR}/jobs/${short}/state.json"
    : >"${temporary_project}/${old}/output"
    : >"${outside}/${old}.jsonl"
    ln -s -- "${outside}" "${CLAUDE_CONFIG_DIR}/projects/elsewhere"

    printf -- '---\nname: written\nmetadata:\n  originSessionId: %s\n---\n' "${old}" >"${projects}/memory/written.md"
    printf -- '---\nname: kept\nmetadata:\n  originSessionId: %s\n---\n' "${other}" >"${projects}/memory/kept.md"
    printf -- '---\nname: mentions\nmetadata:\n  originSessionId: %s\n---\n\nSee originSessionId: %s in another.\n' \
        "${other}" "${old}" >"${projects}/memory/mentions.md"
    printf '%s\n' '- [Written](written.md) — by the cleared conversation' '- [Kept](kept.md) — by another' \
        '- [Mentions](mentions.md) — names the cleared conversation' >"${projects}/memory/MEMORY.md"
    : >"${CLAUDE_CONFIG_DIR}/projects/unrelated/memory/MEMORY.md"

    jq --null-input --compact-output --arg old "${old}" --arg other "${other}" \
        '{display: "one", sessionId: $old}, {display: "two", sessionId: $other}' \
        >"${CLAUDE_CONFIG_DIR}/history.jsonl"
    printf '{ "display": "spaced", "sessionId": "%s" }\n' "${old}" >>"${CLAUDE_CONFIG_DIR}/history.jsonl"
    printf 'not json at all\n' >>"${CLAUDE_CONFIG_DIR}/history.jsonl"
}

# probe runs Clear-Claude in the startup repository with the arguments a case gives, its standard input closed, and
# checks its exit status.
#
# Parameters:
#   - `$1`: the name of the variable each problem is added to, each ending "; ".
#   - `$2`: the exit status the case expects.
#   - `$@` after them: Clear-Claude's arguments, `--directory` among them when the case gives one.
#
# Returns:
#   - 0, with what the run wrote to standard error in the caller's `written`.
# shellcheck disable=SC2034 # problem_list is a nameref: each addition is the caller's variable's.
function probe {
    local -n problem_list="$1"
    local expected_status="$2" status=0
    shift 2

    case " $* " in
        *" --directory "*) Clear-Claude "$@" </dev/null >/dev/null 2>"${run_directory}/case.err" || status=$? ;;
        *) Clear-Claude --directory "${repository}" "$@" </dev/null >/dev/null 2>"${run_directory}/case.err" ||
            status=$? ;;
    esac
    # What the run wrote, and what the stand-in saw: the lines typed into its viewer and the claude calls it took,
    # for a failed case's report.
    written="$(cat "${run_directory}/case.err")"
    written+=$'\n'"stand-in typed: $(tr '\n' '|' <"${STAND_IN_DIR}/typed" 2>/dev/null || true)"
    written+=$'\n'"stand-in calls: $(tr '\n' '|' <"${STAND_IN_DIR}/calls" 2>/dev/null || true)"

    ((status == expected_status)) || problem_list+="its status was ${status}, not ${expected_status}; "
}

# expect_gone and expect_kept add a problem for each path that is there, or is not, each ending "; ".
#
# Parameters:
#   - `$1`: the name of the variable each problem is added to.
#   - `$@` after it: the paths.
#
# Returns:
#   - 0.
# shellcheck disable=SC2034 # problem_list is a nameref: each addition is the caller's variable's.
function expect_gone {
    local -n problem_list="$1"
    local path
    shift 1

    for path in "$@"; do
        [[ ! -e ${path} ]] || problem_list+="${path#"${run_directory}"/} is still there; "
    done
}

# shellcheck disable=SC2034 # problem_list is a nameref: each addition is the caller's variable's.
function expect_kept {
    local -n problem_list="$1"
    local path
    shift 1

    for path in "$@"; do
        [[ -e ${path} ]] || problem_list+="${path#"${run_directory}"/} is gone; "
    done
}

# report prints a case as passed, or as failed with what went wrong and what the run wrote, counting it in `failures`.
#
# Parameters:
#   - `$1`: the case's name.
#   - `$2`: what went wrong, each problem ending "; ", or nothing.
#   - `$3`: what the run wrote to standard error.
#
# Returns:
#   - 0.
function report {
    local name="$1" problem="$2" written="$3"
    case_count=$((case_count + 1))

    if [[ -z "${problem}" ]]; then
        success "${name}"
        return 0
    fi

    error 0 "${name}: ${problem%; }:"
    printf '    %s\n' "${written//$'\n'/$'\n'    }" >&2
    failures=$((failures + 1))
}

# untouched adds a problem for each of the old conversation's records that is gone, for a memory, index line or
# scratch file not back in its place, for a staging folder left behind, and for a store entry that no longer holds the
# session: what a refusal must leave.
#
# Parameters:
#   - `$1`: the name of the variable each problem is added to.
#
# Returns:
#   - 0.
# shellcheck disable=SC2034 # problem_list is a nameref: each addition is the caller's variable's.
function untouched {
    local -n problem_list="$1"

    expect_kept "$1" "${projects}/${old}.jsonl" "${projects}/${old}" "${projects}/memory/written.md" \
        "${CLAUDE_CONFIG_DIR}/file-history/${old}" "${CLAUDE_CONFIG_DIR}/session-env/${old}" \
        "${CLAUDE_CONFIG_DIR}/jobs/${short}/tmp/scratch" "${temporary_project}/${old}"
    grep --quiet --fixed-strings '](written.md)' -- "${projects}/memory/MEMORY.md" 2>/dev/null ||
        problem_list+="the conversation's memory is gone from the index; "
    grep --quiet --fixed-strings "\"sessionId\":\"${old}\"" -- "${CLAUDE_CONFIG_DIR}/history.jsonl" 2>/dev/null ||
        problem_list+="the conversation's prompts are gone from the prompt history; "
    [[ -z "$(printf '%s\n' "${CLAUDE_CONFIG_DIR}/jobs/${short}"/clear-*)" ]] ||
        problem_list+="a staging folder is left behind; "
    [[ "$(cat -- "${store}/7" 2>/dev/null || true)" == "${short}" ]] ||
        problem_list+="schedule 7's entry no longer holds ${short}; "
}

# the_others_kept adds a problem for each record that is not the cleared conversation's and is gone: the other
# conversation's, the memory that only mentions the id, the unrelated empty memory folder, and the folder outside
# claude's tree behind the symlinked project entry.
#
# Parameters:
#   - `$1`: the name of the variable each problem is added to.
#
# Returns:
#   - 0.
# shellcheck disable=SC2034 # problem_list is a nameref: each addition is the caller's variable's.
function the_others_kept {
    local -n problem_list="$1"

    expect_kept "$1" "${projects}/${other}.jsonl" "${projects}/memory/kept.md" "${projects}/memory/mentions.md" \
        "${CLAUDE_CONFIG_DIR}/projects/unrelated/memory" "${outside}/${old}.jsonl" "${outside}/${old}"
    grep --quiet --fixed-strings '](kept.md)' -- "${projects}/memory/MEMORY.md" 2>/dev/null ||
        problem_list+="the other conversation's memory is gone from the index; "
    grep --quiet --fixed-strings '](mentions.md)' -- "${projects}/memory/MEMORY.md" 2>/dev/null ||
        problem_list+="the memory that only mentions the id is gone from the index; "
    [[ "$(jq --raw-output --arg other "${other}" 'select(.sessionId == $other) | .display' \
        "${CLAUDE_CONFIG_DIR}/history.jsonl" 2>/dev/null | head -n 1)" == two ]] ||
        problem_list+="the other conversation's prompt is gone from the prompt history; "
    grep --quiet --line-regexp --fixed-strings 'not json at all' -- "${CLAUDE_CONFIG_DIR}/history.jsonl" 2>/dev/null ||
        problem_list+="the prompt history's line that is not JSON is gone; "
}

# cleared adds a problem for each record of the old conversation that is still there after a confirmed clear, for the
# scratch not gone, for the new conversation's files not kept, and for anything the others' must keep.
#
# Parameters:
#   - `$1`: the name of the variable each problem is added to.
#
# Returns:
#   - 0.
# shellcheck disable=SC2034 # problem_list is a nameref: each addition is the caller's variable's.
function cleared {
    local -n problem_list="$1"

    [[ "$(cat -- "${STAND_IN_DIR}/typed" 2>/dev/null || true)" == /clear ]] ||
        problem_list+="'$(cat -- "${STAND_IN_DIR}/typed" 2>/dev/null || true)' was typed, not /clear taken alone; "
    expect_gone "$1" "${projects}/${old}.jsonl" "${projects}/${old}" "${projects}/memory/written.md" \
        "${CLAUDE_CONFIG_DIR}/file-history/${old}" "${CLAUDE_CONFIG_DIR}/session-env/${old}" \
        "${CLAUDE_CONFIG_DIR}/jobs/${short}/tmp/scratch" "${temporary_project}/${old}"
    expect_kept "$1" "${CLAUDE_CONFIG_DIR}/jobs/${short}/tmp" "${CLAUDE_CONFIG_DIR}/jobs/${short}/state.json" \
        "${projects}/${new}.jsonl" "${projects}/${new}"
    [[ -z "$(printf '%s\n' "${CLAUDE_CONFIG_DIR}/jobs/${short}"/clear-*)" ]] ||
        problem_list+="a staging folder is left behind; "
    ! grep --quiet --fixed-strings "${old}" -- "${CLAUDE_CONFIG_DIR}/history.jsonl" ||
        problem_list+="the conversation's prompts, /clear's own among them, are still in the prompt history; "
    ! grep --quiet --fixed-strings '](written.md)' -- "${projects}/memory/MEMORY.md" ||
        problem_list+="the conversation's memory is still in the index; "
    the_others_kept "$1"
    [[ "$(cat -- "${store}/7" 2>/dev/null || true)" == "${short}" ]] ||
        problem_list+="schedule 7's entry no longer holds ${short}; "
    [[ ! -e ${STAND_IN_DIR}/calls ]] ||
        problem_list+="the session was stopped or removed: $(tr '\n' ' ' 2>/dev/null <"${STAND_IN_DIR}/calls"); "
    [[ -z "$(tmux list-sessions 2>/dev/null || true)" ]] || problem_list+="a viewer was left open; "
}

######
# Main
######

case_count=0
failures=0
repository_root="$(cd "$(dirname "$0")/.." && pwd)"
run_directory=""
temporary_project=""

Set-Traps cleanup
run_directory="$(mktemp -d)"
stage "${run_directory}"

# A glob that matches nothing is nothing, so a check for a staging folder or a temporary file left behind finds none.
shopt -s nullglob

# Ids no real session has, so that pkill, and every removal, can reach only the test's own.
short=0000beef
old=0000beef-0000-4000-8000-0000000000a1
new=1111cafe-0000-4000-8000-0000000000a2
other=2222f00d-0000-4000-8000-0000000000a3

repository="${run_directory}/repository"
projects="${run_directory}/config/projects/test-project"
outside="${run_directory}/outside"
store="${run_directory}/state/agent-schedule/example/clear-claude-test"
temporary_project="/tmp/claude-$(id -u)/clear-claude-test-${run_directory##*/}"
export PATH="${run_directory}/bin:${PATH}" XDG_STATE_HOME="${run_directory}/state" TMUX_TMPDIR="${run_directory}/tmux"
export CLAUDE_CONFIG_DIR="${run_directory}/config" STAND_IN_DIR="${run_directory}" STAND_IN_ID="${short}"
export STAND_IN_NEW="${new}" STAND_IN_OTHER="${other}" STAND_IN_PROJECT="${projects}"

# The refusals of usage.
for arguments in "" "--schedule seven" "--schedule 7 --clear --retire"; do
    problem="" written=""
    seed
    # shellcheck disable=SC2086 # each case's arguments are words.
    probe problem 64 ${arguments}
    untouched problem
    report "refused as usage: Clear-Claude ${arguments:-with no --schedule}" "${problem}" "${written}"
done

# The refusals of the directory, and of a store entry that holds no id.
problem="" written=""
seed
probe problem 66 --directory /no/such/directory --schedule 7
untouched problem
report "no such directory: refused, nothing touched" "${problem}" "${written}"

problem="" written=""
seed
probe problem 66 --directory "${run_directory}" --schedule 7
untouched problem
report "a directory that is no repository root: refused, nothing touched" "${problem}" "${written}"

problem="" written=""
seed
printf 'garbage\n' >"${store}/7"
probe problem 65 --schedule 7
expect_kept problem "${projects}/${old}.jsonl" "${projects}/memory/written.md"
report "a store entry that holds no session id: refused, nothing touched" "${problem}" "${written}"

# A schedule with no store entry has nothing to remove.
problem="" written=""
seed
rm -f -- "${store}/7"
probe problem 0 --schedule 8
expect_kept problem "${projects}/${old}.jsonl" "${projects}/memory/written.md"
report "no store entry: nothing removed" "${problem}" "${written}"

# --clear, the default, and --clear given, with the stand-in's command menu in the way.
for arguments in "--schedule 7" "--schedule 7 --clear" "--schedule example/clear-claude-test#7"; do
    problem="" written=""
    seed
    # shellcheck disable=SC2086 # each case's arguments are words.
    probe problem 0 ${arguments}
    cleared problem
    report "--clear: Clear-Claude ${arguments}" "${problem}" "${written}"
done

# The viewer cannot open: tmux is not there.
problem="" written=""
