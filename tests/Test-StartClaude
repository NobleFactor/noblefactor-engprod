# Test-StartClaude - Tests Start-Claude against a stand-in for claude, on macOS and Linux: every form --resume takes and
# each of its refusals, the background session's short id alone on standard output, detached and attached, and the
# refusals of usage (David-Noble-at-work/personal#273, questions 11 and 12); every way in, with a schedule and without,
# and row 2 of personal#259's plan, a conversation resumed in another clone that --continue finds there
# (NobleFactor/noblefactor-ops#322); a --detach wake of a stopped session, which passes no flag and renames the session
# with its first prompt when claude lists it under another name; and a running session so listed, renamed in a viewer
# (NobleFactor/noblefactor-engprod#384). Test-StartClaude.ps1 runs the same cases, from the same table, against
# Start-Claude.ps1 on Windows.

[[ -r "$(dirname "$0")/../Home/common/.local/bin/Declare-BashScript" ]] || {
    printf '%s: cannot find Declare-BashScript in %s\n' "${0##*/}" "$(dirname "$0")/../Home/common/.local/bin" >&2
    exit 72 # EX_OSFILE
}

# The helper sources Set-Environment from ${XDG_DATA_HOME:-$HOME/.local/share}/shell/functions. This checkout's is the
# file under review, so the test points XDG_DATA_HOME at it, for itself and for every Start-Claude it runs.
XDG_DATA_HOME="$(cd "$(dirname "$0")/../Home/common/.local/share" && pwd)" || exit 72 # EX_OSFILE
export XDG_DATA_HOME

# shellcheck source=Declare-BashScript
source "$(dirname "$0")/../Home/common/.local/bin/Declare-BashScript" "$0" "help" "h" "$@"
require_nix
require_command git jq mktemp script tmux

# The startup repository is git's alone: no global or system configuration reaches it.
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1

# Start-Claude attaches unless it runs inside tmux, where it switches the client instead: these cases attach.
unset TMUX

###########
# Functions
###########

# cleanup ends the run's own tmux server and removes the run's directory, however the run ends.
#
# Set as the EXIT trap through Set-Traps, so it runs when every case passed, when one failed, and when an error or a
# signal stopped the run. The server is named by its socket, under the run's directory, so no other tmux server is ever
# reached.
#
# Returns:
#   - 0, the run's tmux server ended and its directory gone.
function cleanup {
    if [[ -n "${run_directory:-}" && -d "${run_directory}" ]]; then
        tmux -S "${run_directory}/tmux/tmux-$(id -u)/default" kill-server 2>/dev/null || true
        rm -rf -- "${run_directory}"
    fi
}

# record_titles writes a transcript that records the names a conversation was given, in order.
#
# Parameters:
#   - `$1`: the project folder.
#   - `$2`: the conversation's id, which names the transcript.
#   - `$@` after them: the names, the last the conversation's own.
#
# Returns:
#   - 0, with `$1/$2.jsonl` written.
function record_titles {
    local folder="$1" session="$2" title
    shift 2

    for title in "$@"; do
        jq --null-input --compact-output --arg title "${title}" --arg session "${session}" \
            '{type: "custom-title", customTitle: $title, sessionId: $session}'
    done >"${folder}/${session}.jsonl"
}

# stage lays out what one run of Start-Claude needs, under the run's directory.
#
# A copy of Start-Claude beside Declare-BashScript, as writ deploys them, with this platform's lock-store.sh and the
# Linux layer's keychain.sh, which finds nothing to unlock, since the keychain is not under test; stand-ins for claude
# and gh first on PATH; claude's configuration, with the transcripts the cases name; a store; a tmux server of its own;
# and the startup repository, with an origin, since Start-Claude names the repository from it.
#
# The stand-in for claude lists one background session, abcd1234, named "probe session", whose conversation,
# abcd1234-0000-4000-8000-000000000009, has no transcript, and the case can change it through the STAND_IN variables:
# STAND_IN_STATE lists it stopped, STAND_IN_NAME names it, and STAND_IN_LOG names a file where each claude --bg it is
# given is written, one line each, its arguments joined by the unit separator.
# Its viewer draws its input line and echoes what is typed there; it takes a line only when its Enter is a press of
# its own, not one sent with the text, as claude does (#412), writing it to typed under STAND_IN_DIR, and leaves after
# ten seconds with no key; a
# `/rename <name>` it takes renames the session, as claude does, through renamed there. A
# background resume answers as claude does, its short id the conversation's first eight characters; one of the listed
# session that carries a flag starts a copy, cccc0000, as claude does (anthropics/claude-code#104658); and a new
# conversation comes up as background session fedc4321. The stand-in for gh answers for schedule 7 of the startup
# repository's origin, and for nothing else. A second clone of the repository, a directory claude lists nothing in,
# and, in the second clone's own project folder, the newest transcript of all, are row 2's.
#
# Parameters:
#   - `$1`: the run's directory.
#
# Returns:
#   - 0, with bin, libexec, config, state, tmux and repository under `$1`.
function stage {
    local directory="$1" platform_layer projects

    # This platform's layer, as writ deploys it: the store's lock is lockf on macOS and flock on Linux.
    case "$(uname -s)" in
        Darwin) platform_layer=common.Darwin ;;
        Linux) platform_layer=common.Linux ;;
        *) error $EX_UNAVAILABLE "Start-Claude runs on macOS and Linux; Test-StartClaude.ps1 tests Start-Claude.ps1." ;;
    esac

    mkdir -p -- "${directory}/bin" "${directory}/libexec/agent-schedule" "${directory}/state" "${directory}/tmux"
    cp -- "${repository_root}/Home/common.Unix/.local/bin/Start-Claude" "${directory}/bin/Start-Claude"
    cp -- "${repository_root}/Home/common/.local/bin/Declare-BashScript" "${directory}/bin/Declare-BashScript"
    cp -- "${repository_root}/Home/${platform_layer}/.local/libexec/agent-schedule/lock-store.sh" \
        "${directory}/libexec/agent-schedule/lock-store.sh"
    cp -- "${repository_root}/Home/common.Linux/.local/libexec/agent-schedule/keychain.sh" \
        "${directory}/libexec/agent-schedule/keychain.sh"

    cat >"${directory}/bin/claude" <<'CLAUDE'
#!/usr/bin/env bash
case "$1" in
    agents)
        name="${STAND_IN_NAME}"
        [[ ! -s ${STAND_IN_DIR}/renamed ]] || name="$(cat -- "${STAND_IN_DIR}/renamed")"
        jq --null-input --compact-output --arg id "${STAND_IN_ID}" --arg cwd "${STAND_IN_CWD}" \
            --arg session "${STAND_IN_SESSION}" --arg name "${name}" \
            --arg state "${STAND_IN_STATE:-running}" \
            '[{id: $id, cwd: $cwd, kind: "background", startedAt: 1760000000000, sessionId: $session, name: $name,
               state: $state}]'
        ;;
    attach)
        # It draws its input line and echoes what is typed there, as claude does. It reads key by key: an Enter already
        # waiting behind the key before it came in the same burst, as one sent with the text does, and is part of the
        # text; one that was not waiting is a press of its own, and submits the line (#412). Judged by the input
        # buffer, not by the clock, so a busy host does not make a press of its own look like part of the text. It
        # reads on past an end of input, which script(1), given no input, hands its terminal, and leaves once a line is
        # submitted, or after ten seconds with no key, which a slow CI runner needs (#414).
        stty -icanon min 1 2>/dev/null || true
        printf '❯ '
        line="" pending=0 quiet_until=$((SECONDS + 10))
        while ((SECONDS < quiet_until)); do
            if ! IFS= read -r -N 1 -t 0.1 key; then
                sleep 0.02
                continue
            fi
            quiet_until=$((SECONDS + 10))
            if [[ ${key} == $'\n' || ${key} == $'\r' ]]; then
                if [[ -n ${line} ]] && ((pending == 0)); then
                    printf '%s\n' "${line}" >>"${STAND_IN_DIR}/typed"
                    [[ ${line} != "/rename "* ]] || printf '%s' "${line#/rename }" >"${STAND_IN_DIR}/renamed"
                    printf '❯ '
                    break
                fi
                line+=$'\n'
            elif [[ ${key} == [[:print:]] ]]; then
                line+="${key}"
            fi
            # Whether the next key is already waiting, which says of an Enter whether it came with this key.
            if IFS= read -r -t 0; then pending=1; else pending=0; fi
        done
        ;;
    --bg)
        [[ -z ${STAND_IN_LOG:-} ]] || (IFS=$'\x1f' && printf '%s\n' "$*") >>"${STAND_IN_LOG}"
        started=fedc4321
        resumed=""
        while (($#)); do
            [[ $1 != --continue ]] || {
                printf 'stand-in claude: --bg --continue is not handled\n' >&2
                exit 1
            }
            if [[ $1 == --resume ]]; then
                started="$2"
                resumed="$2"
                shift
            elif [[ $1 == -* && (${resumed} == "${STAND_IN_ID}" || ${resumed} == "${STAND_IN_SESSION}") ]]; then
                printf 'note: background session %s keeps its own saved options, so the flags you passed started' \
                    "${STAND_IN_ID}"
                printf ' a copy as cccc0000.\n'
                started=cccc0000
                break
            fi
            shift
        done
        printf 'backgrounded · %s\n  claude attach %s\n' "${started:0:8}" "${started:0:8}"
        ;;
    *)
        printf 'stand-in claude: not handled: %s\n' "$*" >&2
        exit 1
        ;;
esac
CLAUDE

    cat >"${directory}/bin/gh" <<'GH'
#!/usr/bin/env bash
# Schedule 7 of the startup repository's origin, as Start-Claude reads it: its title, link and labels, separated by
# tabs, as gh's --jq gives them.
if [[ $1 == issue && $2 == view && $3 == 7 && $4 == --repo && $5 == example/start-claude-test ]]; then
    printf 'Schedule: probe\thttps://github.com/example/start-claude-test/issues/7\tchore\n'
    exit 0
fi
printf 'stand-in gh: not handled: %s\n' "$*" >&2
exit 1
GH
    chmod +x -- "${directory}/bin/Start-Claude" "${directory}/bin/claude" "${directory}/bin/gh"

    projects="${directory}/config/projects/test-project"
    mkdir -p -- "${projects}"
    record_titles "${projects}" eeee5555-0000-4000-8000-000000000002 "probe transcript"
    record_titles "${projects}" ffff6666-0000-4000-8000-000000000003 "twin name"
    record_titles "${projects}" ffff7777-0000-4000-8000-000000000004 "twin name"
    record_titles "${projects}" 99998888-0000-4000-8000-000000000005 "old name" "new name"
    printf '%s\n' '{"type":"user"}' >"${projects}/notes.jsonl"

    git init --quiet "${directory}/repository"
    git -C "${directory}/repository" remote add origin https://github.com/example/start-claude-test.git

    # Row 2's: the second clone, the directory claude lists nothing in, and the newest transcript, written last.
    git init --quiet "${directory}/clone"
    git -C "${directory}/clone" remote add origin https://github.com/example/start-claude-test.git
    mkdir -p -- "${directory}/elsewhere" "${directory}/config/projects/clone-project"
    record_titles "${directory}/config/projects/clone-project" aaaa1111-0000-4000-8000-00000000000a "newest transcript"
}

# trim prints its argument without the spaces around it.
#
# Parameters:
#   - `$1`: the text.
#
# Returns:
#   - stdout: the text, its leading and trailing spaces gone.
function trim {
    local text="$1"

    text="${text#"${text%%[![:space:]]*}"}"
    printf '%s' "${text%"${text##*[![:space:]]}"}"
}

# report prints a case as passed, or as failed with what went wrong and what the run wrote, counting it in `failures`.
#
# Parameters:
#   - `$1`: the case's name.
#   - `$2`: what went wrong, each problem ending "; ", or nothing.
#   - `$3`: what the run wrote to standard error.
#
# Returns:
#   - 0.
function report {
    local name="$1" problem="$2" written="$3"

    if [[ -z "${problem}" ]]; then
        success "${name}"
        return 0
    fi

    error 0 "${name}: ${problem%; }:"
    printf '    %s\n' "${written//$'\n'/$'\n'    }" >&2
    failures=$((failures + 1))
}

# probe runs Start-Claude in a directory with the arguments a case gives, its standard input closed, then checks its
# exit status and that standard output holds the id the case expects, alone, or nothing at a refusal.
#
# Parameters:
#   - `$1`: the name of the variable each problem is added to, each ending "; ".
#   - `$2`: the startup directory.
#   - `$3`: what the case expects: the background session's short id, or a refusal: usage, 64; not-found, 66; or
#     data-error, 65.
#   - `$@` after them: Start-Claude's arguments.
#
# Returns:
#   - 0, with what the run wrote to standard error in the caller's `written`.
# shellcheck disable=SC2034 # problem_list is a nameref: each addition is the caller's variable's.
function probe {
    local -n problem_list="$1"
    local directory="$2" expected="$3" output status=0 expected_status=0
    shift 3

    case ${expected} in
        usage) expected_status=64 ;;
        data-error) expected_status=65 ;;
        not-found) expected_status=66 ;;
    esac

    output="$(Start-Claude --directory "${directory}" "$@" </dev/null 2>"${run_directory}/case.err")" || status=$?
    written="$(cat "${run_directory}/case.err")"

    if ((status != expected_status)); then
        problem_list+="its status was ${status}, not ${expected_status}; "
    fi

    if ((expected_status == 0)) && [[ "${output}" != "${expected}" ]]; then
        problem_list+="standard output held '${output}', not ${expected} alone; "
    elif ((expected_status != 0)) && [[ -n "${output}" ]]; then
        problem_list+="standard output held '${output}' at a refusal; "
    fi
}

# run_case runs a case in the startup repository, as probe runs one, and reports it.
#
# Parameters:
#   - `$1`: the case's name.
#   - `$2`: what the case expects, as probe takes it.
#   - `$@` after them: Start-Claude's arguments.
#
# Returns:
#   - 0, having reported the case.
function run_case {
    local name="$1" problem="" written=""
    shift 1
    case_count=$((case_count + 1))

    probe problem "${repository}" "$@"
    report "${name}" "${problem}" "${written}"
}

# run_store_case runs a case in a directory, as probe runs one, then checks schedule 7's entry in the store: the id it
# must hold, or no entry at all, and reports the case.
#
# Parameters:
#   - `$1`: the case's name.
#   - `$2`: the startup directory.
#   - `$3`: the id schedule 7's entry must hold, or nothing when there must be no entry.
#   - `$4`: what the case expects, as probe takes it.
#   - `$@` after them: Start-Claude's arguments.
#
# Returns:
#   - 0, having reported the case.
function run_store_case {
    local name="$1" directory="$2" held="$3" problem="" written="" entry_held
    shift 3
    case_count=$((case_count + 1))

    probe problem "${directory}" "$@"

    if [[ -n ${held} ]]; then
        entry_held="$(cat -- "${store}/7" 2>/dev/null || true)"
        [[ ${entry_held} == "${held}" ]] || problem+="schedule 7's entry held '${entry_held}', not ${held}; "
    elif [[ -e ${store}/7 ]]; then
        problem+="schedule 7 has an entry, holding '$(cat -- "${store}/7")', where it must have none; "
    fi

    report "${name}" "${problem}" "${written}"
}

# clear_store removes every entry in the store, so that a case begins with no schedule's session recorded, and the
# stand-in's record of what was typed into its viewer and the name it took.
#
# Returns:
#   - 0.
function clear_store {
    rm -rf -- "${XDG_STATE_HOME}/agent-schedule"
    rm -f -- "${STAND_IN_DIR}/typed" "${STAND_IN_DIR}/renamed"
}

# seed_entry records a session as schedule 7's, as Start-Claude records one.
#
# Parameters:
#   - `$1`: the session's id: a background session's short id, or a conversation's id.
#
# Returns:
#   - 0.
function seed_entry {
    mkdir -p -- "${store}"
    printf '%s\n' "$1" >"${store}/7"
}

# run_wake_case runs a --detach launch of schedule 7, whose entry holds the stand-in's session, listed stopped under a
# name, as probe runs one, then checks the claude --bg that woke it (#384). The wake carries no flag, which would start
# a copy, and its first prompt is `/rename` with the launch's name, the schedule's key first and its title last, when
# the listed name is another, or nothing when it is the launch's. The first case sets `launch_name` from the prompt,
# for the cases after it.
#
# Parameters:
#   - `$1`: the case's name.
#   - `$2`: the name the stand-in lists the session under.
#   - `$3`: what the wake's prompt must be: rename, or none.
#
# Returns:
#   - 0, having reported the case.
function run_wake_case {
    local name="$1" listed="$2" expected="$3" problem="" written="" woke="" prompt="" index
    local log="${run_directory}/claude-bg.log"
    local -a argument_list=()
    case_count=$((case_count + 1))

    clear_store
    seed_entry abcd1234
    : >"${log}"
    export STAND_IN_STATE=stopped STAND_IN_LOG="${log}" STAND_IN_NAME="${listed}"
    probe problem "${repository}" abcd1234 --detach --schedule 7
    unset STAND_IN_STATE STAND_IN_LOG
    STAND_IN_NAME="probe session"

    # The stand-in's record: --bg, --resume, the conversation, then what the wake gave beyond them.
    woke="$(grep -F -- --resume "${log}" | tail -n 1 || true)"
    IFS=$'\x1f' read -r -a argument_list <<<"${woke}"

    for ((index = 3; index < ${#argument_list[@]}; index++)); do
        [[ ${argument_list[index]} != -* ]] || problem+="the wake carried ${argument_list[index]}, which starts a copy; "
    done

    prompt="${argument_list[3]:-}"

    if [[ -z ${woke} ]]; then
        problem+="no claude --bg --resume woke the stopped session; "
    elif [[ ${expected} == none && -n ${prompt} ]]; then
        problem+="the wake's prompt was '${prompt}', where claude lists the launch's name; "
    elif [[ ${expected} == rename && ${prompt} != "/rename example/start-claude-test#7 | "*" | Schedule: probe" ]]; then
        problem+="the wake's prompt was '${prompt}', not /rename with the launch's name; "
    fi

    [[ ${expected} != rename || -n ${launch_name} ]] || launch_name="${prompt#/rename }"

    [[ "$(cat -- "${store}/7" 2>/dev/null || true)" == abcd1234 ]] ||
        problem+="schedule 7's entry no longer holds abcd1234; "

    report "${name}" "${problem}" "${written}"
}

# run_rename_case runs a --detach launch of schedule 7, whose entry holds the stand-in's session, listed running under
# a name, as probe runs one, then checks what was typed into its viewer (#384, requirement 2): `/rename` with the
# launch's name when the listed name is another, and nothing when it is the launch's. No viewer may be left on the
# run's tmux server.
#
# Parameters:
#   - `$1`: the case's name.
#   - `$2`: the name the stand-in lists the session under.
#   - `$3`: what must be typed: rename, or none.
#
# Returns:
#   - 0, having reported the case.
function run_rename_case {
    local name="$1" listed="$2" expected="$3" problem="" written="" typed remaining
    case_count=$((case_count + 1))

    clear_store
    seed_entry abcd1234
    export STAND_IN_NAME="${listed}"
    probe problem "${repository}" abcd1234 --detach --schedule 7
    STAND_IN_NAME="probe session"

    typed="$(cat -- "${STAND_IN_DIR}/typed" 2>/dev/null || true)"

    if [[ ${expected} == none && -n ${typed} ]]; then
        problem+="'${typed}' was typed into a viewer, where claude lists the launch's name; "
    elif [[ ${expected} == rename && ${typed} != "/rename ${launch_name}" ]]; then
        problem+="'${typed}' was typed into a viewer, not /rename with the launch's name; "
    fi

    remaining="$(tmux -S "${tmux_socket}" list-sessions -F '#{session_name}' 2>/dev/null | tr '\n' ' ' || true)"
    [[ -z "${remaining}" ]] || problem+="tmux sessions remain: ${remaining}; "

    report "${name}" "${problem}" "${written}"
}

# run_attached_case runs Start-Claude attached, in a pseudo-terminal of its own, onto the stand-in's background
# session: the viewer leaves after the line typed into it, or two seconds, which ends the tmux session, and the
# session's short id must then be on standard output, alone, with no tmux session left on the run's server. What was
# typed into the viewer must be `/rename` with the launch's name, or nothing (#384, requirement 2).
#
# script(1) gives the pseudo-terminal: util-linux's, which knows --version, takes the command with -c and runs it with
# $SHELL, set here to this bash, since a login shell's startup files would put another claude first on PATH; BSD's
# takes the command after the log file. The pseudo-terminal's type is set too, xterm-256color, which tmux can attach
# through: a run with no terminal of its own, as over ssh with none, has no TERM to hand on.
#
# Parameters:
#   - `$1`: the case's name.
#   - `$2`: what must be typed into the viewer: rename, or none.
#   - `$@` after them: Start-Claude's arguments after --directory.
#
# Returns:
#   - 0, having reported the case.
function run_attached_case {
    local name="$1" expected="$2" command argument output status written waited problem="" pid remaining typed
    local out="${run_directory}/attached.out" err="${run_directory}/attached.err"
    local status_file="${run_directory}/attached.status"
    shift 2
    case_count=$((case_count + 1))
    rm -f -- "${status_file}"

    printf -v command '%q --directory %q' "${run_directory}/bin/Start-Claude" "${repository}"

    for argument in "$@"; do
        printf -v command '%s %q' "${command}" "${argument}"
    done

    # shellcheck disable=SC2016 # $? is the command's own, expanded in the pseudo-terminal's shell.
    printf -v command '%s >%q 2>%q; echo $? >%q' "${command}" "${out}" "${err}" "${status_file}"

    if script --version >/dev/null 2>&1; then
        TERM=xterm-256color SHELL="${BASH}" script -q -e -c "${command}" /dev/null </dev/null >/dev/null 2>&1 &
    else
        TERM=xterm-256color script -q /dev/null bash -c "${command}" </dev/null >/dev/null 2>&1 &
    fi

    pid=$!

    for ((waited = 0; waited < 30; waited++)); do
        [[ -s "${status_file}" ]] && break
        sleep 1
    done

    kill "${pid}" 2>/dev/null || true
    wait "${pid}" 2>/dev/null || true

    status="$(cat "${status_file}" 2>/dev/null || printf 'none: it never ended')"
    output="$(cat "${out}" 2>/dev/null || true)"
    written="$(cat "${err}" 2>/dev/null || true)"

    [[ "${status}" == 0 ]] || problem+="its status was ${status}, not 0; "
    [[ "${output}" == abcd1234 ]] || problem+="standard output held '${output}', not abcd1234 alone; "

    remaining="$(tmux -S "${tmux_socket}" list-sessions -F '#{session_name}' 2>/dev/null | tr '\n' ' ' || true)"
    [[ -z "${remaining}" ]] || problem+="tmux sessions remain: ${remaining}; "

    typed="$(cat -- "${STAND_IN_DIR}/typed" 2>/dev/null || true)"

    if [[ ${expected} == none && -n ${typed} ]]; then
        problem+="'${typed}' was typed into the viewer, where none was due; "
    elif [[ ${expected} == rename && ${typed} != "/rename ${launch_name}" ]]; then
        problem+="'${typed}' was typed into the viewer, not /rename with the launch's name; "
    fi

    report "${name}" "${problem}" "${written}"
}

######
# Main
######

case_count=0
failures=0
launch_name=""
repository_root="$(cd "$(dirname "$0")/.." && pwd)"
run_directory=""

Set-Traps cleanup
run_directory="$(mktemp -d)"
stage "${run_directory}"

repository="${run_directory}/repository"
clone="${run_directory}/clone"
projects="${run_directory}/config/projects/test-project"
store="${run_directory}/state/agent-schedule/example/start-claude-test"
tmux_socket="${run_directory}/tmux/tmux-$(id -u)/default"
export PATH="${run_directory}/bin:${PATH}" XDG_STATE_HOME="${run_directory}/state" TMUX_TMPDIR="${run_directory}/tmux"
export CLAUDE_CONFIG_DIR="${run_directory}/config"
export STAND_IN_ID=abcd1234 STAND_IN_SESSION=abcd1234-0000-4000-8000-000000000009 STAND_IN_NAME="probe session"
export STAND_IN_CWD="${repository}" STAND_IN_DIR="${run_directory}"

# Every form --resume takes, and each refusal, one line each: the case, the argument, what it must give (the id, or
# not-found or data-error), and the error id Start-Claude.ps1 must give. Test-StartClaude.ps1 holds the same table,
# line for line. {projects} is the stand-in configuration's project folder.
case_table='short id | abcd1234 | abcd1234 |
full id claude lists, with no transcript | abcd1234-0000-4000-8000-000000000009 | abcd1234 |
full id in capitals | ABCD1234-0000-4000-8000-000000000009 | abcd1234 |
full id of a transcript claude does not list | eeee5555-0000-4000-8000-000000000002 | eeee5555 |
full id nothing holds | 00000000-0000-4000-8000-00000000000f | not-found | ConversationNotFound
short id claude does not list | 12345678 | not-found | BackgroundSessionNotFound
transcript path | {projects}/eeee5555-0000-4000-8000-000000000002.jsonl | eeee5555 |
transcript path with no file | {projects}/00000000-0000-4000-8000-0000000000aa.jsonl | not-found | TranscriptNotFound
transcript path not named for an id | {projects}/notes.jsonl | data-error | TranscriptNotNamedForId
name claude lists for its background session | probe session | abcd1234 |
the last name a transcript records | new name | 99998888 |
an earlier name a transcript records | old name | not-found | ConversationNotFound
name two transcripts record | twin name | data-error | ConversationNameAmbiguous
name nothing records | no such name | not-found | ConversationNotFound'

while IFS='|' read -r name argument expected _; do
    argument="$(trim "${argument}")"
    run_case "--resume, $(trim "${name}")" "$(trim "${expected}")" --detach --resume \
        "${argument//\{projects\}/${projects}}"
done <<<"${case_table}"

# The refusals of usage, and a refusal's status, run as a process, as every case here runs.
run_case "no way in" usage --detach
run_case "--detach with --no-remote-control" usage --detach --no-remote-control --resume abcd1234
run_case "a refusal, run as a process" not-found --detach --resume "no such name"

# Every way in, with a schedule and without (#322), on schedule 7, which the stand-in for gh answers for; --resume alone
# is the table's cases above. Each case begins from a store holding what it names, and checks the entry it leaves.
clear_store
run_store_case "--schedule alone, with no entry: a new conversation, its entry written" "${repository}" fedc4321 \
    fedc4321 --detach --schedule 7
clear_store
seed_entry abcd1234
run_store_case "--schedule alone, with an entry: the conversation it holds" "${repository}" abcd1234 abcd1234 \
    --detach --schedule 7
clear_store
run_store_case "--resume with --schedule: the conversation joins the schedule" "${repository}" abcd1234 abcd1234 \
    --detach --resume abcd1234 --schedule 7
clear_store
run_store_case "--continue alone: the conversation claude lists here, on no schedule" "${repository}" "" abcd1234 \
    --detach --continue
run_store_case "--continue with --schedule: the conversation claude lists here joins the schedule" "${repository}" \
    abcd1234 abcd1234 --detach --continue --schedule 7
clear_store
STAND_IN_CWD="${run_directory}/elsewhere"
run_store_case "--continue with --schedule, claude listing none here: refused, nothing started" "${repository}" "" \
    not-found --detach --continue --schedule 7
STAND_IN_CWD="${repository}"

# Row 2 of personal#259's plan: the conversation --schedule with --directory resumes in another clone, which claude
# then lists there, is the one --continue finds there, and not the newest transcript in that clone's project folder,
# the one claude's own --continue would take.
clear_store
seed_entry eeee5555-0000-4000-8000-000000000002
run_store_case "row 2: --schedule with --directory resumes the schedule's conversation in another clone" "${clone}" \
    eeee5555 eeee5555 --detach --schedule 7
STAND_IN_ID=eeee5555 STAND_IN_SESSION=eeee5555-0000-4000-8000-000000000002 STAND_IN_CWD="${clone}"
run_store_case "row 2: --continue in that clone finds that conversation" "${clone}" eeee5555 eeee5555 --detach \
    --continue
STAND_IN_ID=abcd1234 STAND_IN_SESSION=abcd1234-0000-4000-8000-000000000009 STAND_IN_CWD="${repository}"
clear_store

# A --detach wake of a stopped session passes no flag, which would start a copy, and gives the launch's name as its
# first prompt only when claude lists the session under another (#384; #260, requirement 3).
run_wake_case "a --detach wake of a stopped session listed under another name renames it with its first prompt" \
    "probe session" rename
run_wake_case "a --detach wake of a stopped session listed under the launch's name passes no prompt" \
    "${launch_name}" none

# A running session claude lists under another name is renamed in a viewer; one under the launch's name is left be.
run_rename_case "a --detach launch onto a running session listed under another name types /rename into a viewer" \
    "probe session" rename
run_rename_case "a --detach launch onto a running session listed under the launch's name types nothing" \
    "${launch_name}" none
clear_store

# Attached: the id when the client leaves, and a schedule's session listed under another name renamed in the viewer.
run_attached_case "attached, the id on standard output when the viewer leaves" none --resume abcd1234
seed_entry abcd1234
run_attached_case "attached, a schedule's session listed under another name is renamed in its viewer" rename \
    --schedule 7
clear_store

((failures == 0)) || error $EX_SOFTWARE "${failures} of the ${case_count} cases failed"
success "every case passed"
