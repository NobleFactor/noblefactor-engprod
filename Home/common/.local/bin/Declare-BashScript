#!/usr/bin/env bash
# shellcheck disable=SC2034 # Variables are used by scripts that source this file

# SPDX-License-Identifier: Apache-2.0
# Copyright (c) 2025-2026 Noble Factor. All rights reserved.

# Declare-BashScript - Bash script argument and option parsing helper
#
# Scripts that source this file add, on the line above their source line:
#
#     # shellcheck source=Declare-BashScript
#
# The directive names the file, never a path. The lint gate supplies the directory with
# `shellcheck -P` -- this repository's Home/common/.local/bin, or a consumer's deployed ~/.local/bin.
#
# Reference:
#
# 1. BSD sysexits.h exit codes
#    https://man.freebsd.org/cgi/man.cgi?query=sysexits

# Every consumer runs on bash 5.3 or later, what current Linux ships (#268). The check comes before any statement an
# older bash would reject, so it cannot use error: nothing below it has been read yet.
((BASH_VERSINFO[0] > 5 || (BASH_VERSINFO[0] == 5 && BASH_VERSINFO[1] >= 3))) || {
    printf '[%s] [\033[31m✘\033[0m] requires bash 5.3 or later; this is bash %s\n' "${1##*/}" "$BASH_VERSION" >&2
    exit 78 # EX_CONFIG
}

# GNU getopt parses every consumer's options (#290). macOS's own getopt misparses them and exits 0, so a script would
# run with its options dropped. Only GNU's getopt --test exits 4: in or out, as for bash, with no search for a copy.
getopt_test=0
getopt --test >/dev/null 2>&1 || getopt_test=$?
((getopt_test == 4)) || {
    printf '[%s] [\033[31m✘\033[0m] requires GNU getopt, and the getopt first on PATH is not it: %s\n' "${1##*/}" \
        "install MacPorts' util-linux, or Homebrew's gnu-getopt with its bin directory first on PATH" >&2
    exit 78 # EX_CONFIG
}
unset getopt_test

set -o errexit -o errtrace -o nounset -o pipefail
shopt -s inherit_errexit

###########
# Variables
###########

script_root="$(cd "$(dirname "$1")" && pwd)" && readonly script_root
script_name="$(basename "$1")" && readonly script_name
script_long_options="${2:-}" && readonly script_long_options
script_short_options="${3:-}" && readonly script_short_options

shift 3 || shift 2 || shift 1 # Shift past the first three arguments to leave only the options for parsing

# BSD sysexits.h exit codes (see /usr/include/sysexits.h)

readonly EX_USAGE=64       # command line usage error
readonly EX_DATAERR=65     # data format error
readonly EX_NOINPUT=66     # cannot open input
readonly EX_UNAVAILABLE=69 # service unavailable (missing dependency)
readonly EX_SOFTWARE=70    # internal software error
readonly EX_OSERR=71       # system error (e.g., can't fork)
readonly EX_OSFILE=72      # critical OS file missing
readonly EX_CANTCREAT=73   # can't create (user) output file
readonly EX_IOERR=74       # input/output error
readonly EX_TEMPFAIL=75    # temp failure; user is invited to retry
readonly EX_PROTOCOL=76    # remote error in protocol
readonly EX_NOPERM=77      # permission denied
readonly EX_CONFIG=78      # configuration error (unsupported platform)

# The marks error, success and usage print.

readonly HEAVY_BALLOT='✘' HEAVY_CHECK_MARK='✔'

###########
# Functions
###########

# Set-Traps sends ERR, HUP, INT and TERM to on_error_or_interrupt, and EXIT to the cleanup function a script names.
#
# A script calls it once, after its cleanup function is defined and before its arguments are parsed: an early exit
# with EXIT naming a function not yet defined fails with "command not found". A script with nothing to undo calls it
# with no argument (#268).
#
# Parameters:
#   - `$1`: the name of the cleanup function EXIT runs; optional.
#
# Returns:
#   - 0.
# shellcheck disable=SC2120 # The cleanup is optional: a script with nothing to undo calls Set-Traps bare (#289).
function Set-Traps {
    trap 'on_error_or_interrupt ERR' ERR
    trap 'on_error_or_interrupt HUP' HUP
    trap 'on_error_or_interrupt INT' INT
    trap 'on_error_or_interrupt TERM' TERM
    # shellcheck disable=SC2064 # The cleanup's name is expanded now, by design: it is what EXIT runs.
    if [[ -n ${1:-} ]]; then trap "$1" EXIT; fi
}

# error prints a message to stderr in the helper's error form, and ends the script with the given status unless it is 0.
#
# The form is `[<script name>] [✘] <message>`, the ✘ in red. A status of 0 makes the message a warning: it is printed,
# and the script carries on.
#
# Parameters:
#   - `$1`: the exit status; 0 prints the message and returns.
#   - `${@:2}`: the message, its words joined by spaces.
#
# Returns:
#   - 0 when `$1` is 0; otherwise it does not return: the script exits with `$1`.
function error {
    local status=$1
    shift 1
    printf '[%s] [\033[31m%s\033[0m] %s\n' "$script_name" "$HEAVY_BALLOT" "$*" >&2
    if ((status != 0)); then
        exit "$status"
    fi
}

# note prints an informational message to stderr in the helper's form, unless SILENT is set.
#
# The form is `[<script name>] [+] <message>`.
#
# Parameters:
#   - `$@`: the message, its words joined by spaces.
#
# Returns:
#   - 0.
function note {
    if [[ -n ${SILENT:-} ]]; then
        return
    fi
    printf "[%s] [+] %s\n" "$script_name" "$*" >&2
}

# on_error_or_interrupt reports a failure or a signal that ends the script, once, in error's own form (#268).
#
# A failure the script tolerates, under set +o errexit, ends nothing and goes unreported. Inside a subshell, the shell
# that started it reports the failure when the command holding the subshell fails. A signal ends the script with 128
# plus its number, so the EXIT trap's cleanup runs. Set-Traps installs it; a script does not call it itself.
#
# Parameters:
#   - `$1`: the trapped event: ERR, HUP, INT or TERM.
#
# Returns:
#   - 0 for a failure under set +o errexit; otherwise it does not return: a subshell exits with the failure's status,
#     unreported, and the script exits with the failing command's status, or 128 plus the signal's number.
function on_error_or_interrupt {
    local status=$? event=$1

    case $event in
        ERR)
            [[ $- == *e* ]] || return 0
            ((BASH_SUBSHELL == 0)) || exit "$status"
            error "$status" "exited with status ${status} at line ${BASH_LINENO[0]}: ${BASH_COMMAND}"
            ;;
        HUP | INT | TERM)
            error $((128 + $(kill -l "$event"))) "interrupted by SIG${event}"
            ;;
    esac
}

# require_command ends the script when a tool it needs is not found, naming every one that is missing (#290).
#
# hash looks each name up on PATH, and accepts a function of that name too.
#
# Parameters:
#   - `$@`: the names of the tools the script needs.
#
# Returns:
#   - 0 when every one is found; otherwise it does not return: the script exits 69, EX_UNAVAILABLE.
function require_command {
    local name missing_list=()

    for name in "$@"; do
        hash "$name" 2>/dev/null || missing_list+=("$name")
    done

    ((${#missing_list[@]} == 0)) || error $EX_UNAVAILABLE "requires ${missing_list[*]}: not found on PATH"
}

# require_darwin ends the script unless it runs on macOS.
#
# Parameters:
#   - none.
#
# Returns:
#   - 0 on macOS; otherwise it does not return: the script exits 78, EX_CONFIG.
function require_darwin {
    if [[ "$(uname -s)" != "Darwin" ]]; then
        error $EX_CONFIG "This script requires macOS (Darwin)."
    fi
}

# require_linux ends the script unless it runs on Linux.
#
# Parameters:
#   - none.
#
# Returns:
#   - 0 on Linux; otherwise it does not return: the script exits 78, EX_CONFIG.
function require_linux {
    if [[ "$(uname -s)" != "Linux" ]]; then
        error $EX_CONFIG "This script requires Linux."
    fi
}

# require_nix ends the script unless it runs on Linux or macOS.
#
# Parameters:
#   - none.
#
# Returns:
#   - 0 on Linux or macOS; otherwise it does not return: the script exits 78, EX_CONFIG.
function require_nix {
    case "$(uname -s)" in
        Darwin | Linux) ;;
        *)
            error $EX_CONFIG "This script requires Linux or macOS (Darwin)."
            ;;
    esac
}

# require_root ends the script unless it runs as root.
#
# Parameters:
#   - none.
#
# Returns:
#   - 0 as root; otherwise it does not return: the script exits 77, EX_NOPERM.
function require_root {
    if [[ $EUID -ne 0 ]]; then
        error $EX_NOPERM "must run as root"
    fi
}

# success prints a success message to stderr in the helper's form.
#
# The form is `[<script name>] [✔] <message>`, the ✔ in green.
#
# Parameters:
#   - `$@`: the message, its words joined by spaces.
#
# Returns:
#   - 0.
function success {
    printf '[%s] [\033[32m%s\033[0m] %s\n' "$script_name" "$HEAVY_CHECK_MARK" "$*" >&2
}

# usage shows the script's man page, or prints the synopsis it is given when there is none, and ends the script.
#
# It tries man's own search first, then the man directory beside the script's, share/man under the script's parent.
# A call with no synopsis is a defect in the script: it is reported and refused with status 2.
#
# Parameters:
#   - `$1`: the synopsis to print when no man page is found.
#
# Returns:
#   - it does not return: the script exits 0, or 2 when `$1` is missing or empty.
function usage {
    local synopsis_text="${1:-}"

    # Require a synopsis so callers can provide a fallback when man is unavailable

    if [[ -z "$synopsis_text" ]]; then
        printf '[%s] \033[31m%s\033[0m usage() requires a synopsis argument.\n' "$script_name" "$HEAVY_BALLOT" >&2
        exit 2
    fi

    # Prefer system man if available

    if man -w "${script_name}" >/dev/null 2>&1; then
        man "${script_name}"
        exit 0
    fi

    # Fallback to share/man relative to script root

    if man -M "${script_root}/../share/man" -w "${script_name}" >/dev/null 2>&1; then
        man -M "${script_root}/../share/man" "${script_name}"
        exit 0
    fi

    # Final fallback: print the synopsis provided by the caller

    printf "%s\n" "$synopsis_text"
    exit 0
}

# Set-Environment is the base layer's one, which a prompt loads too: share/functions beside the directory this file is
# in, its links followed, so a clone and a deployment both find it (#294).
set_environment_file="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)/../share/functions/Set-Environment"
[[ -r $set_environment_file ]] || error $EX_OSFILE "requires Set-Environment, which is not at ${set_environment_file}"
# shellcheck source=../share/functions/Set-Environment
source "$set_environment_file"
unset set_environment_file

###########
# Arguments
###########

if ! script_arguments=$(getopt -n "${script_name}" -o "${script_short_options}" --long "${script_long_options}" \
    -- "$@" 2>&1); then
    error "${EX_USAGE}" "${script_arguments}"
fi
readonly script_arguments
