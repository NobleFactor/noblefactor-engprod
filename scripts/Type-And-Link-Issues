#!/usr/bin/env bash

# SPDX-License-Identifier: Apache-2.0
# Copyright Noble Factor. All rights reserved.

#
# Type-And-Link-Issues: every open issue typed from its kind label and linked to its parent, labels and markers kept
#
# Section 5's step 3 of the issue data model, new data beside the old (noblefactor-engprod#380). For each open issue of
# a repository: sets GitHub's issue type from the one kind label, and the sub-issue parent from the last **Feature:**
# or **Chore:** marker, or for a feature or chore from the epic carrying its Epic:<Name> label. An issue that already
# has a type or a link is left as it is, and a link that disagrees with the marker is reported. Nothing is deleted.
#
# Usage:
#   scripts/Type-And-Link-Issues [--repo <owner/name>] [--dry-run]
#
# --dry-run prints every write and makes none. A repository tool under scripts/, exempt from Declare-BashScript.
#

set -euo pipefail

repo="NobleFactor/noblefactor-engprod"
dry_run=false
while [[ $# -gt 0 ]]; do
    case "$1" in
        --repo)
            repo="$2"
            shift 2
            ;;
        --dry-run)
            dry_run=true
            shift
            ;;
        -h | --help)
            sed -n '7,18p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *)
            echo "unknown argument: $1" >&2
            exit 64
            ;;
    esac
done

say() { printf '[Type-And-Link-Issues] %s\n' "$*"; }
for tool in gh jq; do command -v "$tool" >/dev/null || {
    say "$tool is not on PATH"
    exit 69
}; done

org="${repo%%/*}"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

# The organization's types: the label is the type's name lower-cased.
gh api "orgs/$org/issue-types" --jq '.[] | select(.is_enabled) | "\(.name | ascii_downcase)\t\(.name)"' >"$work/types.tsv"
kinds="$(cut -f1 "$work/types.tsv" | paste -sd'|' -)"
say "types in $org: $(cut -f2 "$work/types.tsv" | paste -sd, -)"

# Every issue of the repository, open and closed: closed ones can be parents.
gh issue list --repo "$repo" --state all --limit 1000 --json number,state,labels,body,issueType,parent,url >"$work/all.json"
say "$(jq 'map(select(.state == "OPEN")) | length' "$work/all.json") open issues in $repo"

typed=0 linked=0 skipped=0 disagree=0
while IFS=$'\x1f' read -r number label_count kind type parent_url epic_label body_b64; do
    # 1. The type.
    if [[ -z "$type" ]]; then
        if [[ "$label_count" != 1 ]]; then
            say "skip #$number: $label_count kind labels"
            skipped=$((skipped + 1))
        else
            type_name="$(awk -F'\t' -v k="$kind" '$1 == k {print $2}' "$work/types.tsv")"
            if $dry_run; then
                say "would: type #$number $type_name"
            else
                gh api -X PATCH "repos/$repo/issues/$number" -f "type=$type_name" --silent
                say "type #$number $type_name"
            fi
            typed=$((typed + 1))
        fi
    fi
    # 2. The parent.
    body="$(printf '%s' "$body_b64" | base64 -d)"
    marker="$(printf '%s' "$body" | grep -oE "(Feature|Chore):\*\* ([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)?#[0-9]+" | tail -1 || true)"
    wanted="" source="marker names"
    if [[ -n "$marker" && "$kind" != feature && "$kind" != chore && "$kind" != epic ]]; then
        ref="${marker#*\*\* }"
        if [[ "$ref" == */* ]]; then wanted="${ref/noblefactor-ops#/noblefactor-engprod#}"; else wanted="$repo$ref"; fi
    elif [[ "$kind" == feature || "$kind" == chore ]] && [[ -n "$epic_label" ]]; then
        epic_number="$(jq -r --arg l "$epic_label" '.[] | select(.labels | map(.name) | index("epic") and index($l)) | .number' "$work/all.json" | head -1)"
        [[ -z "$epic_number" ]] || wanted="$repo#$epic_number"
        source="its epic label is"
    fi
    if [[ -n "$parent_url" ]]; then
        have="$(printf '%s' "$parent_url" | sed -E 's#https://github.com/([^/]+/[^/]+)/issues/([0-9]+)#\1\#\2#; s/noblefactor-ops#/noblefactor-engprod#/')"
        if [[ -n "$wanted" && "$have" != "$wanted" ]]; then
            say "keep #$number: linked to $have, $source $wanted (#363 decides)"
            disagree=$((disagree + 1))
        fi
        continue
    fi
    if [[ -z "$wanted" ]]; then
        if [[ "$kind" == feature || "$kind" == chore ]]; then
            say "skip #$number: a $kind with no Epic:<Name> label has no epic to link to (#363 decides)"
            skipped=$((skipped + 1))
        fi
        continue
    fi
    parent_repo="${wanted%#*}"
    parent_number="${wanted##*#}"
    if $dry_run; then
        say "would: link #$number under $wanted"
    else
        child_id="$(gh api "repos/$repo/issues/$number" --jq .id)"
        gh api -X POST "repos/$parent_repo/issues/$parent_number/sub_issues" -F "sub_issue_id=$child_id" --silent
        say "link #$number under $wanted"
    fi
    linked=$((linked + 1))
done < <(jq -r '.[] | select(.state == "OPEN") |
    [.number,
     ([.labels[].name] | map(select(test("^('"$kinds"')$"))) | length),
     ([.labels[].name] | map(select(test("^('"$kinds"')$"))) | .[0] // ""),
     (.issueType.name // ""),
     (.parent.url // ""),
     ([.labels[].name] | map(select(startswith("Epic:"))) | .[0] // ""),
     ((.body // "") | @base64)] | map(tostring) | join("\u001f")' "$work/all.json")

say "done: $typed typed, $linked linked, $skipped skipped, $disagree links kept that disagree with their marker or epic label$($dry_run && printf ' (dry run, nothing written)')"
